# Runtime-only image assembled from prebuilt artifacts, used by
# `.github/workflows/build-multiarch-image.yml`.
#
# Unlike `docker/Dockerfile`, nothing is compiled here. The build context must
# look like this, where <arch> is the architecture being built (amd64 or arm64):
#
#   <arch>/risingwave     stripped `risingwave` binary
#   <arch>/jeprof         jemalloc heap profile tool
#   <arch>/adbc/          ADBC Snowflake driver
#   connector-node/       extracted connector node (architecture independent)
FROM ubuntu:24.04

ARG TARGETARCH

LABEL org.opencontainers.image.source https://github.com/risingwavelabs/risingwave

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get -y install --no-install-recommends \
    ca-certificates openjdk-21-jre-headless python3.12 libpython3.12 libsasl2-2 openssl \
    libblas3 liblapack3 libomp5 \
  && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 ${TARGETARCH}/risingwave /risingwave/bin/risingwave
COPY --chmod=755 ${TARGETARCH}/jeprof /usr/local/bin/jeprof
COPY ${TARGETARCH}/adbc /risingwave/lib/adbc
COPY connector-node /risingwave/bin/connector-node

# Set default playground mode to docker-playground profile
ENV PLAYGROUND_PROFILE docker-playground
# Set default connector libs path
ENV CONNECTOR_LIBS_PATH /risingwave/bin/connector-node/libs
ENV IN_CONTAINER=1

# Runtime dynamic library search path for ADBC (Linux containers use LD_LIBRARY_PATH).
ENV ADBC_DRIVER_PATH /risingwave/lib/adbc
ENV LD_LIBRARY_PATH /risingwave/lib/adbc

ENTRYPOINT [ "/risingwave/bin/risingwave" ]
CMD [ "single_node" ]
