statement ok
set streaming_merge_lookups_under_dedup = false;

# inner join with a status whose default branch reads the same table

statement ok
create materialized view mud_inner_status_off as select t.rev, t.name, s.status, s.p from mud_t t join mud_st s on t.id = s.id;

# left join with a status

statement ok
create materialized view mud_left_status_off as select t.rev, s.status, s.p from mud_t t left join mud_st s on t.id = s.id;

# rows whose status is the default one

statement ok
create materialized view mud_default_filter_off as select t.rev, t.name from mud_t t join mud_st s on t.id = s.id where s.status = 'initiated';

# rows whose status is not the default one

statement ok
create materialized view mud_other_filter_off as select t.rev from mud_t t join mud_st s on t.id = s.id where s.status <> 'initiated';

# status of the rows of a join that carries the table

statement ok
create materialized view mud_via_join_off as select x.k, t.rev, s.status from mud_x x join mud_t t on x.tid = t.id join mud_st s on x.tid = s.id;

# left join with a status whose priorities include a CASE of literals

statement ok
create materialized view mud_case_priority_off as select t.rev, s.status, s.p from mud_t t left join mud_sc s on t.id = s.id;

# a priority that may be NULL

statement ok
create materialized view mud_null_priority_off as select t.rev, s.status, s.p from mud_t t join mud_sn s on t.id = s.id;

# two other branches tie on the priority

statement ok
create materialized view mud_tie_off as select t.rev, s.status, s.p from mud_t t left join mud_stie s on t.id = s.id;

# an ascending order, kept

statement ok
create materialized view mud_asc_kept_off as select t.rev, s.status, s.p from mud_t t join mud_sasc s on t.id = s.id;

# unused left join below a top-1 whose other columns are constants

statement ok
create materialized view mud_topn_unused_off as select id, status from (select id, status, row_number() over (partition by id order by p desc) as rn from (select t.id, 'x' as status, 1 as p from mud_t t left join mud_q q on t.id = q.id) u) z where rn = 1;

# unused left join below a DISTINCT

statement ok
create materialized view mud_distinct_unused_off as select distinct t.id, t.name from mud_t t left join mud_q q on t.id = q.id;

# unused left join below min, max and bool_or

statement ok
create materialized view mud_minmax_unused_off as select t.id, min(t.name) as mn, max(t.rev) as mx, bool_or(t.flag) as f from mud_t t left join mud_q q on t.id = q.id group by t.id;

# unused left join in the right side of an EXISTS

statement ok
create materialized view mud_exists_unused_off as select x.k from mud_x x where exists (select 1 from mud_t t left join mud_q q on t.id = q.id where t.id = x.tid);

# unused left join in a branch of a union below a DISTINCT

statement ok
create materialized view mud_union_unused_off as select distinct id from (select t.id from mud_t t left join mud_q q on t.id = q.id union all select a.id from mud_a a) u;

