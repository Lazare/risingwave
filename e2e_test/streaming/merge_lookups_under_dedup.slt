# Differential test of the removals under consumers that do not see duplicates
# (`streaming_merge_lookups_under_dedup`): every query is materialized twice, with and without the
# variable, and both materialized views must hold the same rows, and the rows of the query, after
# the backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/merge_lookups_under_dedup.gen.py <this file>`: edit the
# list of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table mud_t (rev int primary key, id int, name varchar, flag boolean);

statement ok
create table mud_a (k int primary key, id int, ok boolean);

statement ok
create table mud_b (k int primary key, id int);

statement ok
create table mud_q (k int primary key, id int, v int);

statement ok
create table mud_x (k int primary key, tid int);

statement ok
create view mud_st as select id, status, p from (
    select id, status, p, row_number() over (partition by id order by p desc) as rn from (
        select id, 'initiated' as status, 1 as p from mud_t
        union all select id, 'active', 2 from mud_a where ok
        union all select id, 'blocked', 3 from mud_b
    ) u
) z where rn = 1;

statement ok
create view mud_sc as select id, status, p from (
    select id, status, p, row_number() over (partition by id order by p desc) as rn from (
        select id, 'open' as status, 1 as p from mud_t
        union all select id, case when ok then 'approved' else 'rejected' end, case when ok then 4 else 5 end from mud_a
        union all select id, 'pending', 2 from mud_b
    ) u
) z where rn = 1;

statement ok
create view mud_sn as select id, status, p from (
    select id, status, p, row_number() over (partition by id order by p desc) as rn from (
        select id, 'initiated' as status, 1 as p from mud_t
        union all select id, 'active', case when ok then 2 end from mud_a
    ) u
) z where rn = 1;

statement ok
create view mud_stie as select id, status, p from (
    select id, status, p, row_number() over (partition by id order by p desc) as rn from (
        select id, 'initiated' as status, 1 as p from mud_t
        union all select id, 'active', 2 from mud_a
        union all select id, 'blocked', 2 from mud_b
    ) u
) z where rn = 1;

statement ok
create view mud_sasc as select id, status, p from (
    select id, status, p, row_number() over (partition by id order by p asc) as rn from (
        select id, 'initiated' as status, 1 as p from mud_t
        union all select id, 'active', 2 from mud_a where ok
    ) u
) z where rn = 1;

