statement ok
update sse_u set k = null where id in (4, 8);

statement ok
update sse_u set k = 2 where id = 5;

statement ok
update sse_u set v = null where id in (6, 9);

statement ok
update sse_u set ts = 0 where id = 7;

statement ok
update sse_t set k = 4 where id = 3;

statement ok
update sse_t set y = null where id = 2;

statement ok
delete from sse_u where id in (2, 3);

statement ok
delete from sse_t where id = 6;

statement ok
delete from sse_n where k is null and y = 10;

