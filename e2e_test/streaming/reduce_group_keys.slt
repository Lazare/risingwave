SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table gks_o (id int primary key, placed date, cust int);

statement ok
create table gks_i (iid int primary key, o_id int, qty int);

statement ok
create table gks_t (k int primary key, a int, b int, c int);

# First data: NULLs, orders without items, items without orders: before the materialized views are created, through the backfill.

