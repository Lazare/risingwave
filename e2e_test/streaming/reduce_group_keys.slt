statement ok
create materialized view gks_join_key_off as select o.id, o.placed, count(i.qty) as n, max(i.qty) as mq from gks_o o join gks_i i on i.o_id = o.id group by o.id, o.placed;

statement ok
create materialized view gks_eq_key_off as select o.id, i.o_id, count(*) as n from gks_o o join gks_i i on i.o_id = o.id group by o.id, i.o_id;

statement ok
create materialized view gks_const_key_off as select a, b, count(*) as n from gks_t where b = 3 group by a, b;

statement ok
create materialized view gks_all_const_off as select a, b, count(*) as n from gks_t where a = 1 and b = 3 group by a, b;

statement ok
create materialized view gks_literal_key_off as select a, 'x' as tag, count(*) as n from gks_t group by a, tag;

statement ok
create materialized view gks_max_key_off as select a, max(a) as mx, min(a) as mn, count(*) as n from gks_t group by a;

statement ok
create materialized view gks_max_determined_off as select o.id, max(o.placed) as p, count(i.qty) as n from gks_o o join gks_i i on i.o_id = o.id group by o.id;

statement ok
create materialized view gks_last_value_left_off as select o.id, last_value(o.cust order by i.iid) as lc, count(i.iid) as n from gks_o o left join gks_i i on i.o_id = o.id group by o.id;

statement ok
create materialized view gks_first_value_key_off as select a, first_value(a order by b) as f, count(c) as n from gks_t group by a;

statement ok
create materialized view gks_simple_const_off as select max(b) as mb, count(*) as n from gks_t where b = 3;

statement ok
create materialized view gks_sub_agg_off as select a, mb, count(*) as n from (select a, max(b) as mb from gks_t group by a) x group by a, mb;

statement ok
create materialized view gks_kept_left_off as select i.iid, o.placed, count(*) as n from gks_i i left join gks_o o on i.o_id = o.id group by i.iid, o.placed;

statement ok
create materialized view gks_kept_filter_off as select a, max(a) filter (where b > 0) as mx from gks_t group by a;

statement ok
create materialized view gks_kept_keys_off as select a, b, count(*) as n from gks_t group by a, b;

