# Differential test of `streaming_simplify_subquery_unnesting`: every query is materialized twice,
# with and without the unnesting of its correlated subqueries without a domain, and both
# materialized views must hold the same rows, and the rows of the query, after the backfill and
# after each round of changes.
#
# Generated by `python3 e2e_test/streaming/simplify_subquery_unnesting.gen.py <this file>`: edit
# the list of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table ssu_p (id int primary key, v int, g int);

statement ok
create table ssu_r (id int primary key, pid int, s varchar, x int);

statement ok
create table ssu_q (id int primary key, pid int);

statement ok
create table ssu_u (k int, v int);

statement ok
create view ssu_pv as select p.id, p.v, exists (select 1 from ssu_r r where r.pid = p.id) as e from ssu_p p;

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into ssu_p values (1, 1, 2), (2, 2, 0), (3, null, 1), (4, 1, null), (5, 5, 0), (6, 3, 3);

statement ok
insert into ssu_r values (10, 1, 'x', 1), (11, 1, 'y', 2), (12, 1, 'x', null), (13, 2, null, 2), (14, 3, 'x', 5), (15, null, 'x', 1), (16, 9, 'z', 9), (17, 3, 'z', null);

statement ok
insert into ssu_q values (20, 1), (21, 4), (22, null), (23, 4);

statement ok
insert into ssu_u values (1, 1), (1, 1), (2, null), (null, 3), (7, 0), (null, null);

statement ok
set streaming_simplify_subquery_unnesting = false;

# EXISTS in the select list

statement ok
create materialized view ssu_exists_select_off as select p.id, exists (select 1 from ssu_r r where r.pid = p.id and r.s = 'x') as e from ssu_p p;

# NOT EXISTS in the select list

statement ok
create materialized view ssu_not_exists_select_off as select p.id, not exists (select 1 from ssu_r r where r.pid = p.id) as e from ssu_p p;

# EXISTS under OR in WHERE

statement ok
create materialized view ssu_exists_or_off as select p.id, p.v from ssu_p p where p.v > 2 or exists (select 1 from ssu_r r where r.pid = p.id);

# EXISTS in a CASE, correlated on a nullable column that is not a key

statement ok
create materialized view ssu_exists_case_off as select p.id, case when exists (select 1 from ssu_r r where r.pid = p.v) then 'y' else 'n' end as c from ssu_p p;

# two NOT EXISTS joined by AND

statement ok
create materialized view ssu_two_not_exists_off as select p.id, not exists (select 1 from ssu_r r where r.s = 'x' and r.pid = p.id) and not exists (select 1 from ssu_q q where q.pid = p.id) as flag from ssu_p p;

# filter on the EXISTS column of a view

statement ok
create materialized view ssu_view_filter_off as select id, v from ssu_pv where e;

# filter on the negated EXISTS column of a view

statement ok
create materialized view ssu_view_not_off as select id, v from ssu_pv where not e;

# outer side without a key, with duplicates and NULLs

statement ok
create materialized view ssu_nokey_off as select u.k, u.v, exists (select 1 from ssu_r r where r.pid = u.k) as e from ssu_u u;

# scalar min

statement ok
create materialized view ssu_min_off as select p.id, (select min(r.x) from ssu_r r where r.pid = p.id) as m from ssu_p p;

# scalar count

statement ok
create materialized view ssu_count_off as select p.id, (select count(*) from ssu_r r where r.pid = p.id) as c from ssu_p p;

# sum, count of a column and count of distinct values in two subqueries

statement ok
create materialized view ssu_sum_count_off as select p.id, (select sum(r.x) from ssu_r r where r.pid = p.id) as s, (select count(r.x) + count(distinct r.s) from ssu_r r where r.pid = p.id) as c from ssu_p p;

# avg and bool_or

statement ok
create materialized view ssu_avg_bool_off as select p.id, (select avg(r.x) from ssu_r r where r.pid = p.id) as a, (select bool_or(r.s = 'x') from ssu_r r where r.pid = p.id) as b from ssu_p p;

# ARRAY subquery, an empty array when nothing matches

statement ok
create materialized view ssu_array_off as select p.id, array(select r.x from ssu_r r where r.pid = p.id order by r.x) as xs from ssu_p p;

# string_agg with a default when nothing matches

statement ok
create materialized view ssu_string_agg_off as select p.id, coalesce((select string_agg(r.s, ',' order by r.s) from ssu_r r where r.pid = p.id), '-') as ss from ssu_p p;

# count compared in WHERE

statement ok
create materialized view ssu_where_count_off as select p.id from ssu_p p where p.g = (select count(*) from ssu_r r where r.pid = p.id);

# correlated on two columns

statement ok
create materialized view ssu_two_cols_off as select p.id, (select count(*) from ssu_r r where r.pid = p.id and r.x = p.v) as c from ssu_p p;

# aggregate with a filter clause

statement ok
create materialized view ssu_filter_clause_off as select p.id, (select count(*) filter (where r.x > 1) from ssu_r r where r.pid = p.id) as c from ssu_p p;

# expression of a count that is not NULL over an empty input

statement ok
create materialized view ssu_count_expr_off as select p.id, (select count(*) * 10 + 1 from ssu_r r where r.pid = p.id) as c from ssu_p p;

# correlated column in the aggregated expression

statement ok
create materialized view ssu_kept_corr_arg_off as select p.id, (select max(r.x + p.v) from ssu_r r where r.pid = p.id) as m from ssu_p p;

# IS NOT DISTINCT FROM written in the subquery

statement ok
create materialized view ssu_kept_not_distinct_off as select p.id, p.v, (select count(*) from ssu_r r where r.pid is not distinct from p.v) as c from ssu_p p;

