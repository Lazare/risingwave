# Differential test of `streaming_preserve_mv_key`: every query is materialized twice with the
# plan reductions, with and without the variable, and both materialized views must hold the rows of
# the batch query, with the same multiplicities, after the backfill and after each round of
# changes. Views joined on the key of those views are compared the same way.
#
# Generated by `python3 e2e_test/streaming/preserve_mv_key.gen.py <this file>`: edit the list of
# queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table pmk_e (id int primary key, ref_id int, payload varchar);

statement ok
create table pmk_d (id int primary key, v varchar);

statement ok
create table pmk_t (id int primary key, e_id int, w int);

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into pmk_e values (1, 1, 'a'), (2, 1, 'b'), (3, 2, 'c'), (4, null, 'd'), (5, 9, null), (6, 3, 'f'), (7, 3, 'g'), (8, 4, 'h');

statement ok
insert into pmk_d values (1, 'x'), (2, null), (3, 'z'), (4, 'x'), (6, 'w');

statement ok
insert into pmk_t values (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 5, 40), (5, null, 50), (6, 8, 60), (7, 99, 70);

statement ok
set streaming_simplify_on_unique_key = true;

statement ok
set streaming_merge_repeated_lookups = true;

statement ok
set streaming_preserve_mv_key = false;

statement ok
create materialized view pmk_top1_off as select id, payload, v from (select e.id, e.payload, d.v, row_number() over (partition by e.id order by d.v, d.id) as rn from pmk_e e left join pmk_d d on e.ref_id = d.id) s where rn = 1;

statement ok
create materialized view pmk_agg_off as select e.id, max(d.v) as v, count(*) as n from pmk_e e left join pmk_d d on e.ref_id = d.id group by e.id;

statement ok
create materialized view pmk_distinct_off as select id, v from (select distinct e.id, d.v from pmk_e e left join pmk_d d on e.ref_id = d.id) s where v is not null;

statement ok
create materialized view pmk_inner_top1_off as select id, v from (select e.id, d.v, row_number() over (partition by e.id order by d.v, d.id) as rn from pmk_e e join pmk_d d on e.ref_id = d.id) s where rn = 1;

statement ok
create materialized view pmk_selfjoin_off as select e1.id, e1.payload || '!' as payload, x.v from pmk_e e1 join (select e2.id, d.v from pmk_e e2 left join pmk_d d on e2.ref_id = d.id) x on e1.id = x.id;

statement ok
create materialized view pmk_selfjoin_hidden_off as select e1.payload || '!' as payload, x.v from pmk_e e1 join (select e2.id, d.v from pmk_e e2 left join pmk_d d on e2.ref_id = d.id) x on e1.id = x.id;

statement ok
create materialized view pmk_scan_top1_off as select id, ref_id from (select id, ref_id, row_number() over (partition by id order by ref_id) as rn from pmk_e) s where rn = 1;

statement ok
create materialized view pmk_below_join_off as select t.id, x.v from pmk_t t join (select id, v from (select e.id, d.v, row_number() over (partition by e.id order by d.v, d.id) as rn from pmk_e e left join pmk_d d on e.ref_id = d.id) s where rn = 1) x on t.e_id = x.id;

statement ok
create materialized view pmk_c_top1_off as select t.id, m.v from pmk_t t join pmk_top1_off m on t.e_id = m.id;

statement ok
create materialized view pmk_c_agg_off as select t.id, m.n from pmk_t t left join pmk_agg_off m on t.e_id = m.id;

statement ok
create materialized view pmk_c_selfjoin_off as select t.id, m.payload from pmk_t t join pmk_selfjoin_off m on t.e_id = m.id;

statement ok
