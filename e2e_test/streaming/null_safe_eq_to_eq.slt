# Second round of changes: values set to NULL and back, deletes (retractions).

statement ok
update sne_a set y = null where id in (1, 3);

statement ok
update sne_a set y = 4, k = 4 where id in (2, 4);

statement ok
update sne_a set x = 9 where id = 6;

statement ok
update sne_b set k = null where id in (3, 7);

statement ok
update sne_b set k = 4, y = 4 where id in (2, 8);

statement ok
delete from sne_b where id in (5, 6);

statement ok
delete from sne_a where id = 5;

statement ok
delete from sne_n where k is null and v = 2;

