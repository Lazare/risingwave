# Third round of changes: only NULLs in the compared columns of the right side, then the
# right side emptied and filled again, then the left side emptied.

statement ok
update sne_b set k = null, y = null;

# After the right side holds only NULLs: with and without the rule, every materialized view holds the rows of the batch query.

