# Second round of changes: updates that move rows between branches, to and from NULL.

statement ok
update mus_t set flag = not flag where k in (1, 2, 4);

statement ok
update mus_t set flag = null where k = 7;

statement ok
update mus_t set a = -a, b = b + 3 where k in (5, 9, 10);

statement ok
update mus_t set a = null where k = 7;

statement ok
update mus_t set a = 4, b = 1 where k = 8;

statement ok
update mus_t set x = 'A', y = 'A' where k = 2;

statement ok
update mus_t set x = null where k = 6;

statement ok
update mus_u set c = -c where k in (1, 11);

statement ok
update mus_u set a = 9 where k = 3;

statement ok
update mus_h set a = 1 where r = 2;

statement ok
update mus_h set a = 12 where r = 3;

statement ok
update mus_n set a = 5 where k = 2;

statement ok
update mus_m set g = 2 where r = 1;

statement ok
update mus_m set v = -v where r in (4, 7);

statement ok
update mus_j set kind = 'e' where r = 3;

statement ok
update mus_j set f = '{"a": {"n": 9}, "b": {"m": 8}}' where r = 2;

