# Differential test of `streaming_merge_union_scans`: every query is materialized twice, with and
# without the single read of the table that several branches of its union read, and both
# materialized views must hold the same multiset of rows, and the rows of the query, after the
# backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/merge_union_scans.gen.py <this file>`: edit the list
# of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table mus_t (k int primary key, a int, b int, x varchar, y varchar, flag boolean);

statement ok
create table mus_u (k int primary key, a int, c int);

statement ok
create table mus_h (r int primary key, k int, a int);

statement ok
create table mus_n (k int, a int);

statement ok
create table mus_m (r int primary key, g int, v int);

statement ok
create table mus_j (r int primary key, kind varchar, f jsonb);

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into mus_t values (1, 1, 2, 'A', 'A', true), (2, 3, null, 'B', 'x', false), (3, null, 4, 'in', null, null), (4, -1, -2, 'out', 'out', true), (5, 6, 1, null, 'y', false), (6, 0, 0, 'A', 'B', null), (7, 2, 2, 'B', 'B', true), (8, null, null, null, null, null), (9, 7, 9, 'in', 'A', false);

statement ok
insert into mus_u values (1, 1, 5), (2, -3, 0), (3, null, 2), (10, -1, null), (11, 4, -4);

statement ok
insert into mus_h values (1, 1, 5), (2, 1, 20), (3, 2, 3), (4, 2, null), (5, 3, -1), (6, null, 15), (7, 4, 11), (8, 4, 2);

statement ok
insert into mus_n values (1, 1), (1, 1), (2, null), (2, null), (0, 3), (-1, -1), (null, 2), (null, null);

statement ok
insert into mus_m values (1, 1, 5), (2, 1, -5), (3, 2, null), (4, 6, 7), (5, null, 1), (6, 7, -2), (7, 3, 3);

statement ok
insert into mus_j values (1, 'e', '{"a": {"x": 1, "y": 2}, "b": {"z": 3}}'), (2, 'p', '{"a": {"x": 1}}'), (3, 'q', '{"a": {"w": 0}}'), (4, 'p', null), (5, null, '{"b": {"x": 1, "x2": 2}}'), (6, 'p', '{"a": {}}');

statement ok
set streaming_merge_union_scans = false;

statement ok
set streaming_share_union_scans = false;

# two branches with a different filter and projection

statement ok
create materialized view mus_two_off as select a as c1, x as c2 from mus_t where a > 0 union all select b, y from mus_t where b > 0;

# exclusive filters on a boolean column, constants per branch

statement ok
create materialized view mus_bool_off as select k as c1, 'yes' as c2, 5 as c3 from mus_t where flag union all select k, 'no', 4 from mus_t where not flag;

# three branches without a filter

statement ok
create materialized view mus_plain_off as select k as c1, 'r1' as c2 from mus_t union all select k, 'r2' from mus_t union all select k, 'r3' from mus_t;

# overlapping filters: a row can pass both

statement ok
create materialized view mus_overlap_off as select k as c1, a as c2 from mus_t where a > 0 union all select k, b from mus_t where b > 0 or a > 5;

# filters that are NULL on NULL columns

statement ok
create materialized view mus_nulls_off as select k as c1, a as c2, 'gt' as c3 from mus_t where a > b union all select k, b, 'le' from mus_t where not (a > b) union all select k, null::int, 'eq' from mus_t where x = y;

# one branch without a filter and one with a filter

statement ok
create materialized view mus_one_open_off as select k as c1, 'all' as c2, 1 as c3 from mus_t union all select k, 'nulls', 2 from mus_t where a is null;

# a conjunct common to every branch

statement ok
create materialized view mus_common_off as select k as c1, a as c2 from mus_t where a > 0 and b > 1 union all select k, b from mus_t where b < 5 and a > 0;

# branches over the same shared sub-plan

statement ok
create materialized view mus_share_off as with c as (select k, a, b from mus_t where a is not null) select k as c1, a as c2 from c where b > 1 union all select k, b from c where b < 5 union all select a, b from c;

# the shared sub-plan also read by a join

statement ok
create materialized view mus_share_other_off as with c as (select k, a, b from mus_t where a is not null) select s.k as c1, s.v as c2, c.b as c3 from (select k, a as v from c where b > 1 union all select k, b from c where b < 5) s join c on s.k = c.k;

# the same branch twice

statement ok
create materialized view mus_same_twice_off as select k as c1, a as c2 from mus_t where a > 0 union all select k, a from mus_t where a > 0;

# two tables, two branches each

statement ok
create materialized view mus_two_tables_off as select k as c1, a as c2 from mus_t where a > 0 union all select k, c from mus_u where c > 0 union all select k, b from mus_t where b > 0 union all select k, a from mus_u where a < 0;

# three branches, two of them read the same table

statement ok
create materialized view mus_three_two_off as select k as c1, a as c2, 't' as c3 from mus_t where a > 0 union all select k, c, 'u' from mus_u union all select k, b, 't2' from mus_t where b > 0;

# computed columns that differ between branches

statement ok
create materialized view mus_computed_off as select k as c1, greatest(a, 0) as c2, 'x' as c3 from mus_t where x = 'A' union all select k, b + 1, 'y' from mus_t where x = 'B';

# union without all

statement ok
create materialized view mus_distinct_off as select a as c1, x as c2, 'x' as c3 from mus_t where x is not null union select a, y, 'y' from mus_t where y is not null;

# aggregation above the union

statement ok
create materialized view mus_agg_off as select acc as c1, coalesce(sum(v), 0) as c2, count(*) as c3 from (select a as acc, -b as v from mus_t where x <> 'in' union all select b, b from mus_t where x <> 'out') s group by acc;

# top-1 per key above the union

statement ok
create materialized view mus_top1_off as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'low' as st, 1 as p from mus_h where a > 0 union all select k, 'high' as st, 2 as p from mus_h where a > 10) as v) as r where rn = 1;

# a table without a primary key holding duplicate rows

statement ok
create materialized view mus_no_key_off as select k as c1, a as c2 from mus_n where a > 0 union all select a, k from mus_n where k > 0 or a is null;

# branches over a shared join

statement ok
create materialized view mus_share_join_off as with c as (select mus_t.k, mus_t.a, mus_u.c from mus_t join mus_u on mus_t.a = mus_u.a) select k as c1, a as c2 from c where c > 0 union all select k, c from c where a > 0;

# branches over a shared aggregation

statement ok
create materialized view mus_share_agg_off as with c as (select a, count(*) as n from mus_t group by a) select a as c1, n as c2 from c where n > 1 union all select n, a from c where a > 0;

# a branch with a join and a plain branch

statement ok
create materialized view mus_join_plain_off as select k as c1, a as c2 from mus_t where a > 0 union all select mus_t.k, mus_u.c from mus_t join mus_u on mus_t.k = mus_u.k;

# a branch with a left join and a plain branch

statement ok
create materialized view mus_left_join_plain_off as select t.k as c1, coalesce(m.v, 0) as c2 from mus_t t left join mus_m m on t.k = m.g where t.x = 'A' union all select t.k, 1 from mus_t t where t.x = 'B';

# two joins on different columns

statement ok
create materialized view mus_two_joins_off as select t.k as c1, m.v as c2 from mus_t t join mus_m m on t.a = m.g and m.v > 0 union all select t.k, m.v from mus_t t join mus_m m on t.b = m.g and m.v < 0;

# two table functions and a plain branch

statement ok
create materialized view mus_srf_off as select j.r as c1, x.key as c2 from mus_j j cross join jsonb_each_text(j.f -> 'a') as x where kind in ('e', 'p') union all select j.r, x.key from mus_j j cross join jsonb_each_text(j.f -> 'b') as x where kind in ('e', 'p') union all select r, kind from mus_j where kind = 'p' and f ? 'a';

# an anti join in one branch

statement ok
create materialized view mus_anti_off as select k as c1, 'u' as c2 from mus_u union all select t.k, 't' from mus_t t where not exists (select 1 from mus_u u where u.k = t.k);

