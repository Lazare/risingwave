create materialized view sdor_inner_off as select a.id, b.id as bid from sdor_a a join sdor_b b on a.k = b.k where (a.x = 1 and b.y = 2) or (a.x = 3 and b.y = 4);

statement ok
create materialized view sdor_inner_is_null_off as select a.id, b.id as bid from sdor_a a join sdor_b b on a.k = b.k where (a.x = 1 and b.y is null) or (a.x is null and b.y = 4);

