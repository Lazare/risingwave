  (select count(*) from sdor_kept_full_on) - (select count(*) from (select a.id, b.id as bid from sdor_a a full join sdor_b b on a.k = b.k and ((a.x = 1 and b.y = 2) or (a.x = 3 and b.y = 4))) q);
