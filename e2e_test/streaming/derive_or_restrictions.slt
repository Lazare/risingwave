create materialized view sdor_inner_one_side_off as select a.id, b.id as bid from sdor_a a join sdor_b b on a.k = b.k where (a.x = 1 and b.y = 2) or b.y = 4;

statement ok
create materialized view sdor_inner_three_off as select a.id, b.id as bid from sdor_a a join sdor_b b on a.k = b.k where (a.x in (1, 2) and b.y > 3) or (a.x = 3 and b.z <= 0) or (a.s = 'p' and b.y is not distinct from b.z);

statement ok
create materialized view sdor_inner_mixed_off as select a.id, b.id as bid from sdor_a a join sdor_b b on a.k = b.k where (a.x = 1 and b.y = 2) or (a.x = 3 and b.y = b.z) or (a.x = 2 and a.s = b.s and b.y = 1);

