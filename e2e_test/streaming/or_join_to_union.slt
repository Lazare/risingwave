statement ok
insert into sojt_b values (1, 1, 2, 3), (2, 2, 2, 1), (3, null, 3, 10), (4, 3, null, 20), (5, null, null, 2), (6, 9, 8, 30), (7, 1, 1, 6), (8, 4, 6, 7), (9, 5, 3, null);

statement ok
insert into sojt_n values (1, 1), (1, 1), (2, 2), (null, 3), (3, 4), (9, 5), (2, null);

statement ok
set streaming_or_join_to_union = false;

statement ok
create materialized view sojt_kept_eq_off as select a.id, b.id as bid from sojt_a a join sojt_b b on a.k = b.y and (a.id = b.id1 or a.id = b.id2);

statement ok
set streaming_or_join_to_union = true;

statement ok
create materialized view sojt_inner_on as select a.id, b.id as bid from sojt_a a join sojt_b b on a.id = b.id1 or a.id = b.id2;

statement ok
create materialized view sojt_inner_extra_on as select a.id, b.id as bid from sojt_a a join sojt_b b on (a.id = b.id1 or a.id = b.id2) and a.x > b.y;

statement ok
create materialized view sojt_inner_multi_on as select a.id, b.id as bid from sojt_a a join sojt_b b on (a.id = b.id1 and a.x = b.y) or (a.k = b.id2 and a.x > 0);

statement ok
create materialized view sojt_inner_three_on as select a.id, b.id as bid from sojt_a a join sojt_b b on a.id = b.id1 or a.id = b.id2 or a.k = b.y;

statement ok
create materialized view sojt_inner_where_on as select a.id, b.id as bid from sojt_a a, sojt_b b where a.id = b.id1 or a.k = b.id2;

statement ok
create materialized view sojt_agg_on as select count(*) as n, coalesce(sum(b.y), 0) as s from sojt_a a join sojt_b b on a.id = b.id1 or a.id = b.id2;

statement ok
create materialized view sojt_left_on as select a.id, a.x, b.id as bid, b.y from sojt_a a left join sojt_b b on a.id = b.id1 or a.id = b.id2;

statement ok
create materialized view sojt_left_extra_on as select a.id, b.id as bid from sojt_a a left join sojt_b b on (a.id = b.id1 or a.id = b.id2) and b.y > 0;

statement ok
create materialized view sojt_left_three_on as select a.id, b.id as bid from sojt_a a left join sojt_b b on a.id = b.id1 or a.id = b.id2 or a.k = b.y;

statement ok
create materialized view sojt_semi_on as select a.id from sojt_a a where exists (select 1 from sojt_b b where a.id = b.id1 or a.id = b.id2);

statement ok
create materialized view sojt_semi_three_on as select a.id, a.x from sojt_a a where exists (select 1 from sojt_b b where a.id = b.id1 or a.id = b.id2 or a.k = b.y);

statement ok
create materialized view sojt_semi_extra_on as select a.id from sojt_a a where exists (select 1 from sojt_b b where (a.id = b.id1 or a.k = b.id2) and b.y > a.x);

statement ok
create materialized view sojt_anti_on as select a.id from sojt_a a where not exists (select 1 from sojt_b b where a.id = b.id1 or a.id = b.id2);

statement ok
create materialized view sojt_anti_three_on as select a.id from sojt_a a where not exists (select 1 from sojt_b b where a.id = b.id1 or a.id = b.id2 or a.k = b.y);

statement ok
create materialized view sojt_dup_inner_on as select n.v, b.id as bid from sojt_n n join sojt_b b on n.k = b.id1 or n.k = b.id2;

statement ok
create materialized view sojt_dup_left_on as select n.v, b.id as bid from sojt_n n left join sojt_b b on n.k = b.id1 or n.k = b.id2;

statement ok
create materialized view sojt_dup_semi_on as select n.k, n.v from sojt_n n where exists (select 1 from sojt_b b where n.k = b.id1 or n.k = b.id2);

statement ok
create materialized view sojt_dup_anti_on as select n.k, n.v from sojt_n n where not exists (select 1 from sojt_b b where n.k = b.id1 or n.k = b.id2);

statement ok
create materialized view sojt_kept_eq_on as select a.id, b.id as bid from sojt_a a join sojt_b b on a.k = b.y and (a.id = b.id1 or a.id = b.id2);

