# Differential test of `streaming_or_join_to_union`: every query is materialized with the
# variable (without it, streaming can not plan it) and must hold the rows of the batch query, with
# the same multiplicities, after the backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/or_join_to_union.gen.py <this file>`: edit the list of
# queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table sojt_a (id int primary key, k int, x int);

statement ok
create table sojt_b (id int primary key, id1 int, id2 int, y int);

statement ok
create table sojt_n (k int, v int);

# Without the variable, a join on an `OR` of equalities can not be planned.

statement error nested-loop join
create materialized view sojt_refused as select a.id, b.id as bid from sojt_a a join sojt_b b on a.id = b.id1 or a.id = b.id2;

# Rows present before the materialized views are created: they go through the backfill.

