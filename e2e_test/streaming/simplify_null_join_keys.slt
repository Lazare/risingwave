# Second round of changes: keys set to NULL and back, deletes (retractions).

statement ok
update snk_a set bk = 0 where id in (3, 4);

statement ok
update snk_a set bk = null where id in (5, 6);

statement ok
update snk_b set k = 2 where id = 3;

statement ok
update snk_b set k = null where id in (5, 8);

statement ok
update snk_b set label = 'changed' where k is null;

statement ok
delete from snk_b where id in (2, 4);

statement ok
delete from snk_a where id = 2;

statement ok
update snk_e set u = 1 where p = 1;

statement ok
delete from snk_n where k is null and v = 2;

