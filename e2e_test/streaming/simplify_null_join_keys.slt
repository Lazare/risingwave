create table snk_a (id int primary key, bk int, x int);

statement ok
create table snk_b (id int primary key, k int, label varchar);

statement ok
create table snk_c (id int primary key, kb bigint, v int);

statement ok
create table snk_e (p int primary key, u int, w int);

statement ok
create table snk_n (k int, v int);

statement ok
create view snk_v as select a.id, a.x, b.k as b_k, b.label from snk_a a join snk_b b on a.bk = b.k;

