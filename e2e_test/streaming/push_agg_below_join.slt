# First round of changes: new rows, NULL keys and duplicates, a dimension row replaced.

statement ok
insert into spaj_f select g, case when g % 5 = 0 then null else g % 15 end, g % 5, g % 4, g from generate_series(301, 400) g;

statement ok
insert into spaj_d values (10, 'ten', 1), (11, null, 2), (12, 'n1', 0);

statement ok
insert into spaj_d values (1, 'one', 2);

