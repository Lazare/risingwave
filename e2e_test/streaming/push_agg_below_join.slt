# Second round of changes: keys moved, values set to NULL, deletes (retractions).

statement ok
update spaj_f set k = null where id % 23 = 0;

statement ok
update spaj_f set k = 3 where id % 29 = 0;

statement ok
update spaj_f set x = null where id % 10 = 1;

statement ok
delete from spaj_f where k = 4;

statement ok
update spaj_d set name = 'n2', region = 1 where id = 5;

statement ok
delete from spaj_d where id = 6;

statement ok
insert into spaj_d values (20, 'n0', 0);

statement ok
delete from spaj_d where id in (2, 8);

statement ok
delete from spaj_d2 where id = 1;

statement ok
delete from spaj_e where k = 5;

