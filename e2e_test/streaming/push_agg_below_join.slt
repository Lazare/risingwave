# Differential test of `streaming_push_agg_below_join`: every query is materialized twice, with
# and without the variable, and both materialized views must hold the rows of the batch query, with
# the same multiplicities, after the backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/push_agg_below_join.gen.py <this file>`: edit the list
# of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table spaj_f (id int primary key, k int, k2 int, x int, y bigint);

statement ok
create table spaj_d (id int primary key, name varchar, region int);

statement ok
create table spaj_d2 (id int, ver int, w int, primary key (id, ver));

statement ok
create table spaj_e (k int, w int);

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into spaj_f select g, case when g % 37 = 0 then null else g % 12 end, g % 5, g % 7 - 2, case when g % 9 = 0 then null else g end from generate_series(1, 300) g;

statement ok
insert into spaj_d select g, case when g % 4 = 0 then null else 'n' || (g % 3) end, g % 3 from generate_series(0, 9) g;

statement ok
insert into spaj_d2 select g / 2, g % 2 + 1, case when g % 4 = 0 then null else g end from generate_series(0, 7) g;

statement ok
insert into spaj_e select g % 14, g % 3 from generate_series(1, 30) g;

statement ok
set streaming_push_agg_below_join = false;

statement ok
create materialized view spaj_left_unique_off as select f.k, d.name, coalesce(sum(f.x), 0) as s, count(*) as n from spaj_f f left join spaj_d d on f.k = d.id group by f.k, d.name;

statement ok
create materialized view spaj_inner_filtered_off as select f.k, coalesce(sum(f.x * 2), 0) as s, count(f.y) as n from spaj_f f join spaj_d d on f.k = d.id where d.region = 1 group by f.k;

statement ok
create materialized view spaj_inner_partner_off as select d.id, d.name, max(f.x) as m from spaj_f f join spaj_d d on f.k = d.id group by d.id, d.name;

statement ok
create materialized view spaj_right_unique_off as select f.k, d.region, coalesce(sum(f.y), 0) as s from spaj_d d right join spaj_f f on f.k = d.id group by f.k, d.region;

statement ok
create materialized view spaj_two_unique_off as select f.k, f.k2, d.name, d2.w, count(*) as n from spaj_f f join spaj_d d on f.k = d.id left join spaj_d2 d2 on f.k2 = d2.id and d2.ver = 1 group by f.k, f.k2, d.name, d2.w;

statement ok
create materialized view spaj_distinct_aggs_off as select f.k, count(distinct f.x) as c, count(*) filter (where f.x > 0) as p from spaj_f f left join spaj_d d on f.k = d.id group by f.k;

statement ok
create materialized view spaj_value_of_unique_off as select f.k, min(d.name) as mn, max(d.region) as mx, count(*) as n from spaj_f f left join spaj_d d on f.k = d.id group by f.k;

statement ok
create materialized view spaj_distinct_rows_off as select distinct f.k, d.name from spaj_f f left join spaj_d d on f.k = d.id;

statement ok
create materialized view spaj_computed_group_having_off as select f.k, f.x % 3 as b, d.name, count(*) as n from spaj_f f left join spaj_d d on f.k = d.id group by f.k, f.x % 3, d.name having count(*) > 1;

statement ok
create materialized view spaj_non_equi_grouped_off as select f.k, f.x, d.name, count(*) as n from spaj_f f left join spaj_d d on f.k = d.id and f.x > d.region group by f.k, f.x, d.name;

statement ok
create materialized view spaj_null_safe_off as select f.k, d.name, count(*) as n from spaj_f f left join spaj_d d on f.k is not distinct from d.id group by f.k, d.name;

statement ok
create materialized view spaj_kept_not_unique_off as select f.k, coalesce(sum(f.x), 0) as s from spaj_f f join spaj_e e on f.k = e.k group by f.k;

statement ok
