# Differential test of `streaming_status_ladder_case`: every query is materialized without the
# variable, with it, with `streaming_merge_union_scans` only, with both, and with the variable,
# `streaming_share_identical_subplans` and `streaming_factor_union_join`, and the materialized
# views must hold the same multiset of rows, and the rows of the query, after the backfill and after
# each round of changes.
#
# Generated by `python3 e2e_test/streaming/status_ladder_case.gen.py <this file>`: edit the list
# of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table sl_e (id int primary key, a int, b int, s varchar);

statement ok
create table sl_f (r int primary key, k int, st varchar, amt int, ts timestamptz);

statement ok
create table sl_g (r int primary key, k int);

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into sl_e values (1, 1, 0, 'closed'), (2, 0, 5, null), (3, null, null, 'open'), (4, 7, 1, 'x'), (5, -1, -1, 'closed'), (6, null, 2, null);

statement ok
insert into sl_f values (1, 1, 'back', 5, '2001-01-01 00:00:00+00:00'), (2, 1, null, -1, '2101-01-01 00:00:00+00:00'), (3, 2, 'x', 20, null), (4, 2, 'back', null, '2001-01-01 00:00:00+00:00'), (5, 3, null, null, null), (6, null, 'back', 3, '2001-01-01 00:00:00+00:00'), (7, null, 'x', 0, '2101-01-01 00:00:00+00:00'), (8, 4, 'x', 11, '2101-01-01 00:00:00+00:00'), (9, 4, 'x', 11, '2101-01-01 00:00:00+00:00'), (10, 5, 'back', -5, null), (11, 6, null, 1, '2001-01-01 00:00:00+00:00');

statement ok
insert into sl_g values (1, 1), (2, 3), (3, null), (4, 7), (5, 3);

statement ok
set streaming_status_ladder_case = false;

statement ok
set streaming_merge_union_scans = false;

statement ok
set streaming_share_identical_subplans = false;

statement ok
set streaming_factor_union_join = false;

# three branches over the same table become one CASE, one branch over another table

statement ok
create materialized view sl_form1_ref as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'open' as st, 1 as p from sl_f union all select k, 'active', 2 from sl_f where amt > 0 union all select k, 'closed', 3 from sl_f where st = 'back' union all select k, 'held', 4 from sl_g) u) x where rn = 1;

# every branch over a table that is not unique on the key: the top-1 stays

statement ok
create materialized view sl_same_table_ref as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'open' as st, 1 as p from sl_f union all select k, 'active', 2 from sl_f where amt > 0 union all select k, 'closed', 3 from sl_f where st = 'back') u) x where rn = 1;

# every branch over a table unique on the key, with a default branch

statement ok
create materialized view sl_unique_default_ref as select id as c1, st as c2 from (select id, st, row_number() over (partition by id order by p desc) as rn from (select id, 'new' as st, 1 as p from sl_e union all select id, 'active', 2 from sl_e where a > 0 union all select id, 'closed', 3 from sl_e where s = 'closed') u) x where rn = 1;

# every branch over a table unique on the key, without a default branch

statement ok
create materialized view sl_unique_no_default_ref as select id as c1, st as c2 from (select id, st, row_number() over (partition by id order by p desc) as rn from (select id, 'active' as st, 2 as p from sl_e where a > 0 union all select id, 'closed', 3 from sl_e where b > 0) u) x where rn = 1;

# ascending priority

statement ok
create materialized view sl_ascending_ref as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p asc) as rn from (select k, 'first' as st, 1 as p from sl_f where amt > 10 union all select k, 'second', 2 from sl_f where amt > 0 union all select k, 'last', 9 from sl_f) u) x where rn = 1;

# the priority is output too

statement ok
create materialized view sl_with_priority_ref as select k as c1, st as c2, p as c3 from (select k, st, p, row_number() over (partition by k order by p desc) as rn from (select k, 'open' as st, 1 as p from sl_f union all select k, 'active', 2 from sl_f where amt > 0 union all select k, 'closed', 3 from sl_f where st = 'back') u) x where rn = 1;

# branches over a shared join, and one over another table

statement ok
create materialized view sl_shared_join_ref as with c as (select sl_f.k, sl_f.amt, sl_f.st from sl_f join sl_g on sl_f.k = sl_g.k) select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'open' as st, 1 as p from c union all select k, 'active', 2 from c where amt > 0 union all select id, 'new', 0 from sl_e) u) x where rn = 1;

# a branch with now() stays a separate branch

statement ok
create materialized view sl_now_branch_ref as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'open' as st, 1 as p from sl_f union all select k, 'active', 2 from sl_f where amt > 0 union all select k, 'late', 3 from sl_f where ts < now()) u) x where rn = 1;

# kept: the branches compute the key differently

statement ok
create materialized view sl_kept_key_ref as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'open' as st, 1 as p from sl_f union all select r, 'active', 2 from sl_f where amt > 0) u) x where rn = 1;

# kept: two rows per key

statement ok
