# three branches over the same table become one CASE, one branch over another table

statement ok
create materialized view sl_form1_ref as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'open' as st, 1 as p from sl_f union all select k, 'active', 2 from sl_f where amt > 0 union all select k, 'closed', 3 from sl_f where st = 'back' union all select k, 'held', 4 from sl_g) u) x where rn = 1;

# every branch over a table that is not unique on the key: the top-1 stays

statement ok
create materialized view sl_same_table_ref as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'open' as st, 1 as p from sl_f union all select k, 'active', 2 from sl_f where amt > 0 union all select k, 'closed', 3 from sl_f where st = 'back') u) x where rn = 1;

# every branch over a table unique on the key, with a default branch

statement ok
create materialized view sl_unique_default_ref as select id as c1, st as c2 from (select id, st, row_number() over (partition by id order by p desc) as rn from (select id, 'new' as st, 1 as p from sl_e union all select id, 'active', 2 from sl_e where a > 0 union all select id, 'closed', 3 from sl_e where s = 'closed') u) x where rn = 1;

# every branch over a table unique on the key, without a default branch

statement ok
