# After the backfill: with and without the variables, every materialized view holds the same rows.

query III
select
  (select count(*) from (select c1, c2, count(*) as n from sl_form1_case group by c1, c2 except select c1, c2, count(*) as n from sl_form1_ref group by c1, c2) x),
  (select count(*) from (select c1, c2, count(*) as n from sl_form1_ref group by c1, c2 except select c1, c2, count(*) as n from sl_form1_case group by c1, c2) y),
  (select count(*) from sl_form1_case) - (select count(*) from sl_form1_ref);
----
0 0 0

query III
select
  (select count(*) from (select c1, c2, count(*) as n from sl_form1_merge group by c1, c2 except select c1, c2, count(*) as n from sl_form1_ref group by c1, c2) x),
  (select count(*) from (select c1, c2, count(*) as n from sl_form1_ref group by c1, c2 except select c1, c2, count(*) as n from sl_form1_merge group by c1, c2) y),
  (select count(*) from sl_form1_merge) - (select count(*) from sl_form1_ref);
----
0 0 0

