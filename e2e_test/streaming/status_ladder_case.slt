# Changes: rows that move from one filter to another, and to NULL.

statement ok
update sl_f set st = 'back' where r in (3, 8);

statement ok
update sl_f set st = null where r in (1, 4);

statement ok
update sl_f set amt = -amt where r in (9, 11, 13);

statement ok
update sl_f set amt = null where r = 12;

statement ok
update sl_f set k = 9 where r = 6;

statement ok
update sl_f set k = null where r = 10;

statement ok
update sl_f set ts = '2101-01-01 00:00:00+00:00' where r = 1;

statement ok
update sl_f set ts = '2001-01-01 00:00:00+00:00' where r in (7, 9);

statement ok
update sl_e set a = null where id = 4;

statement ok
update sl_e set s = 'closed', a = 2 where id = 2;

statement ok
update sl_e set s = null where id = 1;

statement ok
update sl_e set b = 9 where id = 6;

statement ok
update sl_g set k = 2 where r = 1;

