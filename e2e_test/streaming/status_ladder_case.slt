# every branch is a GROUP BY of the same table by the key: the top-1 is removed

statement ok
create materialized view sl_agg_only_ref as select k as c1, st as c2 from (select k, st, row_number() over (partition by k order by p desc) as rn from (select k, 'seen' as st, 1 as p from sl_f group by k union all select k, 'active', 2 from sl_f where amt > 0 group by k union all select k, 'closed', 3 from sl_f where st = 'back' and amt is not null group by k) u) x where rn = 1;

