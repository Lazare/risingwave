SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table sl_e (id int primary key, a int, b int, s varchar);

statement ok
create table sl_f (r int primary key, k int, st varchar, amt int, ts timestamptz);

statement ok
create table sl_g (r int primary key, k int);

