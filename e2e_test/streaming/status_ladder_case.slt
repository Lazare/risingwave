# Changes: new rows, duplicates of a key, NULL keys, a row written again.

statement ok
insert into sl_f values (12, 8, 'back', 1, '2001-01-01 00:00:00+00:00'), (13, 8, 'x', 2, '2101-01-01 00:00:00+00:00'), (14, null, null, 9, null), (15, 3, 'back', 0, '2001-01-01 00:00:00+00:00');

statement ok
delete from sl_f where r = 2;

statement ok
insert into sl_f values (2, 1, 'back', 4, '2001-01-01 00:00:00+00:00');

statement ok
insert into sl_e values (7, 3, 3, 'closed'), (8, null, -2, null);

statement ok
insert into sl_g values (6, 8), (7, null);

