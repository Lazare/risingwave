# Second round of changes: updates and deletes, which retract rows.

statement ok
update per_t set v2 = v2 + 1 where v1 = 1;

statement ok
update per_t set v1 = 2, v3 = null where v1 = 3;

statement ok
delete from per_t where v1 = 6;

statement ok
delete from per_t where v1 is null and v2 is null;

statement ok
update per_s set w = 2 where w = 1;

statement ok
delete from per_s where k = 2;

statement ok
update per_r set x = 5 where x is null;

statement ok
delete from per_r where k = 1;

statement ok
update per_n set b = b + 1, c = c + 1 where a = 1;

statement ok
delete from per_n where a = 2;

statement ok
update per_f set amt = amt + 2, dim_id = 3 where id = 11;

statement ok
update per_f set dim_id = null where id = 15;

statement ok
delete from per_f where id = 12;

statement ok
update per_d set grp = 2, name = 'uno' where id = 1;

statement ok
delete from per_d where id = 2;

statement ok
delete from per_d where id = 99;

statement ok
update per_e set code = 'cc' where id = 3;

statement ok
delete from per_e where id = 7;

