  (select count(*) from (select * from per_down_padded_off except select * from per_down_padded_on) y),
  (select count(*) from per_down_padded_on) - (select count(*) from per_down_padded_off);
----
0 0 0

query III
select
  (select count(*) from (select * from per_down_const_row_on except select * from per_down_const_row_off) x),
  (select count(*) from (select * from per_down_const_row_off except select * from per_down_const_row_on) y),
  (select count(*) from per_down_const_row_on) - (select count(*) from per_down_const_row_off);
----
0 0 0

# After the updates and deletes: the materialized views that need the pruning hold the rows of their query.

query III
select
  (select count(*) from (select * from per_uoj_const_on except select * from (select f.id as fid, f.amt as amt from per_f f left join per_d d on d.id = 2 and f.amt > d.grp) q) x),
  (select count(*) from (select * from (select f.id as fid, f.amt as amt from per_f f left join per_d d on d.id = 2 and f.amt > d.grp) q except select * from per_uoj_const_on) y),
  (select count(*) from per_uoj_const_on) - (select count(*) from (select f.id as fid, f.amt as amt from per_f f left join per_d d on d.id = 2 and f.amt > d.grp) q);
----
0 0 0

query III
select
  (select count(*) from (select * from per_row_cross_on except select * from (select t.v1 as tv, c.x as cx, c.y as cy from per_t t cross join (values (1, 'a')) as c(x, y)) q) x),
  (select count(*) from (select * from (select t.v1 as tv, c.x as cx, c.y as cy from per_t t cross join (values (1, 'a')) as c(x, y)) q except select * from per_row_cross_on) y),
  (select count(*) from per_row_cross_on) - (select count(*) from (select t.v1 as tv, c.x as cx, c.y as cy from per_t t cross join (values (1, 'a')) as c(x, y)) q);
----
0 0 0

query III
select
  (select count(*) from (select * from per_row_left_side_on except select * from (select c.x as cx, s.k as sk, s.w as sw from (values (7)) as c(x) join per_s s on s.w < c.x) q) x),
  (select count(*) from (select * from (select c.x as cx, s.k as sk, s.w as sw from (values (7)) as c(x) join per_s s on s.w < c.x) q except select * from per_row_left_side_on) y),
  (select count(*) from per_row_left_side_on) - (select count(*) from (select c.x as cx, s.k as sk, s.w as sw from (values (7)) as c(x) join per_s s on s.w < c.x) q);
----
0 0 0

query III
select
  (select count(*) from (select * from per_row_agg_on except select * from (select t.v1 as tv, a.c as ac from per_t t cross join (select count(*) as c from per_s where w = 1 and w = 2) a) q) x),
  (select count(*) from (select * from (select t.v1 as tv, a.c as ac from per_t t cross join (select count(*) as c from per_s where w = 1 and w = 2) a) q except select * from per_row_agg_on) y),
  (select count(*) from per_row_agg_on) - (select count(*) from (select t.v1 as tv, a.c as ac from per_t t cross join (select count(*) as c from per_s where w = 1 and w = 2) a) q);
----
0 0 0

query I
select count(*) from per_eq_eq_on;
----
0

query I
select count(*) from per_limit0_on;
----
0

query II
select c, m from per_agg_join_on;
----
0 NULL

query I
select count(*) from per_nn_is_null_on;
----
0

# The filtered sum of a row that does not pass the filter any more: the streaming aggregation
# keeps `0`, the projection that replaces it returns `NULL` as the query does.

query II
select cnt, total from per_key_agg_filter_off where id = 15;
----
0 0

query II
select cnt, total from per_key_agg_filter_on where id = 15;
----
0 NULL

query II
select count(*) filter (where amt > 5), sum(amt) filter (where dim_id is not null) from per_f where id = 15;
----
0 NULL

# A `NOT NULL` column added later: the rows written before read its default value.

statement ok
alter table per_n add column e int not null default 9;

statement ok
set streaming_prune_empty_relation = false;

statement ok
set streaming_simplify_on_unique_key = false;

statement ok
create materialized view per_nn_added_off as select a, e, e is null as missing from per_n where e is null or a = 1;

statement ok
set streaming_prune_empty_relation = true;

statement ok
set streaming_simplify_on_unique_key = true;

statement ok
create materialized view per_nn_added_on as select a, e, e is null as missing from per_n where e is null or a = 1;

query III
select
  (select count(*) from (select * from per_nn_added_on except select * from per_nn_added_off) x),
  (select count(*) from (select * from per_nn_added_off except select * from per_nn_added_on) y),
  (select count(*) from per_nn_added_on) - (select count(*) from per_nn_added_off);
----
0 0 0

statement ok
insert into per_n (a, b, e) values (1, 1, 4), (7, 7, 7);

statement ok
insert into per_n (a, b) values (1, 5);

query III
select
  (select count(*) from (select * from per_nn_added_on except select * from per_nn_added_off) x),
  (select count(*) from (select * from per_nn_added_off except select * from per_nn_added_on) y),
  (select count(*) from per_nn_added_on) - (select count(*) from per_nn_added_off);
----
0 0 0

query IIT
select a, e, missing from per_nn_added_on order by e;
----
1 4 f
1 9 f
1 9 f
1 9 f
1 9 f

