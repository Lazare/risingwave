# is null and in-list

statement ok
create materialized view per_null_in_on as select v1, v3 from per_t where v3 is null and v3 in ('a', 'b');

# comparison with a null constant

statement ok
create materialized view per_eq_null_on as select v1, v2 from per_t where v1 = null;

# empty range

statement ok
create materialized view per_range_on as select v1, v2 from per_t where v1 > 5 and v1 < 3;

# boolean column and its negation

statement ok
create materialized view per_bool_on as select v1, b from per_t where b and not b;

# in-list and not in-list

statement ok
create materialized view per_in_notin_on as select v1, v3 from per_t where v1 in (1, 2) and v1 not in (2, 1, 3);

# constant false conjunct

statement ok
create materialized view per_const_false_on as select v1, v2 from per_t where 1 = 0 and v1 > 1;

# kept: satisfiable equality and in-list

statement ok
create materialized view per_kept_eq_in_on as select v1, v2 from per_t where v1 = 1 and v1 in (1, 2);

# kept: point range

statement ok
create materialized view per_kept_point_on as select v1, v2 from per_t where v1 >= 2 and v1 <= 2;

# kept: open range

statement ok
create materialized view per_kept_open_on as select v1, v2 from per_t where v1 > 1 and v1 < 3;

# kept: contradiction under a disjunction

statement ok
create materialized view per_kept_or_on as select v1, v2 from per_t where v1 is null or (v1 = 1 and v1 = 2);

# kept: in-list with a null item

statement ok
create materialized view per_kept_in_null_on as select v1, v2 from per_t where v1 in (1, null) and v1 = 1;

# union all: one branch removed

statement ok
create materialized view per_union_two_on as select kind, v from (select 'a' as kind, v1 as v from per_t union all select 'b' as kind, k as v from per_s union all select 'c' as kind, k as v from per_r) u where kind = 'a' or kind = 'c';

# union all: a single branch left

statement ok
create materialized view per_union_one_on as select kind, v from (select 'a' as kind, v1 as v from per_t union all select 'b' as kind, k as v from per_s) u where kind = 'b';

# union all: every branch removed

statement ok
create materialized view per_union_none_on as select kind, v from (select 'a' as kind, v1 as v from per_t union all select 'b' as kind, k as v from per_s) u where kind = 'z';

# union distinct: one branch removed

statement ok
create materialized view per_union_distinct_on as select kind, v from (select 'a' as kind, v1 as v from per_t union select 'b' as kind, k as v from per_s) u where kind = 'a';

# inner join: a side is empty

statement ok
create materialized view per_inner_empty_on as select t.v1 as tv, s.w as sw from per_t t join per_s s on t.v1 = s.k where s.w is null and s.w = 1;

# left join: the right side is empty

statement ok
create materialized view per_left_right_empty_on as select t.v1 as tv, t.v3 as tv3, s.w as sw, s.k as sk from per_t t left join (select * from per_s where w = 1 and w = 2) s on t.v1 = s.k;

# left join: the left side is empty

statement ok
create materialized view per_left_left_empty_on as select t.v1 as tv, s.w as sw from (select * from per_t where v1 = 1 and v1 = 2) t left join per_s s on t.v1 = s.k;

# right join: the left side is empty

statement ok
create materialized view per_right_left_empty_on as select t.v1 as tv, s.w as sw, s.k as sk from (select * from per_t where v1 = 1 and v1 = 2) t right join per_s s on t.v1 = s.k;

# full join: the right side is empty

statement ok
create materialized view per_full_right_empty_on as select t.v1 as tv, t.v2 as tv2, s.w as sw from per_t t full join (select * from per_s where w = 1 and w = 2) s on t.v1 = s.k;

# full join: the left side is empty

statement ok
create materialized view per_full_left_empty_on as select t.v1 as tv, s.w as sw, s.k as sk from (select * from per_t where v1 = 1 and v1 = 2) t full join per_s s on t.v1 = s.k;

# full join: both sides are empty

statement ok
create materialized view per_full_both_empty_on as select t.v1 as tv, s.w as sw from (select * from per_t where v1 = 1 and v1 = 2) t full join (select * from per_s where w = 1 and w = 2) s on t.v1 = s.k;

# semi join: the right side is empty

statement ok
create materialized view per_semi_empty_on as select v1, v2 from per_t where v1 in (select k from per_s where w = 1 and w = 2);

# anti join: the right side is empty

statement ok
create materialized view per_anti_empty_on as select v1, v3 from per_t t where not exists (select 1 from per_s s where s.k = t.v1 and w = 1 and w = 2);

# inner join: the condition is never true

statement ok
create materialized view per_inner_on_false_on as select t.v1 as tv, s.w as sw from per_t t join per_s s on t.v1 = s.k and t.v2 = 3 and t.v2 = 4;

# left join: the condition is never true

statement ok
create materialized view per_left_on_false_on as select t.v1 as tv, t.v2 as tv2, s.w as sw from per_t t left join per_s s on t.v1 = s.k and t.v2 = 3 and t.v2 = 4;

# kept: full join whose condition is never true

statement ok
create materialized view per_kept_full_on_false_on as select t.v1 as tv, s.w as sw from per_t t full join per_s s on t.v1 = s.k and t.v1 = 3 and t.v1 = 4;

# three-way join: only the optional side is removed

statement ok
create materialized view per_three_way_on as select t.v1 as tv, s.w as sw, r.x as rx from per_t t join per_s s on t.v1 = s.k left join (select * from per_r where x is null and x > 0) r on s.k = r.k;

# left join used as an anti join, with an empty right side

statement ok
create materialized view per_left_is_null_on as select t.v1 as tv, coalesce(s.w, -1) as sw from per_t t left join (select * from per_s where w = 1 and w = 2) s on t.v1 = s.k where s.k is null;

# agg with group key over an empty input

statement ok
create materialized view per_agg_group_on as select v2, count(*) as cnt from per_t where v1 = 1 and v1 = 2 group by v2;

# agg without group key over an empty input

statement ok
create materialized view per_agg_simple_on as select count(*) as c1, count(v1) as c2, sum(v1) as s1, min(v3) as m1, max(ts) as m2, avg(v2) as a1, bool_and(b) as b1, string_agg(v3, ',' order by v3) as sa from per_t where v1 = 1 and v1 = 2;

# distinct agg without group key over an empty input

statement ok
create materialized view per_agg_distinct_on as select count(distinct v1) as c, sum(distinct v2) as s from per_t where v1 = 1 and v1 = 2;

# agg without group key over a join with an empty side

statement ok
create materialized view per_agg_join_on as select count(*) as c, max(t.v2) as m from per_t t join (select * from per_s where w = 1 and w = 2) s on t.v1 = s.k;

# agg without group key over a non-empty input

statement ok
create materialized view per_agg_kept_on as select count(*) as c, sum(v1) as s from per_t where v1 >= 2 and v1 <= 2;

# distinct over an empty input

statement ok
create materialized view per_distinct_on as select distinct v2 from per_t where v1 = 1 and v1 = 2;

# top-n over an empty input

statement ok
create materialized view per_topn_on as select v1, v2 from (select * from per_t where v1 = 1 and v1 = 2) x order by v2 limit 3;

# group top-n over an empty input

statement ok
create materialized view per_group_topn_on as select v1, v2, v3 from (select *, row_number() over (partition by v2 order by v3) as rn from per_t where v1 = 1 and v1 = 2) x where rn = 1;

# shared empty relation used twice

statement ok
create materialized view per_share_twice_on as with c as (select * from per_t where v1 = 1 and v1 = 2) select a.v1 as av, b.v2 as bv from c a join c b on a.v1 = b.v1;

# shared relation with one empty consumer

statement ok
create materialized view per_share_one_on as with c as (select v1, v2 from per_t) select v1, v2 from c where v1 = 1 and v1 = 2 union all select v1, v2 from c where v2 = 7;

# contradiction next to a temporal filter

statement ok
create materialized view per_temporal_on as select v1, ts from per_t where ts > now() - interval '1 hour' and v1 is null and v1 = 3;

# constant propagated into another conjunct

statement ok
create materialized view per_const_conj_on as select v1, v2 from per_t where v1 = 2 and v2 > v1;

# constant propagated into a projection

statement ok
create materialized view per_const_proj_on as select v1, v1 + v2 as total from per_t where v1 = 2;

# constant propagated through an equality between columns

statement ok
create materialized view per_const_eqcol_on as select v1, v2 from per_t where v1 = 3 and v2 = v1 and v2 = 4;

# constant column of a union branch in a case expression

statement ok
create materialized view per_const_case_on as select case when kind = 'a' then v else -v end as r, case when kind = 'b' then 1 when v > 0 then 2 else 3 end as c from (select 'a' as kind, v1 as v from per_t union all select 'b' as kind, k as v from per_s) u where kind = 'a';

# constant group key removed by a having clause

statement ok
create materialized view per_const_having_on as select kind, count(*) as cnt from (select 'a' as kind, v1 from per_t) x group by kind having kind = 'b';

# constant propagated through an inner join

statement ok
create materialized view per_const_join_on as select t.v1 as tv, s.w as sw, t.v2 + s.k as total from per_t t join per_s s on t.v1 = s.k where t.v1 = 2;

# constant of the optional side of a left join

statement ok
create materialized view per_const_left_on as select t.v1 as tv, s.w as sw, s.w + 1 as w1, s.w is null as missing from per_t t left join (select * from per_s where w = 1) s on t.v1 = s.k;

# last_value of a constant, packed with another last_value

statement ok
create materialized view per_agg_const_last_on as select v1, x from (select v1, last_value('set' order by ts) as op, last_value(v2 order by ts) as x from per_t group by v1) z where op = 'set';

# last_value of the tag of a view over one table

statement ok
create materialized view per_agg_const_ops_on as with ops(op, k, x, ts) as (select 'set', v1, v2, ts from per_t), last as (select k, last_value(op order by ts) as op, last_value(x order by ts) as x, first_value(ts order by ts) as created from ops group by k) select k, x, created from last where op = 'set';

# max and min of a constant

statement ok
create materialized view per_agg_const_minmax_on as select v1 from (select v1, max('a') as hi, min(1) as lo from per_t group by v1) z where hi = 'a' and lo = 1;

# aggregate of a constant compared with another value

statement ok
create materialized view per_agg_const_other_on as select v1 from (select v1, last_value('set' order by ts) as op from per_t group by v1) z where op = 'delete';

# kept: last_value of a tag that differs between the branches of a union

statement ok
create materialized view per_agg_const_union_on as with ops(op, k, ts) as (select 'set', v1, ts from per_t union all select 'delete', v1, ts from per_t where b) select k from (select k, last_value(op order by ts) as op from ops group by k) z where op = 'set';

# kept: aggregate of a constant with a filter clause

statement ok
create materialized view per_agg_const_filter_on as select v1 from (select v1, max('a') filter (where v2 > 3) as hi from per_t group by v1) z where hi = 'a';

# aggregate of a constant on the optional side of a left join

statement ok
create materialized view per_agg_const_left_on as select s.k as sk, z.op is null as missing, z.op = 'set' as is_set from per_s s left join (select v1, last_value('set' order by ts) as op from per_t group by v1) z on s.k = z.v1;

# is null on a count

statement ok
create materialized view per_null_count_on as select v1, c from (select v1, count(*) as c from per_t group by v1) x where c is null;

# is null on a count in a projection

statement ok
create materialized view per_null_count_proj_on as select v1, c is null as missing, c is not null as present from (select v1, count(*) as c from per_t group by v1) x;

# is null on a coalesce with a constant

statement ok
create materialized view per_null_coalesce_on as select c, v2 from (select coalesce(v1, 0) as c, v2 from per_t) x where c is null;

# is not null implied by a comparison

statement ok
create materialized view per_null_implied_on as select v1, v2 from per_t where v1 > 0 and v1 is not null;

# is null under a disjunction

statement ok
create materialized view per_null_or_on as select v1, v2 from per_t where (v1 is null or v2 = 3) and v1 > 0;

# is null on a join key of an inner join

statement ok
create materialized view per_null_join_key_on as select t.v1 as tv, s.w as sw from per_t t join per_s s on t.v1 = s.k where s.k is null or s.w = 1;

# kept: is null on the optional side of a left join

statement ok
create materialized view per_kept_anti_pattern_on as select t.v1 as tv, t.v2 as tv2 from per_t t left join per_s s on t.v1 = s.k where s.k is null;

# kept: is null on a sum

statement ok
create materialized view per_kept_null_sum_on as select v1, total from (select v1, sum(v2) as total from per_t group by v1) x where total is null;

# kept: is null on a plain column

statement ok
create materialized view per_kept_null_col_on as select v1, v2 is null as missing from per_t where v1 is null;

# redundant lower bounds

statement ok
create materialized view per_bounds_lower_on as select v1, v2 from per_t where v1 > 1 and v1 > 0 and v1 >= 1;

# redundant upper bounds

statement ok
create materialized view per_bounds_upper_on as select v1, v3 from per_t where v1 < 5 and v1 <= 5 and v3 < 'm' and v3 < 'c';

# inner join with a constant row and a condition

statement ok
create materialized view per_row_inner_on as select t.v1 as tv, t.v2 as tv2, c.y as cy from per_t t join (values (1, 2)) as c(x, y) on t.v1 = c.x and t.v2 > c.y;

# kept: join with two constant rows

statement ok
create materialized view per_kept_row_two_on as select t.v1 as tv, c.x as cx from per_t t join (values (1), (2)) as c(x) on t.v1 = c.x;

# kept: left join with a constant row

statement ok
create materialized view per_kept_row_left_on as select t.v1 as tv, c.x as cx from per_t t left join (values (1)) as c(x) on t.v1 = c.x;

# is null on a not null column

statement ok
create materialized view per_nn_is_null_on as select a, b from per_n where a is null;

# is null on not null columns in a projection

statement ok
create materialized view per_nn_proj_on as select a, a is null as m1, coalesce(a, 0) is null as m2, c is null as m3, b is null as m4 from per_n;

# is not null on a not null column

statement ok
create materialized view per_nn_not_null_on as select a, b from per_n where a is not null and b > 1;

# is null on a not null column with a default

statement ok
create materialized view per_nn_default_on as select a, c from per_n where c is null or a = 1;

# is null on a not null column through an inner join

statement ok
create materialized view per_nn_inner_on as select t.v1 as tv, n.a as na from per_t t join per_n n on t.v1 = n.b where n.a is null or n.c is null;

# kept: is null on a not null column of the optional side of a left join

statement ok
create materialized view per_kept_nn_left_on as select t.v1 as tv, n.a as na from per_t t left join per_n n on t.v1 = n.b where n.a is null;

# unused left join on the primary key of the right side

statement ok
create materialized view per_uoj_on as select f.id as fid, f.amt as amt from per_f f left join per_d d on f.dim_id = d.id;

# unused left join with an extra condition

statement ok
create materialized view per_uoj_extra_on as select f.id as fid, f.amt as amt from per_f f left join per_d d on f.dim_id = d.id and d.grp > 1 and f.amt > 0;

# unused right join

statement ok
create materialized view per_uoj_right_on as select f.id as fid, f.amt as amt from per_d d right join per_f f on f.dim_id = d.id;

# two left joins, only the unused one is removed

statement ok
create materialized view per_uoj_two_on as select f.id as fid, e.code as code from per_f f left join per_d d on f.dim_id = d.id left join per_e e on f.amt = e.id;

# unused left join on a deduplicated right side

statement ok
create materialized view per_uoj_dedup_on as select f.id as fid, f.amt as amt from per_f f left join (select * from (select *, row_number() over (partition by grp order by id) as rn from per_d) x where rn = 1) latest on f.dim_id = latest.grp;

# unused left join on an aggregated right side

statement ok
create materialized view per_uoj_agg_on as select f.id as fid, f.amt as amt from per_f f left join (select grp, count(*) as cnt from per_d group by grp) g on f.dim_id = g.grp;

# unused left join under an aggregation

statement ok
create materialized view per_uoj_under_agg_on as select f.dim_id as dim_id, sum(f.amt) as total from per_f f left join per_d d on f.dim_id = d.id group by f.dim_id;

# kept: left join whose right side is used

statement ok
create materialized view per_kept_uoj_used_on as select f.id as fid, d.name as name from per_f f left join per_d d on f.dim_id = d.id;

# kept: left join whose right side is used in a filter above

statement ok
create materialized view per_kept_uoj_anti_on as select f.id as fid, f.amt as amt from per_f f left join per_d d on f.dim_id = d.id where d.id is null;

# kept: unused left join on a column that is not a key

statement ok
create materialized view per_kept_uoj_not_key_on as select f.id as fid, f.amt as amt from per_f f left join per_d d on f.dim_id = d.grp;

# kept: unused inner join

statement ok
create materialized view per_kept_uoj_inner_on as select f.id as fid, f.amt as amt from per_f f join per_d d on f.dim_id = d.id;

# aggregation on the primary key

statement ok
create materialized view per_key_agg_on as select id, sum(amt) as total, count(*) as cnt, count(dim_id) as cnt_dim, min(label) as first_label, max(amt) as max_amt, sum(price) as total_price from per_f group by id;

# aggregation with filters on the primary key

statement ok
create materialized view per_key_agg_filter_on as select id, count(*) filter (where amt > 5) as cnt, sum(amt) filter (where dim_id is not null) as total from per_f group by id;

# average on the primary key

statement ok
create materialized view per_key_avg_on as select id, avg(amt) as average from per_f group by id;

# aggregation on a group key larger than the primary key

statement ok
create materialized view per_key_agg_larger_on as select id, dim_id, sum(amt) as total, bool_and(amt > 3) as all_big from per_f group by id, dim_id;

# distinct on columns that contain the primary key

statement ok
create materialized view per_key_distinct_on as select distinct id, amt from per_f;

# distinct on the output of an aggregation

statement ok
create materialized view per_key_distinct_agg_on as select distinct grp, cnt from (select grp, count(*) as cnt from per_d group by grp) g;

# aggregation above a left join with a unique right side

statement ok
create materialized view per_key_agg_join_on as select f.id as fid, d.name as name, sum(f.amt) as total from per_f f left join per_d d on f.dim_id = d.id group by f.id, d.name;

# top-1 per primary key

statement ok
create materialized view per_key_top1_on as select id, amt from (select *, row_number() over (partition by id order by amt) as rn from per_f) x where rn = 1;

# top-1 over a top-1 on the same key

statement ok
create materialized view per_key_top1_twice_on as with latest as (select * from (select *, row_number() over (partition by grp order by id desc) as rn from per_d) x where rn = 1) select grp, name from (select *, row_number() over (partition by grp order by name) as rn2 from latest) y where rn2 = 1;

# kept: aggregation on a column that is not a key

statement ok
create materialized view per_kept_key_agg_on as select dim_id, sum(amt) as total, count(*) as cnt from per_f group by dim_id;

# kept: distinct without the primary key

statement ok
create materialized view per_kept_key_distinct_on as select distinct dim_id, amt from per_f;

# kept: aggregate without a one-row form

statement ok
create materialized view per_kept_key_array_on as select id, array_agg(amt) as amounts from per_f group by id;

# kept: aggregation above an inner join that multiplies rows

statement ok
create materialized view per_kept_key_join_on as select f.id as fid, sum(d.id) as total from per_f f join per_d d on f.dim_id = d.grp group by f.id;

# on top of an empty materialized view

statement ok
create materialized view per_down_empty_agg_on as select v1, count(*) as cnt from per_eq_eq_on group by v1;

# join with an empty materialized view

statement ok
create materialized view per_down_empty_join_on as select t.v1 as tv, e.v2 as ev from per_t t left join per_eq_eq_on e on t.v1 = e.v1;

# on top of a left join replaced with a projection

statement ok
create materialized view per_down_padded_on as select tv, count(sw) as cnt, count(*) as total from per_left_right_empty_on group by tv;

# on top of an aggregation replaced with its constant row

statement ok
create materialized view per_down_const_row_on as select t.v1 as tv, a.c1 as c1, a.s1 as s1 from per_t t join per_agg_simple_on a on t.v2 = a.c1 + 3;

# unused left join whose right key is bound by a constant

statement ok
create materialized view per_uoj_const_on as select f.id as fid, f.amt as amt from per_f f left join per_d d on d.id = 2 and f.amt > d.grp;

# cross join with a constant row

statement ok
create materialized view per_row_cross_on as select t.v1 as tv, c.x as cx, c.y as cy from per_t t cross join (values (1, 'a')) as c(x, y);

# constant row on the left side

statement ok
create materialized view per_row_left_side_on as select c.x as cx, s.k as sk, s.w as sw from (values (7)) as c(x) join per_s s on s.w < c.x;

# join with the constant row of an aggregation over an empty input

statement ok
create materialized view per_row_agg_on as select t.v1 as tv, a.c as ac from per_t t cross join (select count(*) as c from per_s where w = 1 and w = 2) a;

# `LIMIT 0` is rejected in streaming without pruning, and empty with it.

statement ok
set streaming_prune_empty_relation = false;

statement ok
set streaming_simplify_on_unique_key = false;

statement error LIMIT 0 in streaming mode
create materialized view per_limit0_off as select v1, v2 from per_t order by v1 limit 0;

statement ok
set streaming_prune_empty_relation = true;

statement ok
set streaming_simplify_on_unique_key = true;

statement ok
create materialized view per_limit0_on as select v1, v2 from per_t order by v1 limit 0;

# After the backfill: with and without pruning, every materialized view holds the same rows.

query III
select
  (select count(*) from (select * from per_eq_eq_on except select * from per_eq_eq_off) x),
  (select count(*) from (select * from per_eq_eq_off except select * from per_eq_eq_on) y),
  (select count(*) from per_eq_eq_on) - (select count(*) from per_eq_eq_off);
----
0 0 0

query III
select
  (select count(*) from (select * from per_null_in_on except select * from per_null_in_off) x),
  (select count(*) from (select * from per_null_in_off except select * from per_null_in_on) y),
  (select count(*) from per_null_in_on) - (select count(*) from per_null_in_off);
----
0 0 0

query III
select
  (select count(*) from (select * from per_eq_null_on except select * from per_eq_null_off) x),
  (select count(*) from (select * from per_eq_null_off except select * from per_eq_null_on) y),
  (select count(*) from per_eq_null_on) - (select count(*) from per_eq_null_off);
----
0 0 0

query III
select
  (select count(*) from (select * from per_range_on except select * from per_range_off) x),
  (select count(*) from (select * from per_range_off except select * from per_range_on) y),
  (select count(*) from per_range_on) - (select count(*) from per_range_off);
----
0 0 0

