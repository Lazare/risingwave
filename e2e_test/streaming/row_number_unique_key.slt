create materialized view rnks_having_off as select k from (select id, k, k2, v, w, row_number() over (partition by k order by v, id) as rn, count(w) over (partition by k order by v, id) as sw from rnks_t) s where rn = 1 group by k having count(*) > 1;

statement ok
create materialized view rnks_count_off as select k, count(*) as n, max(v) as mv, max(sw) as sw from (select id, k, k2, v, w, row_number() over (partition by k order by v, id) as rn, count(w) over (partition by k order by v, id) as sw from rnks_t) s where rn = 1 group by k;

