# Differential test of `streaming_factor_union_join`: every query is materialized twice, with and
# without the join factored out of the branches of its union, and both materialized views must
# hold the same rows after the backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/factor_union_join.gen.py <this file>`: edit the list
# of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table fuj_f (id int primary key, dim_id int, other_id int, amt int, label varchar);

statement ok
create table fuj_d (id int primary key, name varchar, grp int, active boolean);

statement ok
create table fuj_e (id int primary key, code varchar, ref_id int);

statement ok
create table fuj_g (id int primary key, a int, b int);

statement ok
create view fuj_da as select * from fuj_d where active;

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into fuj_d values (1, 'one', 1, true), (2, 'two', 1, false), (3, 'three', 2, true), (4, null, null, null), (5, 'five', 2, null), (6, 'six', null, true), (7, null, 3, false);

statement ok
insert into fuj_e values (101, 'a', 1), (103, 'three', 3), (105, 'e', 5), (108, null, 8), (109, 'two', 2), (110, 'x', null);

statement ok
insert into fuj_f values (10, 1, 1, 5, 'x'), (11, 1, 3, 0, 'y'), (12, 3, null, 3, null), (13, null, 5, 2, 'z'), (14, 99, 8, null, 'w'), (15, 2, 2, 1, 'x'), (16, 4, 1, 2, 'v'), (17, 5, 9, 1, 'u'), (18, 6, 3, 3, 't'), (19, 7, null, 4, 's');

statement ok
insert into fuj_g values (201, 1, 1), (202, 1, 2), (203, 2, 1), (204, 3, 2), (205, null, 1), (206, 5, null), (207, 101, 3);

statement ok
set streaming_factor_union_join = false;

# two branches with the same inner join

statement ok
create materialized view fuj_inner_off as select f.id as id, d.name as dn from fuj_f f join fuj_d d on f.dim_id = d.id union all select e.id, d.name from fuj_e e join fuj_d d on e.ref_id = d.id;

# left joins with different projections above

statement ok
create materialized view fuj_left_proj_off as select f.id as id, f.label as txt, least(f.amt, d.grp) as n from fuj_f f left join fuj_d d on f.dim_id = d.id union all select e.id, e.code, d.grp from fuj_e e left join fuj_d d on e.ref_id = d.id;

# inner joins with a different filter of the joined table in each branch

statement ok
create materialized view fuj_inner_filters_off as select f.id as id, d.name as dn from fuj_f f join fuj_d d on f.dim_id = d.id where d.active union all select e.id, d.name from fuj_e e join fuj_d d on e.ref_id = d.id where d.grp = 2;

# inner joins with filters that can be NULL

statement ok
create materialized view fuj_inner_null_filters_off as select f.id as id, d.name as dn from fuj_f f join fuj_d d on f.dim_id = d.id where not d.active union all select e.id, d.name from fuj_e e join fuj_d d on e.ref_id = d.id where d.grp > 1;

# left joins with a filtered joined table in one branch only

statement ok
create materialized view fuj_left_one_filter_off as select f.id as id, d.name as dn from fuj_f f left join fuj_da d on f.dim_id = d.id union all select e.id, d.name from fuj_e e left join fuj_d d on e.ref_id = d.id;

# left joins with a different filter of the joined table in each branch

statement ok
create materialized view fuj_left_two_filters_off as select f.id as id, d.name as dn, d.grp as dg from fuj_f f left join fuj_da d on f.dim_id = d.id union all select e.id, d.name, d.grp from fuj_e e left join (select * from fuj_d where grp = 2) d on e.ref_id = d.id;

# left joins with a different extra condition in each branch

statement ok
create materialized view fuj_left_conditions_off as select f.id as id, d.name as dn from fuj_f f left join fuj_d d on f.dim_id = d.id and f.amt > d.grp union all select e.id, d.name from fuj_e e left join fuj_d d on e.ref_id = d.id and d.name <> e.code;

# filters above the joins

statement ok
create materialized view fuj_filters_above_off as select f.id as id, d.name as dn from fuj_f f left join fuj_d d on f.dim_id = d.id where f.amt > 3 or d.name is null union all select e.id, d.name from fuj_e e left join fuj_d d on e.ref_id = d.id where e.code is not null;

# expression of the joined table computed below a left join

statement ok
create materialized view fuj_computed_below_off as select f.id as id, x.label as label from fuj_f f left join (select id, coalesce(name, 'none') as label from fuj_d) x on f.dim_id = x.id union all select e.id, x.label from fuj_e e left join (select id, coalesce(name, 'none') as label from fuj_d) x on e.ref_id = x.id;

# expression of the joined table computed above a left join

statement ok
create materialized view fuj_computed_above_off as select f.id as id, coalesce(d.name, 'none') as label from fuj_f f left join fuj_d d on f.dim_id = d.id union all select e.id, d.name || '!' from fuj_e e left join fuj_d d on e.ref_id = d.id;

# semi joins

statement ok
create materialized view fuj_semi_off as select f.id as id, f.label as txt from fuj_f f where exists (select 1 from fuj_d d where d.id = f.dim_id) union all select e.id, e.code from fuj_e e where exists (select 1 from fuj_d d where d.id = e.ref_id);

# anti joins with a different filter of the joined table

statement ok
create materialized view fuj_anti_off as select f.id as id, f.label as txt from fuj_f f where not exists (select 1 from fuj_d d where d.id = f.dim_id and d.active) union all select e.id, e.code from fuj_e e where not exists (select 1 from fuj_d d where d.id = e.ref_id);

# anti joins with an extra condition in one branch

statement ok
create materialized view fuj_anti_condition_off as select f.id as id, f.label as txt from fuj_f f where not exists (select 1 from fuj_d d where d.id = f.dim_id and d.grp < f.amt) union all select e.id, e.code from fuj_e e where not exists (select 1 from fuj_d d where d.id = e.ref_id and d.grp = 2);

# join on a column of the joined table that is not its key

statement ok
create materialized view fuj_not_key_off as select f.id as id, d.name as dn from fuj_f f join fuj_d d on f.amt = d.grp union all select e.id, d.name from fuj_e e join fuj_d d on e.ref_id = d.grp;

# left join on a column of the joined table that is not its key

statement ok
create materialized view fuj_not_key_left_off as select f.id as id, d.name as dn, d.id as did from fuj_f f left join fuj_d d on f.amt = d.grp and d.active union all select e.id, d.name, d.id from fuj_e e left join fuj_d d on e.ref_id = d.grp;

# three branches, two of which share their join

statement ok
create materialized view fuj_three_two_off as select f.id as id, d.name as txt from fuj_f f join fuj_d d on f.dim_id = d.id union all select g.id, e.code from fuj_g g join fuj_e e on g.a = e.id union all select e.id, d.name from fuj_e e join fuj_d d on e.ref_id = d.id;

# three branches with the same join

statement ok
create materialized view fuj_three_off as select f.id as id, d.name as dn, 'f' as src from fuj_f f join fuj_d d on f.dim_id = d.id union all select e.id, d.name, 'e' from fuj_e e join fuj_d d on e.ref_id = d.id union all select g.id, d.name, 'g' from fuj_g g join fuj_d d on g.a = d.id;

# joins on two columns

statement ok
create materialized view fuj_two_columns_off as select f.id as id, d.active as da from fuj_f f join fuj_d d on f.dim_id = d.id and f.amt = d.grp union all select g.id, d.active from fuj_g g join fuj_d d on g.b = d.grp and g.a = d.id;

# the joined table is written on the left side

statement ok
create materialized view fuj_left_side_off as select f.id as id, d.name as dn from fuj_d d join fuj_f f on f.dim_id = d.id union all select e.id, d.name from fuj_d d join fuj_e e on e.ref_id = d.id;

# both branches read the same input with different filters

statement ok
