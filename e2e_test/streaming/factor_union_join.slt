# Second round of changes: updates and deletes, which retract rows and move them between filters.

statement ok
update fuj_d set active = not active where id in (1, 2, 8);

statement ok
update fuj_d set active = true where id = 4;

statement ok
update fuj_d set grp = 2 where id = 1;

statement ok
update fuj_d set grp = 1, name = 'cinq' where id = 5;

statement ok
update fuj_d set grp = null where id = 9;

statement ok
delete from fuj_d where id = 6;

statement ok
delete from fuj_d where id = 99;

statement ok
update fuj_f set dim_id = 3, amt = amt + 2 where id = 11;

statement ok
update fuj_f set dim_id = null where id = 15;

statement ok
update fuj_f set dim_id = 1 where id = 13;

statement ok
update fuj_f set other_id = 2, amt = null where id = 12;

statement ok
delete from fuj_f where id = 16;

statement ok
update fuj_e set code = 'trois' where id = 103;

statement ok
update fuj_e set ref_id = 7 where id = 105;

statement ok
update fuj_e set ref_id = null where id = 109;

statement ok
delete from fuj_e where id = 111;

statement ok
update fuj_g set b = 2 where id = 201;

statement ok
update fuj_g set a = 3 where id = 205;

statement ok
