# Second round of changes: codes set to NULL and back, deletes (retractions).

statement ok
update sivj_t set code = null where k in (2, 3);

statement ok
update sivj_t set code = 'a' where k = 4;

statement ok
update sivj_t set x = 2 where k = 5;

statement ok
update sivj_t set flag = not flag where k in (1, 4);

statement ok
delete from sivj_t where k in (6, 8);

statement ok
delete from sivj_n where code = 'a' and x = 1;

