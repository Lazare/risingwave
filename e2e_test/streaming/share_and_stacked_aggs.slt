statement ok
insert into ssa_a values (1, 1, 0), (2, 2, 1), (3, null, 2), (4, 3, 3), (5, 5, 0), (6, 1, 1);

statement ok
insert into ssa_h values (10, 1, 'x', 1), (11, 1, 'y', 2), (12, 1, 'x', null), (13, 2, null, 2), (14, 3, 'x', -5), (15, null, 'x', 1), (16, 9, 'z', 9), (17, 3, 'z', null);

statement ok
insert into ssa_b values (1, 1, 0), (2, 3, 1), (3, null, 2), (4, 9, 3);

statement ok
set streaming_share_identical_subplans = false;

statement ok
set streaming_merge_stacked_aggregations = false;

# the same join, filtered above a view and in the query

statement ok
create materialized view ssa_share_join_off as select id, v from ssa_v1 where v > 0 union all select a.id, h.v from ssa_a a join ssa_h h on a.k = h.sid where h.v > 0;

# the same aggregation, from a view whose other aggregate is pruned

statement ok
create materialized view ssa_share_agg_off as select a.id, g1.c from ssa_a a join ssa_g1 g1 on a.k = g1.sid union all select b.id, x.c from ssa_b b join (select sid, count(*) as c from ssa_h group by sid) x on b.k = x.sid;

# the domain of two subqueries with the same correlation

statement ok
create materialized view ssa_share_domain_off as select a.id, (select max(v) from ssa_h h where h.sid = a.k) as m1, coalesce((select count(*) from ssa_h h where h.sid = a.k and h.st = 'x'), 0) as c2 from ssa_a a;

# a sub-plan shared at the beginning

statement ok
create materialized view ssa_share_cte_off as with j as (select a.id, h.v from ssa_a a join ssa_h h on a.k = h.sid where h.v > 0) select id, v from j union all select id, v + 1 from j;

# identical filtered scans, not shared

statement ok
create materialized view ssa_share_scans_off as select a.id from ssa_a a where exists (select 1 from ssa_h h where h.sid = a.k and h.v > 0) union all select b.id from ssa_b b where exists (select 1 from ssa_h h where h.sid = b.k and h.v > 0);

# the same join with a different filter in each copy

statement ok
create materialized view ssa_widen_filters_off as select a.id, h.v from ssa_a a join ssa_h h on a.k = h.sid where h.v > 0 union all select a.id, h.id from ssa_a a join ssa_h h on a.k = h.sid where h.st = 'x';

# a left join filtered on its preserved side in one copy

statement ok
create materialized view ssa_widen_left_off as select a.id, h.v from ssa_a a left join ssa_h h on a.k = h.sid where a.x > 0 union all select a.id, h.id from ssa_a a left join ssa_h h on a.k = h.sid;

# the same inner join with its sides swapped

statement ok
create materialized view ssa_swapped_off as select a.id, h.v from ssa_a a join ssa_h h on a.k = h.sid where h.v > 0 union all select a.id, h.id from ssa_h h join ssa_a a on h.sid = a.k where a.x = 1;

# a join of three tables reordered to share the join of two of them

statement ok
create materialized view ssa_reorder_inner_off as select a.id, h.v from ssa_a a join ssa_h h on a.k = h.sid where h.st = 'x' union all select a.id, h.v from ssa_a a join ssa_b b on a.k = b.k join ssa_h h on a.k = h.sid;

# an inner join below a left join reordered to share the left join

statement ok
create materialized view ssa_reorder_left_off as select h.id, a.id as aid from ssa_h h left join ssa_a a on h.sid = a.k where h.v > 0 union all select h.id, a.id from ssa_b b join ssa_h h on b.k = h.id left join ssa_a a on h.sid = a.k;

# two aggregations of the same input and key with different filters

statement ok
create materialized view ssa_agg_filters_off as select a.id, coalesce(x.s, 0) as s, y.c from ssa_a a left join (select sid, sum(v) as s from ssa_h where v is not null group by sid) x on a.k = x.sid left join (select sid, count(*) as c from ssa_h where v is not null and st = 'x' group by sid) y on a.k = y.sid;

# two aggregations without group key with different filters

