# Differential test of `streaming_share_identical_subplans` and
# `streaming_merge_stacked_aggregations`: every query is materialized twice, with and without the
# late sharing of identical sub-plans and the merge of stacked aggregations, and both materialized
# views must hold the same rows, and the rows of the query, after the backfill and after each round
# of changes.
#
# A streaming `sum` returns 0 where the query returns NULL once all the non-NULL values of its
# group are retracted while the group still holds rows: such sums are wrapped in `coalesce(.., 0)`.
#
# Generated by `python3 e2e_test/streaming/share_and_stacked_aggs.gen.py <this file>`: edit the
# list of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table ssa_t (id int primary key, g int, w int, v int, n numeric, big bigint, flag boolean);

statement ok
create table ssa_s (id int primary key, g int, v int);

statement ok
create table ssa_a (id int primary key, k int, x int);

statement ok
create table ssa_h (id int primary key, sid int, st varchar, v int);

statement ok
create table ssa_b (id int primary key, k int, y int);

statement ok
create view ssa_v1 as select a.id, a.k, h.v from ssa_a a join ssa_h h on a.k = h.sid;

statement ok
create view ssa_g1 as select sid, count(*) as c, max(v) as m from ssa_h group by sid;

# Rows present before the materialized views are created: they go through the backfill.
# Duplicated (g, v) pairs, NULL group keys and NULL values.

