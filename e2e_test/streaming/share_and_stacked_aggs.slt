# After the backfill: with and without the variables, every materialized view holds the same rows.

query III
select
  (select count(*) from (select * from ssa_share_join_on except select * from ssa_share_join_off) x),
  (select count(*) from (select * from ssa_share_join_off except select * from ssa_share_join_on) y),
  (select count(*) from ssa_share_join_on) - (select count(*) from ssa_share_join_off);
----
0 0 0

