# Second round of changes: rows move between groups, values become NULL, and the last rows
# of some groups are deleted.

statement ok
update ssa_t set g = 2 where id in (1, 3);

statement ok
update ssa_t set w = 5 where id = 6;

statement ok
update ssa_t set v = null, n = null, big = null where id in (2, 11);

statement ok
update ssa_t set flag = null where id in (5, 8);

statement ok
delete from ssa_t where id in (12, 14, 15);

statement ok
update ssa_t set g = null where id = 17;

statement ok
delete from ssa_s where id in (4, 5);

statement ok
update ssa_s set g = 2 where id = 1;

statement ok
update ssa_a set k = 1 where id = 3;

statement ok
delete from ssa_a where id = 5;

statement ok
delete from ssa_h where id in (14, 17);

statement ok
update ssa_h set sid = 6 where id = 13;

statement ok
update ssa_h set v = -1 where id in (10, 30);

statement ok
update ssa_h set st = 'x' where id = 11;

statement ok
delete from ssa_b where id = 2;

