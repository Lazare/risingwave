statement ok
set streaming_narrow_value_aggregates = false;

statement ok
create materialized view nvg_join_topn_union_off as select d.u, vu.doc->'a'->>'b' as x from nvg_vu vu join nvg_d d on vu.k = d.u where d.state = 'open';

statement ok
create materialized view nvg_fields_off as select k, doc->>'c' as c, doc->'a'->>'b' as b, (doc->>'n')::int as n from nvg_vu;

statement ok
create materialized view nvg_ordered_by_field_off as select distinct on (k) k, doc->>'c' as c from nvg_vab order by k, doc->>'o', ts;

statement ok
create materialized view nvg_top_n_off as select k, doc->>'c' as c from nvg_vab order by ts desc limit 3;

statement ok
create materialized view nvg_dedup_off as select distinct on (k) k, doc->>'c' as c from nvg_va;

statement ok
create materialized view nvg_window_rn_off as select k, c from (select k, doc->>'c' as c, row_number() over (partition by k order by ts desc) as rn from nvg_vab) s where rn = 1;

statement ok
create materialized view nvg_window_count_off as select k, doc->>'c' as c, count(*) over (partition by k) as n from nvg_vab;

statement ok
create materialized view nvg_window_reads_value_off as select k, doc->>'c' as c, first_value(doc) over (partition by k order by ts) ->> 'c' as f from nvg_vab;

statement ok
