# Differential test of `streaming_narrow_value_aggregates` through the operators that pass their
# rows through: every query is materialized twice, with and without the variable, and both
# materialized views must hold the rows of the batch query, with the same multiplicities, after the
# backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/narrow_value_group_ops.gen.py <this file>`: edit the
# queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table nvg_ea (id int primary key, k int, ts bigint, doc jsonb);

statement ok
create table nvg_eb (id int primary key, k int, ts bigint, doc jsonb);

statement ok
create table nvg_d (u int primary key, state varchar, w int);

statement ok
create view nvg_va as select k, last_value(doc order by ts) as doc, max(ts) as ts from nvg_ea group by k;

statement ok
create view nvg_vb as select k, last_value(doc order by ts) as doc, max(ts) as ts from nvg_eb group by k;

statement ok
create view nvg_vab as select * from nvg_va union all select * from nvg_vb;

statement ok
create view nvg_vu as select distinct on (k) * from nvg_vab order by k, ts desc;

# The first rows, present before the queries run (the backfill): several rows per key, a NULL
# key, keys only in one of the event tables, a NULL value, fields that a cast can not read in rows
# that are not the last ones. The order keys `ts` are unique over both event tables.

