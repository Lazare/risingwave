SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table ssil_t (id int primary key, a varchar, b varchar, c int, d int, n numeric);

statement ok
create table ssil_r (id int primary key, k varchar, v int);

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into ssil_t values (1, 'x', null, 1, 2, 1.0), (2, null, 'y', 2, 1, 1.00), (3, 'y', 'x', 3, null, 3), (4, 'Y', null, null, 3, null), (5, null, null, 1, 0, 2.0), (6, 'z', 'z', 2, 2, 2), (7, 'x', 'x', 4, 1, 1);

statement ok
insert into ssil_r values (1, 'x', 1), (2, 'y', 2), (3, 'z', 3), (4, null, 1), (5, 'y', null);

statement ok
set streaming_simplify_in_lists_and_coalesce = false;

statement ok
create materialized view ssil_one_common_off as select id from ssil_t where c in (1, 2) and c in (1, 3, 4);

statement ok
create materialized view ssil_two_common_off as select id from ssil_t where a in ('x', 'y', 'z') and a in ('w', 'z', 'y');

statement ok
create materialized view ssil_equality_off as select id from ssil_t where c = 2 and c in (1, 2) and d > 0;

statement ok
create materialized view ssil_null_item_off as select id from ssil_t where c in (1, null) and c in (1, 2);

statement ok
create materialized view ssil_expression_off as select id from ssil_t where upper(a) in ('X', 'Y') and upper(a) in ('Y', 'Z');

statement ok
create materialized view ssil_empty_off as select id from ssil_t where upper(a) in ('X', 'Y') and upper(a) in ('Z');

statement ok
create materialized view ssil_empty_join_off as select count(*) as n from ssil_t t join ssil_r r on t.c = r.v where t.c in (1, 2) and t.c in (3);

statement ok
create materialized view ssil_join_condition_off as select t.id, r.k from ssil_t t left join ssil_r r on t.c = r.v and r.k in ('x', 'y') and r.k in ('y', 'z');

statement ok
create materialized view ssil_coalesce_project_off as select coalesce(a, a, b, a) as x, coalesce(c, c) as y from ssil_t;

statement ok
create materialized view ssil_coalesce_filter_off as select id from ssil_t where coalesce(a, b, a, b) = 'x';

statement ok
create materialized view ssil_coalesce_group_off as select coalesce(b, b, a) as x, count(*) as n from ssil_t group by coalesce(b, b, a);

statement ok
create materialized view ssil_kept_different_columns_off as select id from ssil_t where c in (1, 2) and d in (2, 3);

statement ok
create materialized view ssil_kept_or_off as select id from ssil_t where c in (1, 2) or c in (2, 3);

statement ok
create materialized view ssil_kept_numeric_off as select id from ssil_t where n in (1.0, 2.0) and n in (1.00, 3.0);

statement ok
create materialized view ssil_kept_not_in_off as select id from ssil_t where c not in (1, 2) and c in (2, 3);

