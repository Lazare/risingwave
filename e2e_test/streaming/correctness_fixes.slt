# Expected results of the corrections of wrong results of the optimizer in streaming jobs (see
# `docs/fork/corrections/`), after the backfill and after each change of the data. Every expected
# result is computed by hand with the semantics of PostgreSQL.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table cfs_a (id int primary key, x int, k int);

statement ok
create table cfs_b (id int primary key, y int, k int);

statement ok
create table cfs_c (id int primary key, y int, k int);

statement ok
create materialized view cfs_m1 as select id from cfs_a where x not in (select y from cfs_b);

statement ok
create materialized view cfs_m2 as select id from cfs_a where x not in (select y from cfs_c where cfs_c.k = cfs_a.k);

statement ok
create materialized view cfs_m3 as select id, x from cfs_a where x + 1 not in (select y from cfs_b where k > 0) and k < 3;

statement ok
create materialized view cfs_m4 as select id from cfs_a where x not in (select y from cfs_b) and k not in (select k from cfs_c where cfs_c.id = cfs_a.id);

statement ok
create materialized view cfs_m5 as select id from cfs_a where exists (select max(y) from cfs_c where cfs_c.k = cfs_a.k);

statement ok
create materialized view cfs_m6 as select id from cfs_a where not exists (select max(y) from cfs_c where cfs_c.k = cfs_a.k);

# A correlated NOT IN without equality keeps the anti join on `=` in streaming jobs (with a
# notice), unless asked to be exact, which is not plannable.
statement ok
create materialized view cfs_m7 as select id from cfs_a where x not in (select y from cfs_c where cfs_c.k > cfs_a.k);

statement ok
set streaming_exact_not_in_without_equality = true;

statement error nested-loop
create materialized view cfs_m8 as select id from cfs_a where x not in (select y from cfs_c where cfs_c.k > cfs_a.k);

statement ok
set streaming_exact_not_in_without_equality = false;

statement ok
insert into cfs_a values (1, 1, 1), (2, 2, 1), (3, null, 1), (4, 3, 2), (5, 3, 2), (6, null, 3), (7, 5, null);

# Empty subqueries: every row.
query I rowsort
select id from cfs_m1;
----
1
2
3
4
5
6
7

query I rowsort
select id from cfs_m2;
----
1
2
3
4
5
6
7

query II rowsort
select id, x from cfs_m3;
----
1 1
2 2
3 NULL
4 3
5 3

query I rowsort
select id from cfs_m4;
----
1
2
3
4
5
6
7

query I rowsort
select id from cfs_m5;
----
1
2
3
4
5
6
7

query I rowsort
select id from cfs_m6;
----

statement ok
insert into cfs_b values (1, 1, 1), (2, 1, 1), (3, 4, 9);

statement ok
insert into cfs_c values (1, 1, 1), (2, 1, 1), (3, null, 2), (4, 9, 4);

# cfs_b.y = {1, 1, 4}; cfs_c by k: 1 -> {1, 1}, 2 -> {NULL}, 4 -> {9}; by id: 1, 2 -> k 1, 3 -> k 2, 4 -> k 4.
query I rowsort
select id from cfs_m1;
----
2
4
5
7

query I rowsort
select id from cfs_m2;
----
2
6
7

query II rowsort
select id, x from cfs_m3;
----
