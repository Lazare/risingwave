# Differential test of the merge of repeated lookups nested in trees of joins
# (`streaming_merge_repeated_lookups`): every query is materialized twice, with and without the
# variable, and both materialized views must hold the same rows, and the rows of the query, after
# the backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/merge_lookups_flat.gen.py <this file>`: edit the list of
# queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table mlf_f (id int primary key, dim_id int, other_id int, amt int);

statement ok
create table mlf_d (id int primary key, name varchar, grp int, active boolean);

statement ok
create table mlf_e (id int primary key, code varchar);

statement ok
create table mlf_g (id int primary key, a int);

statement ok
create table mlf_s (sid int primary key, id int, ts int);

statement ok
create table mlf_h (rid int primary key, id int, x int);

statement ok
create view mlf_sd as select s.sid, s.id, s.ts, d.name, d.active from mlf_s s join mlf_d d on s.id = d.id;

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into mlf_d values (1, 'a', 1, true), (2, 'b', 2, false), (3, 'c', null, true), (4, null, 3, null), (5, 'e', 1, true), (6, 'f', 2, false);

statement ok
insert into mlf_f values (10, 1, 2, 5), (11, 2, null, 6), (12, 3, 3, 7), (13, null, 1, 8), (14, 9, 9, 9), (15, 1, 4, null), (16, 4, 1, 1), (17, 6, 6, 2);

statement ok
insert into mlf_e values (1, 'x'), (2, 'y'), (3, null);

statement ok
insert into mlf_g values (1, 10), (2, null), (3, 30), (5, 50);

statement ok
insert into mlf_s values (20, 1, 100), (21, 1, 101), (22, 2, 102), (23, null, 103), (24, 4, 104), (25, 9, 105), (26, 6, 106);

statement ok
insert into mlf_h values (30, 1, 1), (31, 1, -1), (32, 2, 0), (33, 3, null), (34, null, 5), (35, 6, 2), (36, 4, 4);

statement ok
set streaming_merge_repeated_lookups = false;

# nested inner lookup, the equality comes from the join above

statement ok
create materialized view mlf_inner_ancestor_off as select f.id as fid, d.grp, x.sid, x.ts, x.name from mlf_f f join mlf_d d on f.dim_id = d.id join mlf_sd x on d.id = x.id;

# nested inner lookup, the equality comes from a sibling join

statement ok
create materialized view mlf_inner_sibling_off as select f.id as fid, d.grp, d2.name, s.sid, s.ts from mlf_f f join mlf_d d on f.dim_id = d.id join mlf_s s on s.id = f.dim_id join mlf_d d2 on d2.id = s.id;

# nested inner lookup with a filter on the removed side

statement ok
create materialized view mlf_inner_filter_off as select f.id as fid, d.grp, x.sid, x.ts, x.name from mlf_f f join mlf_d d on f.dim_id = d.id join mlf_sd x on d.id = x.id where x.active;

# two left-joined copies of a table joined on its key

statement ok
create materialized view mlf_two_left_copies_off as select d.id as did, e.code, g.a, d2.name from mlf_d d left join mlf_e e on d.grp = e.id join (mlf_d d2 left join mlf_g g on d2.grp = g.id) on d.id = d2.id;

# left join of a chain that looks up the row of the left side

statement ok
create materialized view mlf_left_chain_off as select f.id as fid, d.name, r.sid, r.v, r.a from mlf_f f join mlf_d d on f.dim_id = d.id left join (select d2.id, s.sid, case when d2.active then 0 else coalesce(g.a, d2.grp) end as v, g.a from mlf_d d2 join mlf_s s on d2.id = s.id left join mlf_g g on d2.id = g.id) r on d.id = r.id;

# left join of a filtered and left-joined copy of the table of the left side

statement ok
create materialized view mlf_left_copy_off as select f.id as fid, r.name, r.code, r.one from mlf_f f left join mlf_d d on f.dim_id = d.id left join (select d2.id, d2.name, e.code, 1 as one from mlf_d d2 left join mlf_e e on d2.grp = e.id where d2.active) r on d.id = r.id;

# left join of a chain whose joins all compare the removed lookup

statement ok
create materialized view mlf_left_through_lookup_off as select f.id as fid, d.name, y.sid, y.z from mlf_f f join mlf_d d on f.dim_id = d.id left join (select g.id, s.sid, g.a + d2.grp as z from mlf_g g join mlf_d d2 on g.id = d2.id join mlf_s s on d2.id = s.id) y on d.id = y.id;

# not exists on a chain that looks up the row of the left side

statement ok
create materialized view mlf_anti_chain_off as select f.id as fid from mlf_f f join mlf_d d on f.dim_id = d.id where d.grp < 10 and not exists (select 1 from mlf_s s join mlf_d d2 on s.id = d2.id and d2.active left join mlf_e e on s.id = e.id where s.id = f.dim_id);

# exists on a chain that looks up the row of the left side

statement ok
create materialized view mlf_semi_chain_off as select f.id as fid, d.name from mlf_f f left join mlf_d d on f.dim_id = d.id where exists (select 1 from mlf_s s join mlf_d d2 on s.id = d2.id where s.id = d.id and d2.grp > 1);

# not exists on a chain whose rows the left side all carries

statement ok
create materialized view mlf_anti_carried_off as select f.id as fid, h.rid from mlf_f f join mlf_d d on f.dim_id = d.id join mlf_h h on h.id = d.id where not exists (select 1 from mlf_h h2 join mlf_d d2 on h2.id = d2.id and d2.active left join mlf_e e on h2.id = e.id where h2.id = f.dim_id);

# exists on a column that is not a key, carried by the left side

statement ok
create materialized view mlf_semi_witness_off as select f.id as fid, h.rid, h.x from mlf_f f join mlf_h h on f.dim_id = h.id where exists (select 1 from mlf_h h2 where h2.id = f.dim_id);

# not exists on a column that is not a key, carried by the padded side

statement ok
create materialized view mlf_anti_witness_padded_off as select f.id as fid, h.rid, h.x from mlf_f f left join mlf_h h on f.other_id = h.id where not exists (select 1 from mlf_h h2 where h2.id = h.id);

# exists with a filter that the carried row may fail

statement ok
create materialized view mlf_kept_witness_filter_off as select f.id as fid, h.rid from mlf_f f join mlf_h h on f.dim_id = h.id where exists (select 1 from mlf_h h2 where h2.id = f.dim_id and h2.x > 0);

# not exists on a column that the outer join compares but does not bind

statement ok
create materialized view mlf_kept_anti_unbound_off as select f.id as fid, h.rid from mlf_f f left join mlf_h h on f.other_id = h.id where not exists (select 1 from mlf_h h2 where h2.id = f.other_id);

# nested lookup compared on a column that is not its key

statement ok
create materialized view mlf_kept_nonkey_off as select f.id as fid, d.grp, x.sid, x.name from mlf_f f join mlf_d d on f.dim_id = d.id join (select s.sid, s.id, d2.name from mlf_s s join mlf_d d2 on s.id = d2.grp) x on d.id = x.id;

# nested lookup in the padded side of a left join of the tree

statement ok
create materialized view mlf_kept_padded_off as select f.id as fid, d.grp, x.sid, x.name from mlf_f f join mlf_d d on f.dim_id = d.id join (select s.sid, s.id, d2.name from mlf_s s left join mlf_d d2 on s.id = d2.id) x on d.id = x.id;

# left join whose condition tests a column of a left join of its right side

statement ok
create materialized view mlf_kept_ext_cond_off as select f.id as fid, r.name, r.code from mlf_f f left join mlf_d d on f.dim_id = d.id left join (select d2.id, d2.name, e.code from mlf_d d2 left join mlf_e e on d2.grp = e.id) r on d.id = r.id and r.code = 'x';

