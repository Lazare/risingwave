create materialized view tp_inner_view_off as select o.id, s.sid from tp_eu o join tp_s s on s.region = o.region and s.order_id = o.id;

statement ok
create materialized view tp_pk_range_off as select o.id, s2.x from tp_eu o join tp_s2 s2 on s2.region = o.region and s2.order_id = o.id;

statement ok
create materialized view tp_only_keys_off as select o.id, s.sid, s.w from (select * from tp_o where amount > 5 and id > 10 and amount + id < 100) o join tp_s s on s.order_id = o.id;

statement ok
create materialized view tp_chain_off as select o.id, s.sid, c.id as cid, c.note from tp_eu o join tp_s s on s.order_id = o.id join tp_c c on c.order_id = s.order_id;

