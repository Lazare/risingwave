create table tp_o (id int primary key, region varchar, amount int, k numeric, f float8);

statement ok
create table tp_s (sid int primary key, order_id int, region varchar, w int, k numeric, f float8);

statement ok
create table tp_s2 (region varchar, order_id int, x int, primary key (region, order_id));

statement ok
create table tp_c (id int primary key, order_id int, note varchar);

statement ok
create table tp_h (id int primary key, ts timestamptz, v int);

statement ok
create table tp_hs (id int primary key, ts timestamptz, w int);

statement ok
create view tp_eu as select * from tp_o where region = 'EU' and id > 10;

# Rows present before the materialized views are created: they go through the backfill.
