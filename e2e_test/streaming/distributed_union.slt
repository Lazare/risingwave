# Differential test of `streaming_distributed_union`: every query is materialized twice, with and
# without the inputs of its union shuffled directly by the key of the operator above, and both
# materialized views must hold the same rows (also equal to the batch query) after the backfill
# and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/distributed_union.gen.py <this file>`: edit the list
# of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table sdu_a (id int primary key, k int, v int);

statement ok
create table sdu_b (id int primary key, k int, v int);

statement ok
create table sdu_c (k int, v int);

statement ok
create table sdu_d (id int primary key, w int);

statement ok
create table sdu_e (id int primary key, k int, x int);

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into sdu_a values (1, 1, 5), (2, 1, -3), (3, 2, 0), (4, null, null), (5, 3, 7), (6, 2, 2);

statement ok
insert into sdu_b values (1, 2, 4), (3, 1, 1), (7, 3, null), (8, null, -1), (9, 1, 9);

statement ok
insert into sdu_c values (1, 10), (1, 11), (2, null), (null, 3), (4, 4), (4, 4);

statement ok
insert into sdu_d values (1, 100), (2, 200), (3, 300), (4, null), (7, 700), (10, 1000);

statement ok
insert into sdu_e values (1, 1, 11), (2, 3, null), (5, 9, 55), (11, null, 1), (12, 7, 12);

statement ok
set streaming_distributed_union = false;

# hash aggregation over a union on its key

statement ok
create materialized view sdu_agg_off as select id, count(*) as cnt, coalesce(sum(v), 0) as s from (select id, v from sdu_a union all select id, v from sdu_b) u group by id;

# hash aggregation over a union of three branches on its key

statement ok
create materialized view sdu_agg3_off as select id, max(v) as mx, count(v) as cv from (select id, v from sdu_a union all select id, v from sdu_b union all select id, x as v from sdu_e) u group by id;

# hash aggregation with a projection between it and the union

statement ok
create materialized view sdu_agg_proj_off as select id, count(*) as cnt, coalesce(sum(w), 0) as s from (select id, v + 1 as w from (select id, v from sdu_a union all select id, v from sdu_b) u) x group by id;

# union distinct of keys

statement ok
create materialized view sdu_union_distinct_off as select id from sdu_a union select id from sdu_b;

# hash aggregation over a union of aggregations on their group key

statement ok
create materialized view sdu_agg_of_aggs_off as select k, sum(cnt) as cnt from (select k, count(*) as cnt from sdu_c group by k union all select k, count(*) as cnt from sdu_b group by k) u group by k;

# branches that filter the same table: updates move rows between branches

statement ok
create materialized view sdu_split_off as select id, count(*) as cnt, coalesce(sum(v), 0) as s, min(src) as ms from (select id, v, 1 as src from sdu_a where v > 0 union all select id, v, 2 as src from sdu_a where v <= 0 union all select id, v, 3 as src from sdu_b) u group by id;

# group top-n over a union on its key

statement ok
create materialized view sdu_topn_off as select id, v, src from (select id, v, src, row_number() over (partition by id order by v, src) as rn from (select id, v, 1 as src from sdu_a union all select id, v, 2 as src from sdu_b) u) x where rn <= 1;

# distinct on over a union on its key

statement ok
create materialized view sdu_distinct_on_off as select * from (select distinct on (id) id, v, src from (select id, v, 1 as src from sdu_a union all select id, v, 2 as src from sdu_b) u order by id, v desc, src) x;

# over window over a union on its key

statement ok
create materialized view sdu_over_window_off as select id, v, src, sum(coalesce(v, 0)) over (partition by id order by v, src) as sv, row_number() over (partition by id order by src) as rn from (select id, v, 1 as src from sdu_a union all select id, v, 2 as src from sdu_b) u;

# hash join with the union on the left

statement ok
create materialized view sdu_join_left_off as select u.id, u.v, d.w from (select id, v from sdu_a union all select id, v from sdu_b) u join sdu_d d on u.id = d.id;

# hash join with the union on the right

statement ok
create materialized view sdu_join_right_off as select d.id, d.w, u.v from sdu_d d join (select id, v from sdu_a union all select id, v from sdu_b) u on d.id = u.id;

# left join of a table with a union on a non-key column of the table

statement ok
create materialized view sdu_left_join_off as select e.id, e.x, u.v from sdu_e e left join (select id, v from sdu_a union all select id, v from sdu_b) u on e.k = u.id;

# hash join of two unions on their keys

statement ok
create materialized view sdu_join_unions_off as select u1.id, u1.v, u2.v as v2 from (select id, v from sdu_a union all select id, v from sdu_b) u1 join (select id, x as v from sdu_e union all select id, w as v from sdu_d) u2 on u1.id = u2.id;

