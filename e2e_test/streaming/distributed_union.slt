# Second round: updates move rows between branches (sign of v), change grouped columns (the
# key of the aggregation branches), and keys change by a delete and an insert.

statement ok
update sdu_a set v = -v where id in (1, 2, 5);

statement ok
update sdu_a set v = 0 where id = 6;

statement ok
update sdu_a set v = 4, k = 1 where id = 4;

statement ok
update sdu_a set v = null where id = 7;

statement ok
update sdu_b set k = 3 where id in (1, 9);

statement ok
update sdu_b set k = null, v = 5 where id = 7;

statement ok
update sdu_c set k = 2 where k = 1 and v = 10;

statement ok
update sdu_c set k = null where k = 4;

statement ok
update sdu_c set k = 5 where k is null and v = 3;

statement ok
update sdu_d set w = w + 1 where id in (1, 3);

statement ok
update sdu_d set w = null where id = 2;

statement ok
update sdu_e set k = 2, x = 22 where id = 1;

statement ok
update sdu_e set k = 1 where id = 11;

statement ok
delete from sdu_a where id = 3;

statement ok
insert into sdu_a values (13, 2, 0);

statement ok
delete from sdu_b where id = 8;

statement ok
insert into sdu_b values (13, null, -1);

statement ok
delete from sdu_d where id = 7;

statement ok
insert into sdu_d values (13, 1300);

