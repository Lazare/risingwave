# Differential test of `streaming_merge_repeated_lookups`: every query is materialized twice,
# with and without the merge of its repeated lookups, and both materialized views must hold the
# same rows after the backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/merge_repeated_lookups.gen.py <this file>`: edit the
# list of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table mrl_f (id int primary key, dim_id int, other_id int, amt int, label varchar);

statement ok
create table mrl_d (id int primary key, name varchar, grp int, active boolean);

statement ok
create table mrl_e (id int primary key, code varchar);

statement ok
create table mrl_p (a int, b int, v int, w int, primary key (a, b));

statement ok
create table mrl_g (id int primary key, a int, b int);

statement ok
create view mrl_da as select * from mrl_d where active;

statement ok
create materialized view mrl_dm as select grp as id, count(*) as cnt, max(name) as top from mrl_d group by grp;

statement ok
create view mrl_v1 as select f.id, f.dim_id, f.amt, d.name from mrl_f f left join mrl_d d on f.dim_id = d.id;

statement ok
create view mrl_v2 as select v.*, d.grp from mrl_v1 v left join mrl_d d on v.dim_id = d.id;

statement ok
create view mrl_w1 as select f.id, f.dim_id, f.amt, d.name, d.id as did from mrl_f f join mrl_d d on f.dim_id = d.id;

statement ok
create view mrl_w2 as select w.*, d.grp from mrl_w1 w join mrl_d d on w.did = d.id;

