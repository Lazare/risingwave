# First round of changes: new rows, lookups that start to match.

statement ok
insert into mrl_d values (99, 'far', 1, true), (8, 'eight', 2, false), (9, 'nine', 4, true);

statement ok
insert into mrl_e values (2, 'b'), (9, 'i');

statement ok
insert into mrl_f values (20, 8, 2, 7, 'r'), (21, 9, 9, 0, null), (22, 1, 5, 9, 'q'), (23, 100, 100, 1, 'p');

statement ok
insert into mrl_p values (2, 2, 40, 500), (3, 1, 50, 600);

statement ok
insert into mrl_g values (8, 3, 1), (9, 3, 3), (10, 4, 4);

# A row written again with an existing primary key replaces the previous one.

statement ok
insert into mrl_d values (3, 'trois', 1, false);

statement ok
insert into mrl_f values (10, 2, 3, 6, 'x2');

