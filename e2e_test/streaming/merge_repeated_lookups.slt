statement ok
create materialized view mrl_filtered_inner_after_left_on as select f.id as fid, a.name as an, b.grp as bg from mrl_f f left join mrl_d a on f.dim_id = a.id join mrl_da b on f.dim_id = b.id;

# self join of a table on its key

statement ok
create materialized view mrl_self_join_on as select a.id as aid, a.name as an, b.grp as bg from mrl_d a join mrl_d b on a.id = b.id;

# self left join of a table on its key with a filter

statement ok
create materialized view mrl_self_left_filter_on as select a.id as aid, a.name as an, b.grp as bg from mrl_d a left join mrl_da b on a.id = b.id;

# lookup through another table in between

statement ok
create materialized view mrl_in_between_on as select f.id as fid, a.name as an, e.code as ec, b.grp as bg from mrl_f f join mrl_d a on f.dim_id = a.id join mrl_e e on f.other_id = e.id join mrl_d b on f.dim_id = b.id;

# left lookups of two tables, each twice

statement ok
create materialized view mrl_in_between_left_on as select f.id as fid, a.name as an, e.code as ec, b.grp as bg, e2.code as ec2 from mrl_f f left join mrl_d a on f.dim_id = a.id left join mrl_e e on f.other_id = e.id left join mrl_d b on f.dim_id = b.id left join mrl_e e2 on f.other_id = e2.id;

# inner lookups on a composite key

statement ok
create materialized view mrl_inner_composite_on as select g.id as gid, x.v as xv, y.w as yw from mrl_g g join mrl_p x on g.a = x.a and g.b = x.b join mrl_p y on g.a = y.a and g.b = y.b;

# lookup on a composite key from the columns of both sides of the first one

statement ok
create materialized view mrl_mixed_composite_on as select g.id as gid, x.v as xv, y.w as yw from mrl_g g join mrl_p x on g.a = x.a and g.b = x.b left join mrl_p y on x.a = y.a and g.b = y.b;

# left lookup on a composite key from the columns of both sides of a left one

statement ok
create materialized view mrl_mixed_composite_left_on as select g.id as gid, x.v as xv, y.w as yw from mrl_g g left join mrl_p x on g.a = x.a and g.b = x.b left join mrl_p y on x.a = y.a and g.b = y.b;

# lookups on the optional side of an outer join

statement ok
create materialized view mrl_nullable_side_on as select e.id as eid, y.fid as fid, y.an as an, y.bg as bg from mrl_e e left join (select f.id as fid, f.other_id as oid, a.name as an, b.grp as bg from mrl_f f left join mrl_d a on f.dim_id = a.id left join mrl_d b on f.dim_id = b.id) y on e.id = y.oid;

# inner lookups on the optional side of an outer join

statement ok
create materialized view mrl_nullable_inner_on as select f.id as fid, x.an as an, x.bg as bg from mrl_f f left join (select a.id as id, a.name as an, b.grp as bg from mrl_d a join mrl_da b on a.id = b.id) x on f.dim_id = x.id;

# lookup from the key of the optional side of an outer join

statement ok
create materialized view mrl_lookup_of_nullable_on as select e.id as eid, y.fid as fid, y.an as an, b.grp as bg from mrl_e e left join (select f.id as fid, f.other_id as oid, f.dim_id as did, a.id as aid, a.name as an from mrl_f f join mrl_d a on f.dim_id = a.id) y on e.id = y.oid left join mrl_d b on y.aid = b.id;

# lookup from the foreign key of the optional side of an outer join

statement ok
create materialized view mrl_lookup_of_nullable_fk_on as select e.id as eid, y.fid as fid, y.an as an, b.grp as bg from mrl_e e left join (select f.id as fid, f.other_id as oid, f.dim_id as did, a.name as an from mrl_f f left join mrl_d a on f.dim_id = a.id) y on e.id = y.oid left join mrl_da b on y.did = b.id;

# filter between two left lookups

statement ok
create materialized view mrl_filter_between_on as select x.id as fid, x.an as an, b.grp as bg from (select f.id, f.dim_id, a.name as an from mrl_f f left join mrl_d a on f.dim_id = a.id where a.name is not null or f.amt > 3) x left join mrl_d b on x.dim_id = b.id;

# semi join between two lookups

statement ok
create materialized view mrl_semi_between_on as select f.id as fid, a.name as an, b.grp as bg from mrl_f f join mrl_d a on f.dim_id = a.id join mrl_d b on f.dim_id = b.id where f.other_id in (select id from mrl_e);

# anti join between two left lookups

statement ok
create materialized view mrl_anti_between_on as select f.id as fid, a.name as an, b.grp as bg from mrl_f f left join mrl_d a on f.dim_id = a.id left join mrl_da b on f.dim_id = b.id where not exists (select 1 from mrl_e e where e.id = f.other_id);

# aggregation above two left lookups

statement ok
create materialized view mrl_agg_above_on as select b.grp as bg, count(*) as cnt, sum(f.amt) as total, max(a.name) as an from mrl_f f left join mrl_d a on f.dim_id = a.id left join mrl_d b on f.dim_id = b.id group by b.grp;

# lookup written on the left side of the join

statement ok
create materialized view mrl_lookup_left_side_on as select a.grp as ag, x.fid as fid, x.bn as bn from mrl_d a join (select f.id as fid, f.dim_id as did, b.name as bn from mrl_f f join mrl_d b on f.dim_id = b.id) x on a.id = x.did;

# two inner lookups of the same column

statement ok
create materialized view mrl_same_column_inner_on as select f.id as fid, a.name as an, b.name as bn from mrl_f f join mrl_d a on f.dim_id = a.id join mrl_d b on f.dim_id = b.id;

# lookups of the same columns with an outer join in between

statement ok
create materialized view mrl_same_column_between_on as select f.id as fid, a.name as an, e.code as ec, b.name as bn, b.id as bid from mrl_f f join mrl_d a on f.dim_id = a.id left join mrl_e e on f.other_id = e.id left join mrl_d b on f.dim_id = b.id;

# left lookups of the same columns with an outer join in between

statement ok
create materialized view mrl_same_column_left_on as select f.id as fid, a.name as an, a.id as aid, e.code as ec, b.name as bn, b.id as bid from mrl_f f left join mrl_d a on f.dim_id = a.id left join mrl_e e on f.other_id = e.id left join mrl_d b on f.dim_id = b.id;

# exists on the same table with a filter

statement ok
create materialized view mrl_exists_self_on as select a.id as aid, a.name as an from mrl_d a where exists (select 1 from mrl_da b where b.id = a.id);

# not exists on the same table with a filter

statement ok
create materialized view mrl_not_exists_self_on as select a.id as aid, a.name as an from mrl_d a where not exists (select 1 from mrl_da b where b.id = a.id);

# not exists on the same table with a filter that can be NULL

statement ok
create materialized view mrl_not_exists_self_null_filter_on as select a.id as aid, a.name as an from mrl_d a where not exists (select 1 from mrl_d b where b.id = a.id and b.grp > 1);

# not exists on the same table without filter

statement ok
create materialized view mrl_not_exists_plain_on as select a.id as aid, a.cnt as ac from mrl_dm a where not exists (select 1 from mrl_dm b where b.id = a.id);

# not exists on a table that an inner lookup already reads

statement ok
create materialized view mrl_not_exists_inner_on as select f.id as fid, a.name as an from mrl_f f join mrl_d a on f.dim_id = a.id where not exists (select 1 from mrl_d b where b.id = f.dim_id and b.grp = 2);

# not exists on a table that a left lookup already reads

statement ok
create materialized view mrl_not_exists_left_on as select f.id as fid, a.name as an from mrl_f f left join mrl_d a on f.dim_id = a.id where not exists (select 1 from mrl_da b where b.id = f.dim_id);

# exists on a table that a left lookup already reads

statement ok
create materialized view mrl_exists_left_on as select f.id as fid, a.name as an from mrl_f f left join mrl_d a on f.dim_id = a.id where exists (select 1 from mrl_da b where b.id = f.dim_id and b.grp < f.amt);

# lookup of a row that an aggregation grouped by its key already read

statement ok
create materialized view mrl_above_agg_on as select t.dim_id as did, t.total as total, b.grp as bg from (select f.dim_id, sum(f.amt) as total from mrl_f f join mrl_d a on f.dim_id = a.id group by f.dim_id) t left join mrl_d b on t.dim_id = b.id;

# lookup above an aggregation grouped by the key and another column

statement ok
create materialized view mrl_above_agg_two_on as select t.dim_id as did, t.label as label, t.total as total, b.grp as bg, b.name as bn from (select f.dim_id, f.label, sum(f.amt) as total from mrl_f f join mrl_d a on f.dim_id = a.id where a.active group by f.dim_id, f.label) t join mrl_d b on t.dim_id = b.id;

# left lookup above an aggregation over a left lookup of the same row

statement ok
create materialized view mrl_above_agg_left_on as select t.dim_id as did, t.n as n, t.total as total, b.grp as bg from (select f.dim_id, max(a.name) as n, sum(f.amt) as total from mrl_f f left join mrl_d a on f.dim_id = a.id group by f.dim_id) t left join mrl_d b on t.dim_id = b.id;

# filtered left lookup above an aggregation over a filtered left lookup

statement ok
create materialized view mrl_above_agg_left_filter_on as select t.dim_id as did, t.n as n, t.cnt as cnt, b.grp as bg from (select f.dim_id, max(a.name) as n, count(*) as cnt from mrl_f f left join mrl_da a on f.dim_id = a.id group by f.dim_id) t left join (select * from mrl_d where grp = 2) b on t.dim_id = b.id;

# kept: lookup above an aggregation that is not grouped by the key

statement ok
create materialized view mrl_above_agg_kept_on as select t.label as label, t.dim as dim, b.grp as bg from (select f.label, max(f.dim_id) as dim from mrl_f f join mrl_d a on f.dim_id = a.id group by f.label) t left join mrl_d b on t.dim = b.id;

# lookup above a top-1 per group

statement ok
create materialized view mrl_above_top1_on as select x.other_id as oid, x.name as an, b.grp as bg from (select distinct on (f.other_id) f.other_id, f.dim_id, a.name from mrl_f f join mrl_d a on f.dim_id = a.id order by f.other_id, f.id) x left join mrl_d b on x.dim_id = b.id;

# lookup above a ranking that keeps the first row of each group

statement ok
create materialized view mrl_above_rank_on as select x.other_id as oid, x.name as an, b.grp as bg from (select other_id, dim_id, name from (select f.other_id, f.dim_id, a.name, row_number() over (partition by f.other_id order by f.amt desc, f.id) as rn from mrl_f f left join mrl_d a on f.dim_id = a.id) r where rn = 1) x join mrl_d b on x.dim_id = b.id;

# lookup of a row that a shared sub-plan already outputs

statement ok
create materialized view mrl_above_share_on as with v as (select f.id, f.dim_id, f.amt, a.name, a.grp from mrl_f f join mrl_d a on f.dim_id = a.id) select x.id as xid, x.grp as g1, y.amt as yamt, b.grp as g2 from v x join v y on x.amt = y.id left join mrl_d b on x.dim_id = b.id;

# left lookups in a relation whose key can be NULL

statement ok
create materialized view mrl_null_key_left_on as select f.id as fid, a.cnt as ac, b.top as bt from mrl_f f left join mrl_dm a on f.amt = a.id left join mrl_dm b on f.amt = b.id;

# self join on a key that can be NULL

statement ok
create materialized view mrl_null_key_self_on as select a.id as aid, a.cnt as ac, b.top as bt from mrl_dm a join mrl_dm b on a.id = b.id;

# self left join on a key that can be NULL

statement ok
create materialized view mrl_null_key_self_left_on as select a.id as aid, a.cnt as ac, b.top as bt from mrl_dm a left join mrl_dm b on a.id = b.id;

# left lookup from a key that can be NULL

statement ok
create materialized view mrl_null_key_chain_on as select d.id as did, a.cnt as ac, b.top as bt from mrl_d d left join mrl_dm a on d.grp = a.id left join mrl_dm b on a.id = b.id;

# kept: lookups of two different rows

statement ok
create materialized view mrl_kept_two_rows_on as select f.id as fid, a.name as an, b.grp as bg from mrl_f f left join mrl_d a on f.dim_id = a.id left join mrl_d b on f.other_id = b.id;

# kept: lookup on a column that is not the key

statement ok
create materialized view mrl_kept_not_key_on as select f.id as fid, a.name as an, b.active as ba from mrl_f f left join mrl_d a on f.dim_id = a.grp left join mrl_d b on f.dim_id = b.grp;

# kept: lookup on a part of a composite key

statement ok
create materialized view mrl_kept_partial_on as select g.id as gid, x.v as xv, y.w as yw from mrl_g g left join mrl_p x on g.a = x.a and g.b = x.b left join mrl_p y on g.a = y.a;

# kept: lookup on a composite key from crossed columns

statement ok
create materialized view mrl_kept_crossed_on as select g.id as gid, x.v as xv, y.w as yw from mrl_g g left join mrl_p x on g.a = x.a and g.b = x.b left join mrl_p y on g.b = y.a and g.a = y.b;

# kept: the first left lookup has an extra condition

statement ok
create materialized view mrl_kept_first_cond_on as select f.id as fid, a.name as an, b.grp as bg from mrl_f f left join mrl_d a on f.dim_id = a.id and f.amt > a.grp left join mrl_d b on f.dim_id = b.id;

# kept: a column of the composite key is compared with a constant

statement ok
create materialized view mrl_kept_const_key_on as select g.id as gid, x.v as xv, y.w as yw from mrl_g g left join mrl_p x on g.a = x.a and g.b = x.b left join mrl_p y on g.a = y.a and y.b = 1;

# After the backfill: with and without the merge, every materialized view holds the same rows.

query III
select
  (select count(*) from (select * from mrl_two_left_on except select * from mrl_two_left_off) x),
  (select count(*) from (select * from mrl_two_left_off except select * from mrl_two_left_on) y),
  (select count(*) from mrl_two_left_on) - (select count(*) from mrl_two_left_off);
----
0 0 0

