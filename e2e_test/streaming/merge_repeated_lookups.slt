# two left lookups with the same filter

statement ok
create materialized view mrl_left_same_filter_on as select f.id as fid, a.name as an, b.grp as bg from mrl_f f left join mrl_da a on f.dim_id = a.id left join mrl_da b on f.dim_id = b.id;

# left lookups with filters that can be NULL

statement ok
create materialized view mrl_left_null_filter_on as select f.id as fid, a.name as an, b.grp as bg, c.name as cn from mrl_f f left join (select * from mrl_d where grp > 1) a on f.dim_id = a.id left join (select * from mrl_d where not active) b on f.dim_id = b.id left join (select * from mrl_d where name is null) c on f.dim_id = c.id;

# left lookup with an extra condition

statement ok
create materialized view mrl_left_extra_cond_on as select f.id as fid, a.name as an, b.grp as bg from mrl_f f left join mrl_d a on f.dim_id = a.id left join mrl_d b on f.dim_id = b.id and f.amt > b.grp;

# left lookup of computed columns

statement ok
create materialized view mrl_left_computed_on as select f.id as fid, a.name as an, b.label2 as bl, b.one as bo from mrl_f f left join mrl_d a on f.dim_id = a.id left join (select id, coalesce(name, 'none') as label2, 1 as one from mrl_d) b on f.dim_id = b.id;

# left lookup after a lookup of computed columns

statement ok
create materialized view mrl_left_computed_first_on as select f.id as fid, a.label2 as al, a.one as ao, b.grp as bg from mrl_f f left join (select id, coalesce(name, 'none') as label2, 1 as one from mrl_d where active) a on f.dim_id = a.id left join mrl_d b on f.dim_id = b.id;

