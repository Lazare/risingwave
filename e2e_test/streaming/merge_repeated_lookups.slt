# Second round of changes: updates and deletes, which retract rows and move them between filters.

statement ok
update mrl_d set active = not active where id in (1, 2, 8);

statement ok
update mrl_d set active = true where id = 4;

statement ok
update mrl_d set grp = 2 where id = 1;

statement ok
update mrl_d set grp = 1, name = 'cinq' where id = 5;

statement ok
update mrl_d set grp = null where id = 9;

statement ok
delete from mrl_d where id = 6;

statement ok
delete from mrl_d where id = 99;

statement ok
update mrl_f set dim_id = 3, amt = amt + 2 where id = 11;

statement ok
update mrl_f set dim_id = null where id = 15;

statement ok
update mrl_f set dim_id = 1 where id = 13;

statement ok
update mrl_f set other_id = 2 where id = 12;

statement ok
delete from mrl_f where id = 16;

statement ok
update mrl_e set code = 'cc' where id = 3;

statement ok
delete from mrl_e where id = 1;

statement ok
update mrl_p set v = v + 1, w = null where a = 1;

statement ok
delete from mrl_p where a = 2 and b = 1;

statement ok
update mrl_g set b = 2 where id = 1;

statement ok
update mrl_g set a = 3 where id = 5;

statement ok
delete from mrl_g where id = 4;

