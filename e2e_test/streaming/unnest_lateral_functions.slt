# Differential test of `streaming_unnest_lateral_functions`: every query is materialized twice,
# with and without the per-row evaluation of its subqueries over set-returning functions of the
# outer row, and both materialized views must hold the same rows, and the rows of the query, after
# the backfill and after each round of changes.
#
# Generated by `python3 e2e_test/streaming/unnest_lateral_functions.gen.py <this file>`: edit the
# list of queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table ulf_t (id int primary key, s varchar, c varchar, j jsonb, arr int[], n int);

statement ok
create table ulf_u (k int, arr int[]);

# Rows present before the materialized views are created: they go through the backfill.

statement ok
insert into ulf_t values
  (1, 'A1 B2', 'K', '{"xs": ["a", "b", "a"], "ys": [{"a": 1}, {"a": 2}], "obj": {"p": 1, "q": [2]}}', array[1, 2, 2], 3),
  (2, 'A10 A11', 'K', '{"xs": [], "ys": [], "obj": {}}', array[]::int[], 0),
  (3, null, 'K', null, null, null),
  (4, 'xyz', 'c', '{"xs": ["c", null, "c"], "zs": 5}', array[null, 5]::int[], -1),
  (5, 'B7 A3', 'c', '{"xs": ["d"], "ys": [{"a": null}, {"b": 3}], "zs": [1, "x"], "obj": {"k": null}}', array[3, null, 3]::int[], 2),
  (6, '', null, '{"zs": {"a": 1}}', array[7], 1);

statement ok
insert into ulf_u values (1, array[1, 2]), (1, array[1, 2]), (null, null), (2, array[]::int[]), (3, array[null]::int[]), (3, array[4, 4]);

statement ok
set streaming_unnest_lateral_functions = false;

# two LEFT JOIN LATERAL over regexp_matches, with a filter on the outer side

statement ok
create materialized view ulf_regexp_off as select t.id, a.x, b.y from ulf_t t left join lateral (select (regexp_matches(t.s, 'A([0-9]+)'))[1] as x) as a on true left join lateral (select (regexp_matches(t.s, 'B([0-9]+)'))[1] as y) as b on true where t.c = 'K';

# LEFT JOIN of jsonb_array_elements_text of the outer row

statement ok
create materialized view ulf_left_jsonb_off as select t.id, e.x from ulf_t t left join jsonb_array_elements_text(t.j -> 'xs') as e(x) on true;

# LEFT JOIN of unnest WITH ORDINALITY

statement ok
create materialized view ulf_left_ordinality_off as select t.id, x.v, x.o from ulf_t t left join unnest(t.arr) with ordinality as x(v, o) on true;

# LEFT JOIN LATERAL with a constant column

statement ok
create materialized view ulf_left_const_off as select t.id, l.one, l.v from ulf_t t left join lateral (select 1 as one, unnest(t.arr) as v) as l on true;

# LEFT JOIN of generate_series bounded by a column of the outer row

statement ok
create materialized view ulf_left_series_off as select t.id, g.i from ulf_t t left join generate_series(1, t.n) as g(i) on true;

# LEFT JOIN of jsonb_each

statement ok
create materialized view ulf_left_each_off as select t.id, e.key, e.value from ulf_t t left join jsonb_each(t.j -> 'obj') as e on true;

# ARRAY of a set-returning function of the outer row

statement ok
create materialized view ulf_array_off as select t.id, array(select jsonb_array_elements_text(coalesce(t.j -> 'xs', '[]'::jsonb))) as xs from ulf_t t;

# COALESCE of an ARRAY of a set-returning function

statement ok
create materialized view ulf_array_coalesce_off as select id, coalesce(array(select jsonb_array_elements_text(coalesce(t.j -> 'xs', '[]'::jsonb))), array[]::text[]) as xs from ulf_t t;

# ARRAY with ORDER BY over unnest

statement ok
create materialized view ulf_array_ordered_off as select t.id, array(select v from unnest(t.arr) as v order by v desc) as a from ulf_t t;

# scalar max, with a filter on the outer side

statement ok
create materialized view ulf_max_filter_off as select t.id, (select max(x) from jsonb_array_elements_text(t.j -> 'xs') as x) as m from ulf_t t where t.c = 'c';

# scalar sum with a default

statement ok
create materialized view ulf_sum_coalesce_off as select t.id, coalesce((select sum((e ->> 'a')::bigint) from jsonb_array_elements(t.j -> 'ys') as e), 0) as total from ulf_t t;

# scalar sum, NULL when no value is there

statement ok
create materialized view ulf_sum_raw_off as select t.id, (select sum((e ->> 'a')::bigint) from jsonb_array_elements(t.j -> 'ys') as e) as total from ulf_t t;

# count over unnest

statement ok
create materialized view ulf_count_off as select t.id, (select count(*) from unnest(t.arr) as v) as c from ulf_t t;

# EXISTS over unnest

statement ok
create materialized view ulf_exists_off as select t.id, exists (select 1 from unnest(t.arr) as v) as e from ulf_t t;

# count and EXISTS over unnest in one select list

statement ok
create materialized view ulf_count_exists_off as select t.id, (select count(*) from unnest(t.arr) as v) as c, exists (select 1 from unnest(t.arr) as v) as e from ulf_t t;

# string_agg with ORDER BY over the keys of an object

statement ok
create materialized view ulf_string_agg_off as select t.id, (select string_agg(k, ',' order by k) from jsonb_object_keys(t.j -> 'obj') as k) as ks from ulf_t t;

# correlated column in the aggregated expression

statement ok
create materialized view ulf_corr_arg_off as select t.id, (select max(v + t.n) from unnest(t.arr) as v) as m from ulf_t t;

# outer side without a key, with duplicates and NULLs

statement ok
create materialized view ulf_nokey_off as select u.k, u.arr, (select max(v) from unnest(u.arr) as v) as m, array(select unnest(u.arr)) as a from ulf_u u;

# unnest of a COALESCE of an ARRAY of a set-returning function

statement ok
create materialized view ulf_unnest_array_off as select t1.id, x.v from (select id, coalesce(array(select jsonb_array_elements_text(coalesce(j -> 'xs', '[]'::jsonb))), array[]::text[]) as arr from ulf_t) as t1 join unnest(t1.arr) as x(v) on true;

# unnest of an ARRAY that is also selected

statement ok
create materialized view ulf_unnest_array_kept_off as select t1.id, t1.arr, x.v from (select id, array(select jsonb_array_elements_text(j -> 'xs')) as arr from ulf_t) as t1 join unnest(t1.arr) as x(v) on true;

# running sum over unnest WITH ORDINALITY in a lateral subquery

statement ok
create materialized view ulf_window_off as select t.id, x.v, x.run from ulf_t t cross join lateral (select v, sum(v) over (order by o rows unbounded preceding) as run from unnest(t.arr) with ordinality as w(v, o)) as x;

# LEFT JOIN of a function that fails on some rows

statement ok
create materialized view ulf_errors_left_off as select t.id, e.x from ulf_t t left join jsonb_array_elements_text(t.j -> 'zs') as e(x) on true;

# count and ARRAY of a function that fails on some rows

statement ok
create materialized view ulf_errors_agg_off as select t.id, (select count(*) from jsonb_array_elements_text(t.j -> 'zs')) as c, array(select jsonb_array_elements_text(t.j -> 'zs')) as a from ulf_t t;

