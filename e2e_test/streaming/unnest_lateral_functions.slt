# Second round of changes: the source columns are updated, set to NULL or emptied.

# The sum of row 1 loses all its non-NULL values while the row keeps elements.

statement ok
update ulf_t set j = '{"xs": ["a"], "ys": [{"a": null}], "obj": {"p": 2}}' where id = 1;

statement ok
update ulf_t set arr = array[]::int[], n = 0 where id = 1;

statement ok
update ulf_t set s = 'B1 B2 A9', c = 'K' where id = 4;

statement ok
update ulf_t set j = '{"xs": ["g", "h"], "zs": "bad"}', arr = array[2, 1] where id = 3;

statement ok
update ulf_t set j = null, arr = null, s = null where id = 5;

statement ok
update ulf_t set n = 5 where id = 6;

statement ok
delete from ulf_t where id = 8;

statement ok
update ulf_u set arr = array[5, null] where k = 2;

statement ok
delete from ulf_u where k = 1;

