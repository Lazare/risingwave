# Second round of changes: values set to NULL and back, deletes (retractions).

statement ok
update sfnc_t set a = null, b = null where id in (4, 6);

statement ok
update sfnc_t set c = 7 where id = 2;

statement ok
update sfnc_t set a = 'x' where id = 5;

statement ok
delete from sfnc_t where id = 7;

statement ok
delete from sfnc_r where id in (2, 3);

