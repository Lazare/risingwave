# Watermarks: a filter on a table with a watermark is never replaced with an empty relation, so
# that an `EMIT ON WINDOW CLOSE` job above it can still be planned and runs.

statement ok
create table sfnc_m (k varchar, ts timestamp, watermark for ts as ts - interval '5 minutes') append only;

statement ok
set streaming_fold_null_contradictions = true;

statement ok
create materialized view sfnc_eowc as select window_start, count(*) as n from tumble(sfnc_m, ts, interval '1' hour) where k is null and k ~ '^x' group by window_start emit on window close;

statement ok
set streaming_fold_null_contradictions = false;

statement ok
insert into sfnc_m values ('x', '2026-01-01 00:10:00'), (null, '2026-01-01 00:20:00'), ('xy', '2026-01-01 03:00:00');

statement ok
flush;

query I
select count(*) from sfnc_eowc;
----
0

statement ok
drop materialized view sfnc_eowc;

statement ok
drop table sfnc_m;

