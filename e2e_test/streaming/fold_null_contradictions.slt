statement ok
create materialized view sfnc_count_join_off as select count(*) as n from sfnc_t t join sfnc_r r on t.a = r.k where coalesce(t.a, t.b) is null and upper(coalesce(t.a, t.b)) = 'X';

statement ok
create materialized view sfnc_union_branch_off as select id, c from sfnc_t where c > 0 union all select id, c from sfnc_t where coalesce(c, d) is null and coalesce(c, d) <> 0;

