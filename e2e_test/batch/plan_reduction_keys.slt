  (select count(*) from (select id, grp, count(*) as bk_rows from bk_all_views_on group by id, grp except select id, grp, count(*) as bk_rows from bk_all_views_off group by id, grp) x),
  (select count(*) from (select id, grp, count(*) as bk_rows from bk_all_views_off group by id, grp except select id, grp, count(*) as bk_rows from bk_all_views_on group by id, grp) y),
  (select count(*) from bk_all_views_on) - (select count(*) from bk_all_views_off);
----
0 0 0

query III
select
  (select count(*) from (select id, n, g, count(*) as bk_rows from bk_all_agg_views_on group by id, n, g except select id, n, g, count(*) as bk_rows from bk_all_agg_views_off group by id, n, g) x),
  (select count(*) from (select id, n, g, count(*) as bk_rows from bk_all_agg_views_off group by id, n, g except select id, n, g, count(*) as bk_rows from bk_all_agg_views_on group by id, n, g) y),
  (select count(*) from bk_all_agg_views_on) - (select count(*) from bk_all_agg_views_off);
----
0 0 0

query III
select
  (select count(*) from (select id, name, grp, count(*) as bk_rows from bk_all_lookups_facts_on group by id, name, grp except select id, name, grp, count(*) as bk_rows from bk_all_lookups_facts_off group by id, name, grp) x),
  (select count(*) from (select id, name, grp, count(*) as bk_rows from bk_all_lookups_facts_off group by id, name, grp except select id, name, grp, count(*) as bk_rows from bk_all_lookups_facts_on group by id, name, grp) y),
  (select count(*) from bk_all_lookups_facts_on) - (select count(*) from bk_all_lookups_facts_off);
----
0 0 0

