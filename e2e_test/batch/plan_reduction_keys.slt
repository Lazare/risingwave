# Empty dimension: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, amt, count(*) as bk_rows from bk_contra_eq_on group by id, amt except select id, amt, count(*) as bk_rows from bk_contra_eq_off group by id, amt) x),
  (select count(*) from (select id, amt, count(*) as bk_rows from bk_contra_eq_off group by id, amt except select id, amt, count(*) as bk_rows from bk_contra_eq_on group by id, amt) y),
  (select count(*) from bk_contra_eq_on) - (select count(*) from bk_contra_eq_off);
----
0 0 0

query III
select
  (select count(*) from (select id, count(*) as bk_rows from bk_contra_bounds_on group by id except select id, count(*) as bk_rows from bk_contra_bounds_off group by id) x),
  (select count(*) from (select id, count(*) as bk_rows from bk_contra_bounds_off group by id except select id, count(*) as bk_rows from bk_contra_bounds_on group by id) y),
  (select count(*) from bk_contra_bounds_on) - (select count(*) from bk_contra_bounds_off);
----
0 0 0

query III
select
  (select count(*) from (select id, count(*) as bk_rows from bk_nn_is_null_on group by id except select id, count(*) as bk_rows from bk_nn_is_null_off group by id) x),
  (select count(*) from (select id, count(*) as bk_rows from bk_nn_is_null_off group by id except select id, count(*) as bk_rows from bk_nn_is_null_on group by id) y),
  (select count(*) from bk_nn_is_null_on) - (select count(*) from bk_nn_is_null_off);
----
