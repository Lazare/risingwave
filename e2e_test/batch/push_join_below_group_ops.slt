statement ok
create table pjg_tk (tid int primary key, kind varchar);

statement ok
create view pjg_va as select k, last_value(doc order by ts) as doc, max(ts) as ts from pjg_ea group by k;

statement ok
create view pjg_vb as select k, last_value(doc order by ts) as doc, max(ts) as ts from pjg_eb group by k;

statement ok
create view pjg_vab as select * from pjg_va union all select * from pjg_vb;

statement ok
create view pjg_vu as select distinct on (k) * from pjg_vab order by k, ts desc;

statement ok
create view pjg_vt as select distinct on (k) k, ts, doc from pjg_ea order by k, ts desc;

statement ok
create view pjg_vd as select distinct on (k) k, ts, doc from pjg_ea;

statement ok
create view pjg_vg as select k, g, last_value(doc order by ts) as doc from pjg_ea group by k, g;

statement ok
create view pjg_sel as select att.aid, att.x from pjg_att att join pjg_tk tk on att.tid = tk.tid where tk.kind = 'a';

