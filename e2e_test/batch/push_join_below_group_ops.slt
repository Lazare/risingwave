# With the first rows: every mode holds the rows of the plan without the rules.

query III
select
  (select count(*) from (select u, w, x, ts, count(*) as pjg_rows from pjg_topn_union_join group by u, w, x, ts except select u, w, x, ts, count(*) as pjg_rows from pjg_topn_union_off group by u, w, x, ts) x),
  (select count(*) from (select u, w, x, ts, count(*) as pjg_rows from pjg_topn_union_off group by u, w, x, ts except select u, w, x, ts, count(*) as pjg_rows from pjg_topn_union_join group by u, w, x, ts) y),
  (select count(*) from pjg_topn_union_join) - (select count(*) from pjg_topn_union_off);
----
0 0 0

