# Differential test of `batch_status_ladder_case`: every query is run as a batch query with and
# without the variable, into a result table each, and both must hold the same multiset of rows, on
# the initial rows and after each round of changes.
#
# Generated by `python3 e2e_test/batch/status_ladder_case.gen.py <this file>`: edit the list of
# queries in `e2e_test/streaming/status_ladder_case.gen.py` and regenerate rather than editing by
# hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table slb_e (id int primary key, a int, b int, s varchar);

statement ok
create table slb_f (r int primary key, k int, st varchar, amt int, ts timestamptz);

statement ok
create table slb_g (r int primary key, k int);

# three branches over the same table become one CASE, one branch over another table

statement ok
create table slb_r_form1_off (c1 int, c2 varchar);

statement ok
create table slb_r_form1_on (c1 int, c2 varchar);

# every branch over a table that is not unique on the key: the top-1 stays

statement ok
create table slb_r_same_table_off (c1 int, c2 varchar);

statement ok
create table slb_r_same_table_on (c1 int, c2 varchar);

# every branch over a table unique on the key, with a default branch

statement ok
create table slb_r_unique_default_off (c1 int, c2 varchar);

statement ok
create table slb_r_unique_default_on (c1 int, c2 varchar);

# every branch over a table unique on the key, without a default branch

statement ok
create table slb_r_unique_no_default_off (c1 int, c2 varchar);

statement ok
create table slb_r_unique_no_default_on (c1 int, c2 varchar);

# ascending priority

statement ok
create table slb_r_ascending_off (c1 int, c2 varchar);

statement ok
create table slb_r_ascending_on (c1 int, c2 varchar);

# the priority is output too

statement ok
create table slb_r_with_priority_off (c1 int, c2 varchar, c3 int);

statement ok
create table slb_r_with_priority_on (c1 int, c2 varchar, c3 int);

# branches over a shared join, and one over another table

statement ok
create table slb_r_shared_join_off (c1 int, c2 varchar);

statement ok
create table slb_r_shared_join_on (c1 int, c2 varchar);

# a branch with now() stays a separate branch

statement ok
create table slb_r_now_branch_off (c1 int, c2 varchar);

statement ok
create table slb_r_now_branch_on (c1 int, c2 varchar);

# kept: the branches compute the key differently

statement ok
create table slb_r_kept_key_off (c1 int, c2 varchar);

statement ok
create table slb_r_kept_key_on (c1 int, c2 varchar);

# kept: two rows per key

statement ok
create table slb_r_kept_top2_off (c1 int, c2 varchar);

statement ok
create table slb_r_kept_top2_on (c1 int, c2 varchar);

# kept: each branch over its own table

statement ok
create table slb_r_kept_tables_off (c1 int, c2 varchar);

statement ok
create table slb_r_kept_tables_on (c1 int, c2 varchar);

# two GROUP BY branches over the same table, and a default branch over another table

statement ok
create table slb_r_agg_dedup_off (c1 int, c2 varchar);

statement ok
create table slb_r_agg_dedup_on (c1 int, c2 varchar);

# every branch is a GROUP BY of the same table by the key: the top-1 is removed

statement ok
create table slb_r_agg_only_off (c1 int, c2 varchar);

statement ok
create table slb_r_agg_only_on (c1 int, c2 varchar);

# GROUP BY branches with conditions on their aggregates

statement ok
create table slb_r_agg_having_off (c1 int, c2 varchar);

statement ok
create table slb_r_agg_having_on (c1 int, c2 varchar);

# SELECT DISTINCT branches over the same table

statement ok
create table slb_r_agg_distinct_off (c1 int, c2 varchar);

statement ok
create table slb_r_agg_distinct_on (c1 int, c2 varchar);

# GROUP BY branches by the same expression

statement ok
create table slb_r_agg_expr_key_off (c1 int, c2 varchar);

statement ok
create table slb_r_agg_expr_key_on (c1 int, c2 varchar);

# GROUP BY branches over the same shared join

