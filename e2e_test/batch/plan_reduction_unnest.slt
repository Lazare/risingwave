create table bpu_uj_two_cols_on as select f.id, d.active from bpu_f f join bpu_d d on f.dim_id = d.id and f.amt = d.grp union all select g.id, d.active from bpu_g g join bpu_d d on g.b = d.grp and g.a = d.id limit 0;

