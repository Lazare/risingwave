statement ok
create table bpu_uj_derived_join_on as select f.id, v.name, v.a from bpu_f f join bpu_dj v on f.dim_id = v.id union all select e.id, v.name, v.a from bpu_e e join bpu_dj v on e.ref = v.id limit 0;

