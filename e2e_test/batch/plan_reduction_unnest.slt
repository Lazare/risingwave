statement ok
create table bpu_un_exists_or_on as select p.id, p.v from bpu_p p where p.v > 2 or exists (select 1 from bpu_r r where r.pid = p.id) limit 0;

statement ok
create table bpu_un_exists_case_off as select p.id, case when exists (select 1 from bpu_r r where r.pid = p.v) then 'y' else 'n' end as c from bpu_p p limit 0;

statement ok
create table bpu_un_exists_case_on as select p.id, case when exists (select 1 from bpu_r r where r.pid = p.v) then 'y' else 'n' end as c from bpu_p p limit 0;

