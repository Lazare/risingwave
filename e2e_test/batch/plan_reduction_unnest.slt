statement ok
set batch_simplify_subquery_unnesting = false;

query III
select
  (select count(*) from (select c0, c1, count(*) as n from (select id as c0, e as c1 from bpu_un_exists_select_on) z group by c0, c1 except select c0, c1, count(*) as n from (select id as c0, e as c1 from bpu_un_exists_select_off) z group by c0, c1) x),
  (select count(*) from (select c0, c1, count(*) as n from (select id as c0, e as c1 from bpu_un_exists_select_off) z group by c0, c1 except select c0, c1, count(*) as n from (select id as c0, e as c1 from bpu_un_exists_select_on) z group by c0, c1) y),
  (select count(*) from bpu_un_exists_select_on) - (select count(*) from bpu_un_exists_select_off);
----
