create table bpu_uj_derived_agg_off as select f.id, v.cnt, v.mx from bpu_f f left join bpu_dagg v on f.amt = v.grp union all select e.id, v.cnt, e.code from bpu_e e left join bpu_dagg v on e.ref = v.grp limit 0;

statement ok
create table bpu_uj_derived_agg_on as select f.id, v.cnt, v.mx from bpu_f f left join bpu_dagg v on f.amt = v.grp union all select e.id, v.cnt, e.code from bpu_e e left join bpu_dagg v on e.ref = v.grp limit 0;

