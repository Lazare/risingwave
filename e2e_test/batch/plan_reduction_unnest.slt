# Differential test of the batch counterparts of stages of the streaming plan reduction prototype
# (`batch_simplify_subquery_unnesting`, `batch_unnest_lateral_functions`, `batch_factor_union_join`,
# `batch_merge_union_scans`): every query is run as a batch `INSERT ... SELECT` with and without its
# variable, and both results must hold the same rows, after each round of changes of the data.
#
# Generated by `python3 e2e_test/batch/plan_reduction_unnest.gen.py <this file>`: edit the list of
# queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
set batch_simplify_subquery_unnesting = false;

statement ok
set batch_unnest_lateral_functions = false;

statement ok
set batch_factor_union_join = false;

statement ok
set batch_merge_union_scans = false;

statement ok
create table bpu_p (id int primary key, v int, g int);

statement ok
create table bpu_r (id int primary key, pid int, s varchar, x int);

statement ok
create table bpu_q (id int primary key, pid int);

statement ok
create table bpu_u (k int, v int, arr int[]);

statement ok
create table bpu_t (id int primary key, s varchar, c varchar, j jsonb, arr int[], n int);

statement ok
create table bpu_f (id int primary key, dim_id int, other_id int, amt int, label varchar);

statement ok
create table bpu_d (id int primary key, name varchar, grp int, active boolean);

statement ok
create table bpu_e (id int primary key, code varchar, ref int);

statement ok
create table bpu_g (id int primary key, a int, b int);

statement ok
create view bpu_dagg as select grp, count(*) as cnt, max(name) as mx from bpu_d group by grp;

statement ok
create view bpu_dj as select d.id, d.name, d.grp, g.a from bpu_d d join bpu_g g on d.grp = g.b;

statement ok
create view bpu_dnames as select grp, string_agg(name, ',' order by name) as names from bpu_d group by grp;

statement ok
create table bpu_m (k int primary key, a int, b int, x varchar, y varchar, flag boolean);

statement ok
create table bpu_mw (k int, v int, ts timestamp, watermark for ts as ts - interval '1' second) append only;

# The result tables: one per query and setting, with the columns of the query.

statement ok
create table bpu_un_exists_select_off as select p.id, exists (select 1 from bpu_r r where r.pid = p.id and r.s = 'x') as e from bpu_p p limit 0;

statement ok
create table bpu_un_exists_select_on as select p.id, exists (select 1 from bpu_r r where r.pid = p.id and r.s = 'x') as e from bpu_p p limit 0;

statement ok
