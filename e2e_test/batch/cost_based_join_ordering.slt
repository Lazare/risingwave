# Initial data: with and without the cost-based join ordering, the same rows.

query III
select
  (select count(*) from (select c0, c1, c2, count(*) as n from cbj_r_on_star group by c0, c1, c2 except select c0, c1, c2, count(*) as n from cbj_r_off_star group by c0, c1, c2) x),
  (select count(*) from (select c0, c1, c2, count(*) as n from cbj_r_off_star group by c0, c1, c2 except select c0, c1, c2, count(*) as n from cbj_r_on_star group by c0, c1, c2) y),
  (select count(*) from cbj_r_on_star) - (select count(*) from cbj_r_off_star);
----
0 0 0

