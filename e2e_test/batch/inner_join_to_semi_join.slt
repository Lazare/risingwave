# Empty kept side: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, k, v, count(*) as ijs_rows from ijs_distinct_right_on group by id, k, v except select id, k, v, count(*) as ijs_rows from ijs_distinct_right_off group by id, k, v) x),
