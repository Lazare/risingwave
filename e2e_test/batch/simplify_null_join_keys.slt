# Only NULL keys on the right side: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, label, count(*) as nk_rows from nk_inner_right_on group by id, label except select id, label, count(*) as nk_rows from nk_inner_right_off group by id, label) x),
  (select count(*) from (select id, label, count(*) as nk_rows from nk_inner_right_off group by id, label except select id, label, count(*) as nk_rows from nk_inner_right_on group by id, label) y),
  (select count(*) from nk_inner_right_on) - (select count(*) from nk_inner_right_off);
----
0 0 0

