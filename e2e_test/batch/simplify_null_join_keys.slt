insert into nk_kept_expr_coalesce_off select a.id, b.label from nk_a a left join nk_e e on a.bk = e.p left join nk_b b on coalesce(e.w, 0) = b.k where a.bk is null;

statement ok
set batch_simplify_null_join_keys = true;

statement ok
insert into nk_kept_expr_coalesce_on select a.id, b.label from nk_a a left join nk_e e on a.bk = e.p left join nk_b b on coalesce(e.w, 0) = b.k where a.bk is null;

