insert into nk_kept_expr_not_null_off select a.id, b.label from nk_a a left join nk_e e on a.bk = e.p left join nk_b b on case when jsonb_build_object('w', e.w)->>'w' is null then 1 else 0 end = b.k where a.bk is null;

statement ok
