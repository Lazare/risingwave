# Second data: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, label, count(*) as nk_rows from nk_inner_right_on group by id, label except select id, label, count(*) as nk_rows from nk_inner_right_off group by id, label) x),
  (select count(*) from (select id, label, count(*) as nk_rows from nk_inner_right_off group by id, label except select id, label, count(*) as nk_rows from nk_inner_right_on group by id, label) y),
  (select count(*) from nk_inner_right_on) - (select count(*) from nk_inner_right_off);
----
0 0 0

query III
select
  (select count(*) from (select id, label, count(*) as nk_rows from nk_inner_left_on group by id, label except select id, label, count(*) as nk_rows from nk_inner_left_off group by id, label) x),
  (select count(*) from (select id, label, count(*) as nk_rows from nk_inner_left_off group by id, label except select id, label, count(*) as nk_rows from nk_inner_left_on group by id, label) y),
  (select count(*) from nk_inner_left_on) - (select count(*) from nk_inner_left_off);
----
0 0 0

query III
select
  (select count(*) from (select id, x, b_k, label, count(*) as nk_rows from nk_view_on group by id, x, b_k, label except select id, x, b_k, label, count(*) as nk_rows from nk_view_off group by id, x, b_k, label) x),
  (select count(*) from (select id, x, b_k, label, count(*) as nk_rows from nk_view_off group by id, x, b_k, label except select id, x, b_k, label, count(*) as nk_rows from nk_view_on group by id, x, b_k, label) y),
  (select count(*) from nk_view_on) - (select count(*) from nk_view_off);
----
0 0 0

query III
select
  (select count(*) from (select id, v, count(*) as nk_rows from nk_cast_on group by id, v except select id, v, count(*) as nk_rows from nk_cast_off group by id, v) x),
  (select count(*) from (select id, v, count(*) as nk_rows from nk_cast_off group by id, v except select id, v, count(*) as nk_rows from nk_cast_on group by id, v) y),
  (select count(*) from nk_cast_on) - (select count(*) from nk_cast_off);
----
