# Empty large side: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, cid, count(*) as bcj_rows from bcj_constant_key_on group by id, cid except select id, cid, count(*) as bcj_rows from bcj_constant_key_off group by id, cid) x),
  (select count(*) from (select id, cid, count(*) as bcj_rows from bcj_constant_key_off group by id, cid except select id, cid, count(*) as bcj_rows from bcj_constant_key_on group by id, cid) y),
