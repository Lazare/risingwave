# Empty left side: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, bid, count(*) as ojt_rows from ojt_inner_on group by id, bid except select id, bid, count(*) as ojt_rows from ojt_inner_off group by id, bid) x),
