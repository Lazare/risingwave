statement ok
create table snv_r (s varchar, j jsonb, ts int);

statement ok
create table snv_e (e jsonb, ts int);

statement ok
create table snv_tie (id int, ts int, fact jsonb);

statement ok
create view snv_v as select id, last_value(fact order by ts) as fact from snv_ev group by id;

statement ok
create view snv_v2 as select id, last_value(fact order by ts) as fact from snv_ev2 group by id;

statement ok
create view snv_vf as select id, first_value(fact order by ts desc) as fact from snv_ev group by id;

statement ok
create view snv_vu as select id, last_value(fact order by ts) as fact from (select id, ts, fact from snv_ev union all select id, ts, fact from snv_ev2) u group by id;

statement ok
create view snv_lower_first as select s, first_value(j order by ts desc) as j, max(ts) as ts from (select l.s, r.j, r.ts from snv_l l join snv_r r on l.s = r.s) x group by s;

statement ok
create view snv_latest as select v->>'id' as id, last_value(v order by ts) as fact from (select case when j->>'kind' = 'wrapped' then j->'inner' else j end as v, ts from snv_src union all select case when j->>'kind' = 'wrapped' then j->'inner' else j end as v, ts from snv_lower_first where j->>'kind' is distinct from 'skipped' union all select e->'data' as v, ts from snv_e) u group by v->>'id';

statement ok
create view snv_tie_v as select id, last_value(fact order by ts) as fact from snv_tie group by id;

