# With the first rows (after the backfill): both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, dir, count(*) as snv_rows from snv_one_field_on group by id, dir except select id, dir, count(*) as snv_rows from snv_one_field_off group by id, dir) x),
  (select count(*) from (select id, dir, count(*) as snv_rows from snv_one_field_off group by id, dir except select id, dir, count(*) as snv_rows from snv_one_field_on group by id, dir) y),
  (select count(*) from snv_one_field_on) - (select count(*) from snv_one_field_off);
----
0 0 0

query III
select
  (select count(*) from (select id, a, c, no_dir, count(*) as snv_rows from snv_several_fields_on group by id, a, c, no_dir except select id, a, c, no_dir, count(*) as snv_rows from snv_several_fields_off group by id, a, c, no_dir) x),
  (select count(*) from (select id, a, c, no_dir, count(*) as snv_rows from snv_several_fields_off group by id, a, c, no_dir except select id, a, c, no_dir, count(*) as snv_rows from snv_several_fields_on group by id, a, c, no_dir) y),
  (select count(*) from snv_several_fields_on) - (select count(*) from snv_several_fields_off);
----
0 0 0

query III
select
  (select count(*) from (select id, n, count(*) as snv_rows from snv_cast_ok_on group by id, n except select id, n, count(*) as snv_rows from snv_cast_ok_off group by id, n) x),
  (select count(*) from (select id, n, count(*) as snv_rows from snv_cast_ok_off group by id, n except select id, n, count(*) as snv_rows from snv_cast_ok_on group by id, n) y),
  (select count(*) from snv_cast_ok_on) - (select count(*) from snv_cast_ok_off);
----
0 0 0

query III
select
  (select count(*) from (select id, n, count(*) as snv_rows from snv_cast_fails_below_on group by id, n except select id, n, count(*) as snv_rows from snv_cast_fails_below_off group by id, n) x),
  (select count(*) from (select id, n, count(*) as snv_rows from snv_cast_fails_below_off group by id, n except select id, n, count(*) as snv_rows from snv_cast_fails_below_on group by id, n) y),
  (select count(*) from snv_cast_fails_below_on) - (select count(*) from snv_cast_fails_below_off);
----
0 0 0

