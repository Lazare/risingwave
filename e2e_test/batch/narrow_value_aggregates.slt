# Ties: in each result, all the fields come from one of the last rows.

query I
select count(*) from snv_tie_pair_off where substr(a, 2) is distinct from substr(b, 2);
----
0

query I
select count(*) from snv_tie_pair_off r where not exists (select 1 from (select t.id, t.fact->>'a' as a from snv_tie t where t.ts is not distinct from (select case when count(*) filter (where t2.ts is null) > 0 then null else max(t2.ts) end from snv_tie t2 where t2.id = t.id)) c where c.id = r.id and c.a = r.a);
----
0

query I
select (select count(*) from snv_tie_pair_off) - (select count(distinct id) from snv_tie);
----
0

query I
select count(*) from snv_tie_pair_on where substr(a, 2) is distinct from substr(b, 2);
----
0

query I
select count(*) from snv_tie_pair_on r where not exists (select 1 from (select t.id, t.fact->>'a' as a from snv_tie t where t.ts is not distinct from (select case when count(*) filter (where t2.ts is null) > 0 then null else max(t2.ts) end from snv_tie t2 where t2.id = t.id)) c where c.id = r.id and c.a = r.a);
----
0

query I
select (select count(*) from snv_tie_pair_on) - (select count(distinct id) from snv_tie);
----
0

