# After whole groups are deleted: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, dir, count(*) as snv_rows from snv_one_field_on group by id, dir except select id, dir, count(*) as snv_rows from snv_one_field_off group by id, dir) x),
  (select count(*) from (select id, dir, count(*) as snv_rows from snv_one_field_off group by id, dir except select id, dir, count(*) as snv_rows from snv_one_field_on group by id, dir) y),
  (select count(*) from snv_one_field_on) - (select count(*) from snv_one_field_off);
----
0 0 0

