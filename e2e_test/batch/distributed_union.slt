  (select count(*) from (select id, k, v, s, count(*) as du_rows from du_plain_off group by id, k, v, s except select id, k, v, s, count(*) as du_rows from du_plain_on group by id, k, v, s) y),
  (select count(*) from du_plain_on) - (select count(*) from du_plain_off);
