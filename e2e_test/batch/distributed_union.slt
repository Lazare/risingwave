# Empty tables, distributed query mode: every query runs without, then with the variable.

statement ok
set query_mode = distributed;

statement ok
delete from du_plain_off;

statement ok
delete from du_plain_on;

statement ok
insert into du_plain_off select id, k, v, s from du_a union all select id, k, v, s from du_b union all select id, k, v, s from du_c;

statement ok
set batch_distributed_union = true;

statement ok
insert into du_plain_on select id, k, v, s from du_a union all select id, k, v, s from du_b union all select id, k, v, s from du_c;

statement ok
set batch_distributed_union = false;

statement ok
delete from du_plain_empty_off;

statement ok
delete from du_plain_empty_on;

statement ok
insert into du_plain_empty_off select id, k, v, s from du_a union all select id, k, v, s from du_e union all select id, k, v, s from du_c where v > 1000;

statement ok
set batch_distributed_union = true;

statement ok
insert into du_plain_empty_on select id, k, v, s from du_a union all select id, k, v, s from du_e union all select id, k, v, s from du_c where v > 1000;

statement ok
set batch_distributed_union = false;

statement ok
delete from du_agg_k_off;

statement ok
delete from du_agg_k_on;

