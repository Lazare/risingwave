# Second data, local query mode: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, k, v, s, count(*) as du_rows from du_plain_on group by id, k, v, s except select id, k, v, s, count(*) as du_rows from du_plain_off group by id, k, v, s) x),
  (select count(*) from (select id, k, v, s, count(*) as du_rows from du_plain_off group by id, k, v, s except select id, k, v, s, count(*) as du_rows from du_plain_on group by id, k, v, s) y),
  (select count(*) from du_plain_on) - (select count(*) from du_plain_off);
