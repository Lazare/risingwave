statement ok
insert into pl_u_expr_topn_off select a, b + 1 as b1 from pl_t1 union all select a, b * 2 from pl_t3 order by a, b1 limit 4;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_expr_topn_on select a, b + 1 as b1 from pl_t1 union all select a, b * 2 from pl_t3 order by a, b1 limit 4;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_nested_off;

statement ok
delete from pl_u_nested_on;

statement ok
insert into pl_u_nested_off select x from (select a as x from pl_t1 union all select x from (select a + 1 as x from pl_t2 union all select a from pl_t3) s) v order by x limit 6;

statement ok
