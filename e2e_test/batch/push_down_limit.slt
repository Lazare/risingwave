# Second data, distributed query mode: every query runs without, then with the variable.

statement ok
set query_mode = distributed;

statement ok
delete from pl_u_count_off;

statement ok
delete from pl_u_count_on;

statement ok
insert into pl_u_count_off select count(*) from (select a from pl_t1 union all select a from pl_t2 limit 5) s;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_count_on select count(*) from (select a from pl_t1 union all select a from pl_t2 limit 5) s;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_count_offset_off;

statement ok
delete from pl_u_count_offset_on;

statement ok
insert into pl_u_count_offset_off select count(*) from (select a from pl_t1 union all select a from pl_t3 limit 4 offset 3) s;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_count_offset_on select count(*) from (select a from pl_t1 union all select a from pl_t3 limit 4 offset 3) s;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_count_three_off;

statement ok
delete from pl_u_count_three_on;

statement ok
insert into pl_u_count_three_off select count(*) from (select a from pl_t1 union all select a from pl_t2 union all select a from pl_t3 limit 9) s;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_count_three_on select count(*) from (select a from pl_t1 union all select a from pl_t2 union all select a from pl_t3 limit 9) s;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_large_off;

statement ok
delete from pl_u_large_on;

statement ok
insert into pl_u_large_off select a, b from pl_t1 union all select a, b from pl_t3 limit 1000;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_large_on select a, b from pl_t1 union all select a, b from pl_t3 limit 1000;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_topn_off;

statement ok
delete from pl_u_topn_on;

statement ok
insert into pl_u_topn_off select a, b from pl_t1 union all select a, b from pl_t3 order by a, b limit 5 offset 2;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_topn_on select a, b from pl_t1 union all select a, b from pl_t3 order by a, b limit 5 offset 2;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_topn_desc_off;

statement ok
delete from pl_u_topn_desc_on;

statement ok
insert into pl_u_topn_desc_off select a, b from pl_t1 union all select a, b from pl_t3 order by a desc nulls last, b desc limit 3;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_topn_desc_on select a, b from pl_t1 union all select a, b from pl_t3 order by a desc nulls last, b desc limit 3;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_topn_nulls_first_off;

statement ok
delete from pl_u_topn_nulls_first_on;

statement ok
insert into pl_u_topn_nulls_first_off select a, b from pl_t1 union all select a, b from pl_t3 order by a nulls first, b limit 4;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_topn_nulls_first_on select a, b from pl_t1 union all select a, b from pl_t3 order by a nulls first, b limit 4;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_ties_off;

statement ok
delete from pl_u_ties_on;

statement ok
insert into pl_u_ties_off select a, b from pl_t1 union all select a, b from pl_t3 order by a fetch first 3 rows with ties;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_ties_on select a, b from pl_t1 union all select a, b from pl_t3 order by a fetch first 3 rows with ties;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_filter_off;

statement ok
delete from pl_u_filter_on;

statement ok
