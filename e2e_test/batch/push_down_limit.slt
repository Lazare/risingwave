statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_filter_on select count(*) from (select * from (select a, b from pl_t1 union all select a, b from pl_t3) u where b > 2 limit 3) s;

statement ok
set batch_push_down_limit = false;

statement ok
delete from pl_u_filter_topn_off;

