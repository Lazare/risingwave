# Empty right sides, local query mode: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select n, count(*) as pl_rows from pl_u_count_on group by n except select n, count(*) as pl_rows from pl_u_count_off group by n) x),
  (select count(*) from (select n, count(*) as pl_rows from pl_u_count_off group by n except select n, count(*) as pl_rows from pl_u_count_on group by n) y),
  (select count(*) from pl_u_count_on) - (select count(*) from pl_u_count_off);
----
0 0 0

