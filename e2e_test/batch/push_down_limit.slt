# Fourth data: the right sides and one branch emptied.

statement ok
delete from pl_r;

statement ok
delete from pl_rd;

statement ok
delete from pl_t2;

# Empty right sides, local query mode: every query runs without, then with the variable.

statement ok
set query_mode = local;

statement ok
delete from pl_u_count_off;

statement ok
delete from pl_u_count_on;

statement ok
insert into pl_u_count_off select count(*) from (select a from pl_t1 union all select a from pl_t2 limit 5) s;

statement ok
set batch_push_down_limit = true;

statement ok
insert into pl_u_count_on select count(*) from (select a from pl_t1 union all select a from pl_t2 limit 5) s;

statement ok
set batch_push_down_limit = false;

statement ok
