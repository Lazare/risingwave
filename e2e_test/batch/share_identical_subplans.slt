statement ok
delete from sp_kept_diff_aggs_off;

statement ok
delete from sp_kept_diff_aggs_on;

statement ok
insert into sp_kept_diff_aggs_off select a.k, a.c, b.s from (select k, count(*) as c from sp_t group by k) a join (select k, sum(v) as s from sp_t group by k) b on a.k = b.k;

statement ok
set batch_share_identical_subplans = true;

statement ok
insert into sp_kept_diff_aggs_on select a.k, a.c, b.s from (select k, count(*) as c from sp_t group by k) a join (select k, sum(v) as s from sp_t group by k) b on a.k = b.k;

statement ok
set batch_share_identical_subplans = false;

statement ok
set query_mode = auto;

# Empty fact table, distributed mode: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select k, v, n, count(*) as sp_rows from sp_self_join_on group by k, v, n except select k, v, n, count(*) as sp_rows from sp_self_join_off group by k, v, n) x),
  (select count(*) from (select k, v, n, count(*) as sp_rows from sp_self_join_off group by k, v, n except select k, v, n, count(*) as sp_rows from sp_self_join_on group by k, v, n) y),
  (select count(*) from sp_self_join_on) - (select count(*) from sp_self_join_off);
----
0 0 0

