# Only NULLs on the right side: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, y, count(*) as ne_rows from ne_join_not_null_on group by id, y except select id, y, count(*) as ne_rows from ne_join_not_null_off group by id, y) x),
