# Results (not plans) of batch queries whose filter combines `x IS NULL` with a null-rejecting
# condition on `x`. The batch optimizer removes the sub-plans that are proven to be empty, which
# must never change query results. The tables deliberately contain NULLs.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table pe_t (v1 int, v2 int, v3 varchar);

statement ok
create table pe_s (k int, w int);

statement ok
insert into pe_t values (1, 10, 'a'), (2, 20, 'b'), (NULL, 30, NULL), (NULL, NULL, 'a'), (3, NULL, 'c');

statement ok
insert into pe_s values (1, 100), (2, 200), (NULL, 300), (4, 400);

# ---------------------------------------------------------------------------------------------
# Positive cases: the filter can never be true.
# ---------------------------------------------------------------------------------------------

query IIT
select * from pe_t where v3 is null and v3 in ('a', 'b');
----

query IIT
select * from pe_t where v1 is null and 1 <= v1;
----

query IIT
select * from pe_t where v1 is null and v1 <> v2;
----

query IIT
select * from pe_t where v1 is null and v1 is not null;
----

query IIT
select * from (select * from pe_t where v3 in ('a', 'b')) sub where v3 is null;
----

query IIT
select * from (select * from pe_t limit 10) sub where v1 is null and v1 = 1;
----

# Inner joins with an empty input.
query IIII
select t.v1, t.v2, s.k, s.w from pe_t t join pe_s s on t.v1 = s.k where t.v3 is null and t.v3 in ('a', 'b');
----

query III
select s.k, e.v1, e.v2 from pe_s s join (select * from pe_t where v1 is null and v1 = 1) e on s.k < e.v2;
----

# Outer joins whose preserved side is empty.
query III
select e.v1, e.v2, s.k from (select * from pe_t where v1 is null and v1 = 1) e left join pe_s s on e.v1 = s.k;
----

query III
select e.v1, e.v2, s.k from pe_s s right join (select * from pe_t where v1 is null and v1 = 1) e on e.v1 = s.k;
----

# Semi joins with an empty input, anti join with an empty left input.
query II
select * from pe_s where k in (select v1 from pe_t where v2 is null and v2 = 1);
----

query IIT
select * from (select * from pe_t where v1 is null and v1 = 1) e where exists (select 1 from pe_s s where s.k = e.v2);
----

query IIT
select * from (select * from pe_t where v1 is null and v1 = 1) e where not exists (select 1 from pe_s s where s.k = e.v2);
----

# Grouped aggregation, order by and limit over an empty input.
query II
select v2, count(*) from pe_t where v1 is null and v1 = 1 group by v2;
----

query IIT
select * from pe_t where v1 is null and v1 = 1 order by v2 limit 3;
----

# `UNION ALL` keeps the non-empty inputs.
query II
select v1 as a, v2 as b from pe_t where v1 is null and v1 = 1
union all
select k, w from pe_s
order by b desc;
----
4 400
NULL 300
2 200
1 100

query II
select v1 as a, v2 as b from pe_t where v1 is null and v1 = 1
union all
select k, w from pe_s
union all
select v1, v2 from pe_t where v2 is not null
order by b;
----
1 10
2 20
NULL 30
1 100
2 200
NULL 300
4 400

query II
select k, w from pe_s
union all
select v1 as a, v2 as b from pe_t where v1 is null and v1 = 1
order by w;
----
1 100
2 200
NULL 300
4 400

query II
select v1 as a, v2 as b from pe_t where v1 is null and v1 = 1
union all
select k, w from pe_s where k is null and k > 0;
----

query II
select v1 as a, v2 as b from pe_t where v1 is null and v1 = 1
union
select k, w from pe_s where k is not null
order by b;
----
1 100
2 200
4 400

# The dbt `not_null` test shape: the view filters `v3 IN (...)` in a join branch that sits under a
# `UNION ALL`; the other branch is legitimate and contains a NULL.
statement ok
create view pe_v as
  select t.v1, t.v3, u.total
  from pe_t t
  join pe_s s on t.v1 = s.k
  join (
    select k, sum(w) as total from pe_s group by k
    union all
    select k, count(*) as total from pe_s group by k
  ) u on s.k = u.k
  where t.v3 in ('a', 'b')
  union all
  select k, case when k = 4 then null else 'c' end, w from pe_s;

query ITI
select * from pe_v order by v1, total, v3;
----
1 a 1
1 a 100
1 c 100
2 b 1
2 b 200
2 c 200
4 NULL 400
NULL c 300

query I
select count(*) from (select * from pe_v where v3 is null limit 10) sub;
----
1

query ITI
select * from pe_v where v3 is null;
----
4 NULL 400

# ---------------------------------------------------------------------------------------------
# Negative cases: nothing may be folded, or only up to an operator that still produces rows.
# ---------------------------------------------------------------------------------------------

# An aggregation without group key returns one row over an empty input.
query II
select count(*), sum(v2) from pe_t where v1 is null and v1 = 1;
----
0 NULL

query I
select count(*) from (select v2, count(*) from pe_t where v1 is null and v1 = 1 group by v2) sub;
----
0

# Under NOT: rows with a non-NULL v1 are kept (NOT FALSE), rows with a NULL v1 are dropped (NOT NULL).
query II
select v1, v2 from pe_t where not (v1 is null and v1 = 1) order by v1;
----
1 10
2 20
3 NULL

# Inside OR.
query II
select v1, v2 from pe_t where (v1 is null and v1 = 1) or v2 = 20;
----
2 20

query IIT
select * from pe_t where v1 is null or v1 = 1 order by v2;
----
1 10 a
NULL 30 NULL
NULL NULL a

# In a projection the conjunction is FALSE for non-NULL v1 and NULL for NULL v1.
query IB
select v1, v1 is null and v1 = 1 from pe_t order by v1, v2;
----
1 f
2 f
3 f
NULL NULL
NULL NULL

# Inside CASE and COALESCE.
query II
select v1, v2 from pe_t where coalesce(v1 is null and v1 = 1, true) order by v2;
----
NULL 30
NULL NULL

query I
select count(*) from pe_t where case when v1 is null and v1 = 1 then false else true end;
----
5

# Different columns.
query IIT
select * from pe_t where v1 is null and v2 = 30;
----
NULL 30 NULL

# IS [NOT] DISTINCT FROM is not null-rejecting.
query II
select v1, v2 from pe_t where v1 is null and v1 is distinct from 1 order by v2;
----
NULL 30
NULL NULL

query II
select v1, v2 from pe_t where v1 is null and v1 is not distinct from null::int order by v2;
----
NULL 30
NULL NULL

query II
select v1, v2 from pe_t where v1 = 1 and v1 is not distinct from null::int;
----

# A nullable column compared through a non-strict function.
query II
select v1, v2 from pe_t where v1 is null and coalesce(v1, 1) = 1 order by v2;
----
NULL 30
NULL NULL

query II
select v1, v2 from pe_t where v3 is null and coalesce(v3, 'a') in ('a', 'b');
----
NULL 30

# Shapes that are contradictory but not recognized by the rule must still return nothing.
query II
select v1, v2 from pe_t where v1 is null and v1 + 1 = 2;
----

query II
select v1, v2 from pe_t where v1 is null and v1 = any(array[1, 2]);
----

query II
select v1, v2 from pe_t where v1 is null and v1 not in (1, 2);
----

# Outer joins whose preserved side is not empty keep its rows.
query IIII
select s.k, s.w, e.v1, e.v2 from pe_s s left join (select * from pe_t where v1 is null and v1 = 1) e on e.v1 = s.k order by s.w;
----
1 100 NULL NULL
2 200 NULL NULL
NULL 300 NULL NULL
4 400 NULL NULL

query IIII
select s.k, s.w, e.v1, e.v2 from (select * from pe_t where v1 is null and v1 = 1) e right join pe_s s on e.v1 = s.k order by s.w;
----
1 100 NULL NULL
2 200 NULL NULL
NULL 300 NULL NULL
4 400 NULL NULL

query IIII
select s.k, s.w, e.v1, e.v2 from pe_s s full join (select * from pe_t where v1 is null and v1 = 1) e on e.v1 = s.k order by s.w;
----
1 100 NULL NULL
2 200 NULL NULL
NULL 300 NULL NULL
4 400 NULL NULL

query IIII
select s.k, s.w, t.v1, t.v2 from pe_s s left join pe_t t on s.k = t.v2 and t.v1 is null and t.v1 = 1 order by s.w;
----
1 100 NULL NULL
2 200 NULL NULL
NULL 300 NULL NULL
4 400 NULL NULL

# Anti joins with an empty right input keep all left rows, including the NULL key for NOT IN.
query II
select * from pe_s s where not exists (select 1 from pe_t t where t.v2 = s.k and t.v1 is null and t.v1 = 1) order by w;
----
1 100
2 200
NULL 300
4 400

query II
select * from pe_s where k not in (select v2 from pe_t where v1 is null and v1 = 1) order by w;
----
1 100
2 200
NULL 300
4 400

# A scalar subquery over an empty input yields NULL for every outer row.
query II
select k, (select max(v2) from pe_t where v1 is null and v1 = 1) as m from pe_s order by w;
----
1 NULL
2 NULL
NULL NULL
4 NULL

# DML with a contradictory filter affects no rows.
statement ok
delete from pe_t where v1 is null and v1 = 1;

statement ok
update pe_t set v2 = 0 where v1 is null and v1 in (1, 2);

query II
select count(*), sum(v2) from pe_t;
----
5 60

statement ok
drop view pe_v;

statement ok
drop table pe_s;

statement ok
drop table pe_t;
