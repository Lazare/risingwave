# First data: NULL keys, duplicates, rows without a match, negative values, few groups.

statement ok
insert into paj_f select g, case when g % 97 = 0 then null else g % 20 end, g % 7, g % 13 - 3, case when g % 11 = 0 then null else g end from generate_series(1, 2000) g;

statement ok
insert into paj_d select g, case when g % 6 = 0 then null else 'n' || (g % 5) end, g % 4 from generate_series(0, 15) g;

statement ok
insert into paj_d2 select g / 2, g % 2 + 1, case when g % 5 = 0 then null else g end from generate_series(0, 13) g;

statement ok
insert into paj_e select g % 25, case when g % 7 = 0 then null else g % 4 end from generate_series(1, 60) g;

statement ok
insert into paj_e values (null, 1), (null, 2);

statement ok
insert into paj_a select g, g % 30, case when g % 17 = 0 then null else g % 23 end from generate_series(1, 1500) g;

statement ok
insert into paj_b select case when g % 50 = 0 then null else g % 15 end, case when g % 9 = 0 then null else g % 31 end from generate_series(1, 1500) g;

