# Second data: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select k, name, s, n, count(*) as paj_rows from paj_left_unique_on group by k, name, s, n except select k, name, s, n, count(*) as paj_rows from paj_left_unique_off group by k, name, s, n) x),
  (select count(*) from (select k, name, s, n, count(*) as paj_rows from paj_left_unique_off group by k, name, s, n except select k, name, s, n, count(*) as paj_rows from paj_left_unique_on group by k, name, s, n) y),
  (select count(*) from paj_left_unique_on) - (select count(*) from paj_left_unique_off);
----
0 0 0

