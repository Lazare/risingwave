# Second data: wide values over several chunks and tasks, many rows per group.

statement ok
insert into gt_ev select i, case when i % 97 = 0 then null else i % 50 end, (i * 7919) % 2000, jsonb_build_object('id', i, 'pad', repeat('x', 300)) from generate_series(9, 3000) i;

# Second data, local query mode: every query runs without, then with the variables.

statement ok
set query_mode = local;

statement ok
delete from gt_distinct_on_union_cand;

statement ok
insert into gt_distinct_on_union_cand select k, src, doc from (
    select k, 'a' as src, jsonb_agg(payload order by id) as doc from gt_ev group by k
    union all
    select v % 40 as k, 'b' as src, jsonb_agg(payload order by id) as doc from gt_ev where v % 3 = 0 group by v % 40
    union all
    select k, 'c' as src, jsonb_build_object('n', count(*), 'max', max(v)) as doc from gt_ev group by k
) u;

