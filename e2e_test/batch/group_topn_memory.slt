statement ok
insert into gt_distinct_on_union_cand select k, src, doc from (
    select k, 'a' as src, jsonb_agg(payload order by id) as doc from gt_ev group by k
    union all
    select v % 40 as k, 'b' as src, jsonb_agg(payload order by id) as doc from gt_ev where v % 3 = 0 group by v % 40
    union all
    select k, 'c' as src, jsonb_build_object('n', count(*), 'max', max(v)) as doc from gt_ev group by k
) u;

