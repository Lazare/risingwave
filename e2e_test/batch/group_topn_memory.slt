insert into gt_ev values (1, 1, 5, '{"a": 1}'), (2, 1, 5, '{"a": 2}'), (3, null, 2, null), (4, null, 2, '[]'), (5, 2, null, '{}'), (6, 0, 3, '"x"'), (7, 9, null, null), (8, 1, 6, '{"a": [1, 2]}');

