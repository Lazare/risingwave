# Third data: updates and deletes, groups emptied.

statement ok
update gt_ev set k = null where id % 13 = 0;

statement ok
delete from gt_ev where id % 5 = 0 or k between 10 and 19;

statement ok
update gt_ev set payload = jsonb_build_object('id', id, 'v', v) where id % 3 = 0;

