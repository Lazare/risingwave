# Empty tables: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select k, code, count(*) as ivj_rows from ivj_semi_on group by k, code except select k, code, count(*) as ivj_rows from ivj_semi_off group by k, code) x),
  (select count(*) from (select k, code, count(*) as ivj_rows from ivj_semi_off group by k, code except select k, code, count(*) as ivj_rows from ivj_semi_on group by k, code) y),
  (select count(*) from ivj_semi_on) - (select count(*) from ivj_semi_off);
----
0 0 0

query III
select
  (select count(*) from (select k, count(*) as ivj_rows from ivj_semi_kept_cond_on group by k except select k, count(*) as ivj_rows from ivj_semi_kept_cond_off group by k) x),
  (select count(*) from (select k, count(*) as ivj_rows from ivj_semi_kept_cond_off group by k except select k, count(*) as ivj_rows from ivj_semi_kept_cond_on group by k) y),
  (select count(*) from ivj_semi_kept_cond_on) - (select count(*) from ivj_semi_kept_cond_off);
----
0 0 0

query III
