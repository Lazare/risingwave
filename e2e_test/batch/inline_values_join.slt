query III
select
  (select count(*) from (select k, code, count(*) as ivj_rows from ivj_semi_on group by k, code except select k, code, count(*) as ivj_rows from ivj_semi_off group by k, code) x),
  (select count(*) from (select k, code, count(*) as ivj_rows from ivj_semi_off group by k, code except select k, code, count(*) as ivj_rows from ivj_semi_on group by k, code) y),
  (select count(*) from ivj_semi_on) - (select count(*) from ivj_semi_off);
