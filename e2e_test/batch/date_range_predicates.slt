# First data, Europe/Paris: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select ts, v, count(*) as drp_rows from drp_trunc_month_eq_on group by ts, v except select ts, v, count(*) as drp_rows from drp_trunc_month_eq_off group by ts, v) x),
  (select count(*) from (select ts, v, count(*) as drp_rows from drp_trunc_month_eq_off group by ts, v except select ts, v, count(*) as drp_rows from drp_trunc_month_eq_on group by ts, v) y),
  (select count(*) from drp_trunc_month_eq_on) - (select count(*) from drp_trunc_month_eq_off);
