  (select count(*) from ((select c1, c2, count(*) as n from rkc_topn_lj_read_off group by c1, c2) except (select c1, c2, count(*) as n from rkc_topn_lj_read_both group by c1, c2)) y),
  (select count(*) from rkc_topn_lj_read_both) - (select count(*) from rkc_topn_lj_read_off);
