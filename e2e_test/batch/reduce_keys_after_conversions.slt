insert into rkc_top1_both select k, status from (select k, status, row_number() over (partition by k order by prio desc, eid) as rn from rkc_ev) x where rn = 1;

statement ok
insert into rkc_top3_both select k, status, ts from (select k, status, ts, row_number() over (partition by k order by prio, ts desc, eid) as rn from rkc_ev) x where rn <= 3;

statement ok
insert into rkc_strict_both select k, status from (select k, status, row_number() over (partition by k order by prio, eid) as rn from rkc_ev) x where rn < 4;

statement ok
insert into rkc_offset_both select k, status from (select k, status, row_number() over (partition by k order by prio, eid) as rn from rkc_ev) x where rn > 1 and rn <= 3;

statement ok
insert into rkc_top10_both select k, status from (select k, status, row_number() over (partition by k order by prio, eid) as rn from rkc_ev) x where rn <= 10;

statement ok
insert into rkc_top11_both select k, status from (select k, status, row_number() over (partition by k order by prio, eid) as rn from rkc_ev) x where rn <= 11;

statement ok
insert into rkc_rn_read_both select k, status, rn from (select k, status, row_number() over (partition by k order by prio, eid) as rn from rkc_ev) x where rn <= 2;

statement ok
insert into rkc_other_cond_both select k, status from (select k, status, row_number() over (partition by k order by prio desc, eid) as rn from rkc_ev) x where rn = 1 and status <> 'closed';

statement ok
insert into rkc_global_both select k, status from (select k, status, row_number() over (order by prio, eid) as rn from rkc_ev) x where rn <= 5;

statement ok
insert into rkc_two_parts_both select k, status, ts from (select k, status, ts, row_number() over (partition by k, status order by ts desc, eid) as rn from rkc_ev) x where rn = 1;

statement ok
insert into rkc_two_windows_both select k, status from (select k, status, row_number() over (partition by k order by prio, eid) as rn, sum(prio) over (partition by k) as total from rkc_ev) x where rn = 1 and total > 3;

statement ok
insert into rkc_ties_rn_both select k, prio from (select k, prio, row_number() over (partition by k order by prio desc) as rn from rkc_ev) x where rn <= 2;

statement ok
insert into rkc_ties_rn_one_both select k, prio from (select k, prio, row_number() over (partition by k order by prio) as rn from rkc_ev) x where rn = 1;

statement ok
insert into rkc_ties_rank_both select k, status from (select k, status, rank() over (partition by k order by prio desc) as rn from rkc_ev) x where rn = 1;

statement ok
insert into rkc_ties_rank2_both select k, status from (select k, status, rank() over (partition by k order by prio) as rn from rkc_ev) x where rn <= 2;

statement ok
insert into rkc_topn_lj_both select t.id, t.v from rkc_t t left join (select k, status from (select k, status, row_number() over (partition by k order by prio desc, eid) as rn from rkc_ev) x where rn = 1) s on t.id = s.k;

statement ok
insert into rkc_topn_cnt_both select k, count(*) as n from (select k from (select k, row_number() over (partition by k order by prio desc, eid) as rn from rkc_ev) x where rn = 1) x group by k;

statement ok
insert into rkc_topn_lj_two_both select t.id, t.v from rkc_t t left join (select k, status from (select k, status, row_number() over (partition by k order by prio desc, eid) as rn from rkc_ev) x where rn <= 2) s on t.id = s.k;

statement ok
insert into rkc_topn_lj_read_both select t.id, s.status from rkc_t t left join (select k, status from (select k, status, row_number() over (partition by k order by prio desc, eid) as rn from rkc_ev) x where rn = 1) s on t.id = s.k;

