insert into rkc_global_off select k, status from (select k, status, row_number() over (order by prio, eid) as rn from rkc_ev) x where rn <= 5;

statement ok
insert into rkc_two_parts_off select k, status, ts from (select k, status, ts, row_number() over (partition by k, status order by ts desc, eid) as rn from rkc_ev) x where rn = 1;

statement ok
insert into rkc_two_windows_off select k, status from (select k, status, row_number() over (partition by k order by prio, eid) as rn, sum(prio) over (partition by k) as total from rkc_ev) x where rn = 1 and total > 3;

statement ok
