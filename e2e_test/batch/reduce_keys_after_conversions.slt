# Spot checks.

query IT
select c1, c2 from rkc_top1_both order by c1 nulls first;
----
NULL open
1 late
2 open
3 new
4 NULL
5 open

query I
select count(*) from rkc_lag_key_off;
----
0

query II
select c1, c2 from rkc_ties_rn_both order by c1 nulls first, c2 nulls first;
----
NULL 3
NULL 3
1 NULL
1 2
2 5
2 5
3 1
4 NULL
4 NULL
5 11
5 12

# Many rows: many groups, more than ten rows in some groups, many ties.

statement ok
insert into rkc_t select 100 + i, i % 7, i from generate_series(1, 200) i;

statement ok
insert into rkc_nopk select i % 13, i from generate_series(1, 100) i;

statement ok
insert into rkc_d select 100 + i, 'n' || (i % 9), i % 5 from generate_series(1, 150) i;

statement ok
insert into rkc_f select 100 + i, case when i % 6 = 0 then null else 90 + i % 80 end, i, 'n' || (i % 7) from generate_series(1, 300) i;

statement ok
insert into rkc_ev select 100 + i, case when i % 17 = 0 then null else i % 23 end, case i % 4 when 0 then 'open' when 1 then 'closed' when 2 then 'held' else null end, case when i % 11 = 0 then null else i % 6 end, i % 9 from generate_series(1, 600) i;

