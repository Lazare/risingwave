# Deletes and updates: groups shrink or vanish, keys and order columns change, NULLs move.

statement ok
delete from rkc_t where id % 3 = 0;

statement ok
update rkc_t set x = null where id % 5 = 0;

statement ok
delete from rkc_d where id % 4 = 1;

statement ok
update rkc_d set name = null where id % 7 = 0;

statement ok
update rkc_f set dim_id = dim_id + 1 where id % 5 = 0;

statement ok
delete from rkc_ev where eid % 3 = 0 or k = 2;

statement ok
update rkc_ev set prio = null where eid % 7 = 0;

statement ok
update rkc_ev set k = null where eid % 13 = 0;

statement ok
update rkc_ev set prio = 1 where k = 5;

