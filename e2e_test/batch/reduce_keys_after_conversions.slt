insert into rkc_lag_key_off with o as (select id, lag(id) over (order by id) as prev from rkc_t) select id, count(*) + 1 as n from o where id = prev group by id;

statement ok
insert into rkc_lag_key_rows_off with o as (select id, lag(id) over (order by id) as prev from rkc_t) select id, prev from o where id = prev;

statement ok
insert into rkc_lag_key_count_off with o as (select id, lag(id) over (order by id) as prev from rkc_t) select count(*) from o where id = prev;

statement ok
insert into rkc_lag_x_off with o as (select x, lag(x) over (order by x) as prev from rkc_t) select x, count(*) + 1 as n from o where x = prev group by x;

statement ok
insert into rkc_lag_nopk_off with o as (select a, lag(a) over (order by a) as prev from rkc_nopk) select a, count(*) + 1 as n from o where a = prev group by a;

statement ok
insert into rkc_union_lj_off select f.id, f.amt from rkc_f f left join (select id from rkc_d union select dim_id from rkc_f) u on f.dim_id = u.id;

statement ok
insert into rkc_union_cnt_off select id, count(*) as n from (select id from rkc_d union select dim_id from rkc_f) u group by id;

statement ok
insert into rkc_union_distinct_off select distinct id, name from (select id, name from rkc_d union select dim_id, label from rkc_f) u;

statement ok
insert into rkc_union_count_all_off select count(*) from (select grp, name from rkc_d union select dim_id, label from rkc_f) u;

statement ok
insert into rkc_union_count_col_off select count(grp) from (select grp, name from rkc_d union select dim_id, label from rkc_f) u;

statement ok
insert into rkc_union_lj_two_off select f.id, f.amt from rkc_f f left join (select id, name from rkc_d union select dim_id, label from rkc_f) u on f.dim_id = u.id;

statement ok
insert into rkc_union_all_lj_off select f.id, f.amt from rkc_f f left join (select id from rkc_d union all select dim_id from rkc_f) u on f.dim_id = u.id;

statement ok
insert into rkc_distinct_key_off select grp, count(distinct id) as n, count(*) as c from rkc_d group by grp;

statement ok
insert into rkc_distinct_two_off select grp, count(distinct id) as n, sum(distinct id) as s from rkc_d group by grp;

statement ok
insert into rkc_rounds_lj_off with o as (select id, lag(id) over (order by id) as prev from rkc_t), dup as (select id, count(*) as n from o where id = prev group by id) select f.id, f.amt from rkc_f f left join dup on f.dim_id = dup.id;

statement ok
insert into rkc_rounds_union_off select f.id, u.id as uid from rkc_f f left join (select distinct id from (select id from rkc_d union select dim_id from rkc_f) a) u on f.dim_id = u.id left join rkc_d d on u.id = d.id;

statement ok
insert into rkc_top1_off select k, status from (select k, status, row_number() over (partition by k order by prio desc, eid) as rn from rkc_ev) x where rn = 1;

statement ok
insert into rkc_top3_off select k, status, ts from (select k, status, ts, row_number() over (partition by k order by prio, ts desc, eid) as rn from rkc_ev) x where rn <= 3;

statement ok
insert into rkc_strict_off select k, status from (select k, status, row_number() over (partition by k order by prio, eid) as rn from rkc_ev) x where rn < 4;

statement ok
insert into rkc_offset_off select k, status from (select k, status, row_number() over (partition by k order by prio, eid) as rn from rkc_ev) x where rn > 1 and rn <= 3;

