statement ok
insert into rkc_topn_lj_off select t.id, t.v from rkc_t t left join (select k, status from (select k, status, row_number() over (partition by k order by prio desc, eid) as rn from rkc_ev) x where rn = 1) s on t.id = s.k;

statement ok
