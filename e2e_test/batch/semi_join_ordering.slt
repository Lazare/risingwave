# Empty fact table: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, v, w, count(*) as sjo_rows from sjo_exists_fact_on group by id, v, w except select id, v, w, count(*) as sjo_rows from sjo_exists_fact_off group by id, v, w) x),
  (select count(*) from (select id, v, w, count(*) as sjo_rows from sjo_exists_fact_off group by id, v, w except select id, v, w, count(*) as sjo_rows from sjo_exists_fact_on group by id, v, w) y),
  (select count(*) from sjo_exists_fact_on) - (select count(*) from sjo_exists_fact_off);
----
0 0 0

