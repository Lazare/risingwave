statement ok
insert into sjo_stacked_off select f.id from sjo_f f join sjo_d1 d1 on f.d1_id = d1.id join sjo_d2 d2 on f.d2_id = d2.id where exists (select 1 from sjo_h h where h.x = f.v) and d1.k in (select h.y from sjo_h h);

