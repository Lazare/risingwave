query III
select
  (select count(*) from (select id, bid, count(*) as dor_rows from dor_inner_on group by id, bid except select id, bid, count(*) as dor_rows from dor_inner_off group by id, bid) x),
  (select count(*) from (select id, bid, count(*) as dor_rows from dor_inner_off group by id, bid except select id, bid, count(*) as dor_rows from dor_inner_on group by id, bid) y),
  (select count(*) from dor_inner_on) - (select count(*) from dor_inner_off);
