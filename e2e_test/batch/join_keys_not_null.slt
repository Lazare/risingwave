# Empty right side: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select aid, bid, k, count(*) as jkn_rows from jkn_inner_on group by aid, bid, k except select aid, bid, k, count(*) as jkn_rows from jkn_inner_off group by aid, bid, k) x),
  (select count(*) from (select aid, bid, k, count(*) as jkn_rows from jkn_inner_off group by aid, bid, k except select aid, bid, k, count(*) as jkn_rows from jkn_inner_on group by aid, bid, k) y),
  (select count(*) from jkn_inner_on) - (select count(*) from jkn_inner_off);
