# First data: NULL keys and values, duplicates, rows without a match on both sides: both results hold the same rows, each the same number of times.

query III
select
  (select count(*) from (select id, name, count(*) as ro_rows from ro_left_like_on group by id, name except select id, name, count(*) as ro_rows from ro_left_like_off group by id, name) x),
  (select count(*) from (select id, name, count(*) as ro_rows from ro_left_like_off group by id, name except select id, name, count(*) as ro_rows from ro_left_like_on group by id, name) y),
  (select count(*) from ro_left_like_on) - (select count(*) from ro_left_like_off);
