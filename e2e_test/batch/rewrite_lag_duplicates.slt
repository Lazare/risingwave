create table rld_counts_on (c1 int, c2 bigint, c3 bigint, c4 bigint);

# other aggregate

statement ok
create table rld_max_off (c1 int, c2 bigint, c3 int);

statement ok
create table rld_max_on (c1 int, c2 bigint, c3 int);

# condition on x and the lag column

statement ok
create table rld_condition_off (c1 int, c2 bigint);

statement ok
create table rld_condition_on (c1 int, c2 bigint);

# other window functions, not read above

statement ok
create table rld_other_windows_off (c1 int, c2 bigint);

