# Spot checks of the uniqueness check: values present k times give k.

query II
select c1, c2 from rld_fused_on order by c1;
----
1 3
3 2
5 2

query TI
select c1, c2 from rld_varchar_on order by c1;
----
a 2
c 3
e 2

query III
select c1, c2, c3 from rld_part_fused_on order by c1 nulls first, c2;
----
NULL 3 1
1 1 1
2 5 1

# Many rows, many duplicates in several partitions.

