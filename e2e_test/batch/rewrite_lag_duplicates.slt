set batch_rewrite_lag_duplicates = false;

statement ok
insert into rld_fused_off with ordered as (select x, lag(x) over (partition by true order by x) as prev from rld_t where x is not null), duplicates as (select * from ordered where x = prev) select x as unique_field, count(*) + 1 as n_records from duplicates group by x;

statement ok
insert into rld_rows_off with ordered as (select x, lag(x) over (order by x) as prev from rld_t) select * from ordered where x = prev;

statement ok
insert into rld_count_all_off with ordered as (select x, lag(x) over (order by x) as prev from rld_t) select count(*) from ordered where x = prev;

statement ok
insert into rld_lead_off with ordered as (select x, lead(x) over (order by x) as next from rld_t) select x, count(*) from ordered where next = x group by x;

statement ok
insert into rld_lag_minus_one_off with ordered as (select x, lag(x, -1) over (order by x) as next from rld_t) select x, count(*) from ordered where x = next group by x;

statement ok
insert into rld_desc_off with ordered as (select x, lag(x) over (order by x desc nulls first) as prev from rld_t) select x, prev from ordered where x = prev;

statement ok
insert into rld_tie_break_off with ordered as (select x, lag(x) over (order by x, id desc) as prev from rld_t) select x, prev from ordered where x = prev;

statement ok
insert into rld_first_value_off with ordered as (select x, first_value(x) over (order by x rows between 1 preceding and 1 preceding) as prev from rld_t) select x, count(*) from ordered where x = prev group by x;

statement ok
insert into rld_varchar_off with ordered as (select s, lag(s) over (partition by true order by s) as prev from rld_t where s is not null), duplicates as (select * from ordered where s = prev) select s, count(*) + 1 as n from duplicates group by s;

statement ok
insert into rld_part_fused_off with ordered as (select p, x, lag(x) over (partition by p order by x) as prev from rld_t) select p, x, count(*) from ordered where x = prev group by p, x;

statement ok
insert into rld_part_rows_off with ordered as (select p, x, lag(x) over (partition by p order by p, x) as prev from rld_t) select x, p from ordered where x = prev;

statement ok
insert into rld_part_by_x_off with ordered as (select p, x, lag(x) over (partition by p order by x) as prev from rld_t) select x, count(*) from ordered where x = prev group by x;

statement ok
insert into rld_counts_off with ordered as (select x, lag(x) over (order by x) as prev from rld_t) select prev, count(prev), count(x), count(*) from ordered where x = prev group by prev;

statement ok
insert into rld_max_off with ordered as (select x, lag(x) over (order by x) as prev from rld_t) select x, count(*), max(prev) from ordered where x = prev group by x;

statement ok
insert into rld_condition_off with ordered as (select x, lag(x) over (order by x) as prev from rld_t) select x, count(*) from ordered where x = prev and prev > 2 and x <> 4 group by x;

statement ok
insert into rld_other_windows_off with ordered as (select x, lag(x) over (order by x) as prev, lag(y) over (order by x) as prev_y, row_number() over (order by y) as rn from rld_t) select x, count(*) from ordered where x = prev group by x;

statement ok
insert into rld_exprs_off with ordered as (select x, lag(x) over (order by x) as prev from rld_t) select x + 1 as x1, prev * 2 as p2 from ordered where x = prev;

statement ok
insert into rld_kept_id_off with ordered as (select id, x, lag(x) over (order by x, id) as prev from rld_t) select id, x from ordered where x = prev;

statement ok
insert into rld_kept_not_distinct_off with ordered as (select x, lag(x) over (order by x) as prev from rld_t) select x, count(*) from ordered where x is not distinct from prev group by x;

statement ok
insert into rld_kept_offset_off with ordered as (select x, lag(x, 2) over (order by x) as prev from rld_t) select x, count(*) from ordered where x = prev group by x;

statement ok
insert into rld_kept_frame_off with ordered as (select x, first_value(x) over (order by x rows 1 preceding) as prev from rld_t) select x, count(*) from ordered where x = prev group by x;

statement ok
insert into rld_kept_condition_off with ordered as (select x, y, lag(x) over (order by x, id) as prev from rld_t) select x, count(*) from ordered where x = prev and y > 3 group by x;

