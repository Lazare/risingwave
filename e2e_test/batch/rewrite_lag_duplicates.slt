# Differential test of `batch_rewrite_lag_duplicates`: every query is run twice, with and without the
# rewrite of the duplicates found with `lag`, its rows inserted into a table, and both tables must
# hold the same rows, as many times each, after each change of the data.
#
# Generated by `python3 e2e_test/batch/rewrite_lag_duplicates.gen.py <this file>`: edit the list of
# queries there and regenerate rather than editing by hand.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table rld_t (id int primary key, p int, x int, y int, s varchar);

# count of the duplicates per value, as a uniqueness check

statement ok
create table rld_fused_off (c1 int, c2 bigint);

statement ok
create table rld_fused_on (c1 int, c2 bigint);

# the duplicate rows themselves

statement ok
create table rld_rows_off (c1 int, c2 int);

statement ok
create table rld_rows_on (c1 int, c2 int);

# count without group key

statement ok
create table rld_count_all_off (c1 bigint);

statement ok
create table rld_count_all_on (c1 bigint);

# lead instead of lag

statement ok
create table rld_lead_off (c1 int, c2 bigint);

statement ok
create table rld_lead_on (c1 int, c2 bigint);

# lag with offset -1 is lead

statement ok
create table rld_lag_minus_one_off (c1 int, c2 bigint);

statement ok
create table rld_lag_minus_one_on (c1 int, c2 bigint);

# descending order, nulls first

statement ok
create table rld_desc_off (c1 int, c2 int);

statement ok
create table rld_desc_on (c1 int, c2 int);

# tie-breaking order column after x

statement ok
create table rld_tie_break_off (c1 int, c2 int);

statement ok
create table rld_tie_break_on (c1 int, c2 int);

# first_value over the previous row

statement ok
create table rld_first_value_off (c1 int, c2 bigint);

statement ok
create table rld_first_value_on (c1 int, c2 bigint);

# varchar column

statement ok
create table rld_varchar_off (c1 varchar, c2 bigint);

statement ok
create table rld_varchar_on (c1 varchar, c2 bigint);

# partition column, grouped by it and x

statement ok
create table rld_part_fused_off (c1 int, c2 int, c3 bigint);

statement ok
create table rld_part_fused_on (c1 int, c2 int, c3 bigint);

# partition column, ordered by it first, rows read

statement ok
create table rld_part_rows_off (c1 int, c2 int);

statement ok
create table rld_part_rows_on (c1 int, c2 int);

# partition column, grouped by x only

statement ok
create table rld_part_by_x_off (c1 int, c2 bigint);

statement ok
create table rld_part_by_x_on (c1 int, c2 bigint);

# count of the lag column and of x

