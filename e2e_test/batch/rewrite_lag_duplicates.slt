# Deletes and updates: some values lose their duplicates, NULLs move.

statement ok
delete from rld_t where id between 100 and 250 or id in (1, 6);

statement ok
update rld_t set x = null where id % 7 = 0;

statement ok
update rld_t set p = null where id % 5 = 0;

statement ok
update rld_t set x = 1000 + id where id % 3 = 0;

