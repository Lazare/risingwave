  (select count(*) from ((select c1, c2, count(*) as n from rld_exprs_on group by c1, c2) except (select c1, c2, count(*) as n from rld_exprs_off group by c1, c2)) x),
  (select count(*) from ((select c1, c2, count(*) as n from rld_exprs_off group by c1, c2) except (select c1, c2, count(*) as n from rld_exprs_on group by c1, c2)) y),
  (select count(*) from rld_exprs_on) - (select count(*) from rld_exprs_off);
